	      	<script type="text/javascript" charset="utf-8" src="/public/js/alertify.min.js"></script>
	      	<script type="text/javascript" charset="utf-8">
	            function showDialog(title,message,type,autohide, mainPageId) {
	                alertify.set({
	                    labels : {ok:"<%= getLabelValue("OK") %>",cancel:"<%= getLabelValue("CANCEL")%>"},
	                    delay : 5000,
	                    buttonReverse : false,
	                    buttonFocus   : "ok"
	                });
	                alertify.alert(message);
	                returnValue = false;
	            }
	            function showConfirm(title,message,OK,CANCEL,url) {
	                alertify.set({
	                    labels : {ok:OK,cancel:CANCEL},
	                    delay : 5000,
	                    buttonReverse : false,
	                    buttonFocus   : "ok"
	                });
	                alertify.confirm(message, function (e) {
	                    if (e) {
	                        $.get("/app/Menu/on_dismiss_popup1?button_id=ok&url="+url);
	                    } else {
	                        $.get("/app/Menu/on_dismiss_popup1?button_id=cancel&url="+url);
	                    }
	                });
	                returnValue = false;
	            }
	            function applicationTimeOut(message) {
	            	alertify.set({
	            		labels : {ok:'OK'},
	            		delay : 5000,
	            		buttonReverse : false,
	            		buttonFocus   : "ok"
	            	});
	            	alertify.alert(message, function() {
	            		$.get("/app/AgentReg/dismissSessionPopup?button_title=OK");
	            	});
	            	returnValue = false;
	            }
	            function applicationRestart() {
	            	alertify.set({
	            		labels : {ok:'OK',cancel:'CANCEL'},
	            		buttonReverse : false,
	            		buttonFocus   : "ok"
	            	});

	            	alertify.alert("The application needs to restart in order to complete the setup process. Please start the application manually.", function() {
	            		$.get("/app/AgentReg/exitCallback");
	            	});
	            	returnValue = false;
	            }
	      	</script>
