        <script type="text/javascript">
            $(document).bind("mobileinit", function(){
                // jQuery-Mobile init options initialization goes here. For example, you may
                // enable automatically generated 'Back' buttons on headers this way:
                //$.mobile.page.prototype.options.addBackBtn = true;

                // You can disable (with false value) or change page loading message
                $.mobile.loadingMessage = true;
                $.mobile.loadingMessage = "<%= getLabelValue('loading') %>"; // it is default value

                $.mobile.defaultPageTransition = "slide";
                
                // For documented init options look here:
                // http://jquerymobile.com/demos/1.0.1/docs/api/globalconfig.html

                // For poorly documented options search for ".prototype.options"
                // in the jQuery Mobile source code

                // Rhodes custom option!
                // how long to wait transition end before "loading.." message will be shown
                $.mobile.loadingMessageDelay = 300; // in ms
                
                //render type=date inputs
                $.mobile.page.prototype.options.degradeInputs.date = false;
            });



			//Function to show loading message
			function showLoadingMessage(){ 
				var interval = setInterval(function(){
					$.mobile.loading("show", {
						text: "<%= getLabelValue('loading') %>",
						textVisible: true,
						theme: "b",
					  	html: ""
					});
					clearInterval(interval);
			    },1);
			    if(!$('#shadow').hasClass('blocker'))
    				$('#shadow').addClass('blocker'); 
			}


			//Function to hide loading message
			function hideLoadingMessage(){
				var interval = setInterval(function(){
			        $.mobile.loading('hide');
			        clearInterval(interval);
			    },1);
			    if($('#shadow').hasClass('blocker'))
    				$('#shadow').removeClass('blocker');
			}

			//Code to show/hide loading message on every AJAX call and to prevent input of blacklisted characters
			$(document).ready(function(){
				$.ajaxPrefilter(function(options, _, jqXHR) {
				    showLoadingMessage();
				    jqXHR.done(function() {
				        hideLoadingMessage();
				    });
				});
				$('input').on('keypress', function (event) {
				    var regex = new RegExp("[\\\\\\\]~`!#$%^&*\(\)+=\{\}|\"<>?/:;\[]+");
				    var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
				    if (regex.test(key)) {
				       event.preventDefault();
				       return false;
				    }
				});
			    $(document).ajaxComplete(function(event, request, settings) {
					$('input').on('keypress', function (event) {
					    var regex = new RegExp("[\\\\\\\]~`!#$%^&*\(\)+=\{\}|\"<>?/:;\[]+");
					    var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
					    if (regex.test(key)) {
					       event.preventDefault();
					       return false;
					    }
					});
				});
			});
            
            function isTouchDevice(){
              /* Added Android 3.0 honeycomb detection because touchscroll.js breaks
                the built in div scrolling of android 3.0 mobile safari browser */
              	if((navigator.userAgent.match(/android 3/i)) || (navigator.userAgent.match(/honeycomb/i)))
                	return false;
              	try{
                	document.createEvent("TouchEvent");
                	return true;
              	}catch(e){
                	return false;
              	}
            }
            
            function touchScroll(id){
              	if(isTouchDevice()){ //if touch events exist...
	                var el=document.getElementById(id);
	                var scrollStartPosY=0;
	                var scrollStartPosX=0;
	            
	                document.getElementById(id).addEventListener("touchstart", function(event) {
						scrollStartPosY=this.scrollTop+event.touches[0].pageY;
						scrollStartPosX=this.scrollLeft+event.touches[0].pageX;
						//event.preventDefault(); // Keep this remarked so you can click on buttons and links in the div
	                },false);
            
                	document.getElementById(id).addEventListener("touchmove", function(event) {
						// These if statements allow the full page to scroll (not just the div) if they are
						// at the top of the div scroll or the bottom of the div scroll
						// The -5 and +5 below are in case they are trying to scroll the page sideways
						// but their finger moves a few pixels down or up.  The event.preventDefault() function
						// will not be called in that case so that the whole page can scroll.
						if ((this.scrollTop < this.scrollHeight-this.offsetHeight &&
						this.scrollTop+event.touches[0].pageY < scrollStartPosY-5) ||
						(this.scrollTop != 0 && this.scrollTop+event.touches[0].pageY > scrollStartPosY+5))
							event.preventDefault(); 
						if ((this.scrollLeft < this.scrollWidth-this.offsetWidth &&
						this.scrollLeft+event.touches[0].pageX < scrollStartPosX-5) ||
						(this.scrollLeft != 0 && this.scrollLeft+event.touches[0].pageX > scrollStartPosX+5))
							event.preventDefault(); 
						this.scrollTop=scrollStartPosY-event.touches[0].pageY;
						this.scrollLeft=scrollStartPosX-event.touches[0].pageX;
					},false);
              	}
            }


            //Function to setup a filter to map fields based on FieldTargetValueMap
			function fieldTargetValueMapFilterSetup(mappingHash, filterable, object){
				var mappingHash = JSON.parse(mappingHash);
				var drivingField = object+"["+mappingHash.drivingField+"]";
				var targetField = object+"["+mappingHash.targetField+"]";
				var targetMap = mappingHash.targetMapList;

				if($("[name='"+drivingField+"']").attr("type") == "radio"){
					var selectedValue = $("[name='"+drivingField+"']:checked").val();
				}
				else {
					var selectedValue = $("[name='"+drivingField+"']").val();	
				}				
				var optionString = "<option value=''>Select</option>";
				var selectedTargetValue = $("select[name='"+targetField+"']").val();

				//On load event mapping
				if (filterable == "true" && targetMap[selectedValue]){
					$.each(targetMap[selectedValue], function(lookupKey, lookupValue){
						if (selectedTargetValue == lookupKey) {
							optionString += "<option value='"+lookupKey+"' selected>"+lookupValue+"</option>";
						}
						else {
							optionString += "<option value='"+lookupKey+"'>"+lookupValue+"</option>";
						}
					});
					$("select[name='"+targetField+"']").html(optionString).trigger("create");
				}
				else if (targetMap[selectedValue]){
					$("input[type='text'][name='"+targetField+"']").val(targetMap[selectedValue]);
					
					$("select[name='"+targetField+"']").val(targetMap[selectedValue]).trigger("refresh");

					$("input[type='radio'][name='"+targetField+"']").prop('checked', false).trigger("create");
					$("input[type='radio'][name='"+targetField+"'][value='"+targetMap[selectedValue]+"']").prop('checked', true).trigger("create");
				}
				else {
					$("select[name='"+targetField+"']").html(optionString).trigger("create");
				}


				//On change event mapping
				$("[name='"+drivingField+"']").change(function(){
					selectedValue = $(this).val();
					optionString = "<option value=''>Select</option>";
					if (filterable == "true" && targetMap[selectedValue]){
						$.each(targetMap[selectedValue], function(lookupKey, lookupValue){
							optionString += "<option value='"+lookupKey+"'>"+lookupValue+"</option>";
						});
						$("select[name='"+targetField+"']").html(optionString).selectmenu("refresh");
					}
					else if (targetMap[selectedValue]){
						$("input[type='text'][name='"+targetField+"']").val(targetMap[selectedValue]);
						
						$("select[name='"+targetField+"']").val(targetMap[selectedValue]).selectmenu("refresh");

						$("input[type='radio'][name='"+targetField+"']").prop('checked', false).checkboxradio("refresh");
						$("input[type='radio'][name='"+targetField+"'][value='"+targetMap[selectedValue]+"']").prop('checked', true).checkboxradio("refresh");
					}
					else {
						$("select[name='"+targetField+"']").html(optionString).selectmenu("refresh");
					}
				});
			}
        </script>
