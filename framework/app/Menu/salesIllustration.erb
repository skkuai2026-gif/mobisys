<div data-role="page">
	<link rel="stylesheet" href="/public/css/c2l_dashboard.css">
	<div data-role="header" id="header" data-position="inline">
		<a href="/app/Menu/landingPage" rel="external" data-direction="reverse" data-role="none">
			<img src="/public/images/SalesIllustration/icon_BackArrow-Red.png">
		</a>
		<h1><%= getLabelValue('SALESILLUSTRATION') %></h1>
	</div>

	<div data-role="content" id="content">
		<div class="ui-grid-b" id="main-options">
			<div class="ui-block-a">
				<%
                if $rhoconfig[:product_filter_page] == "YES"
				%>
					<a href="/app/Menu/product_filter_illustration?render_page=sales" rel="external">
				<% else %>
					<a href="/app/Quotation/productPage" rel="external">
				<% end %>	
					<img src="/public/images/SalesIllustration/add-quotation.png">
					<div class="imgCaption"><%= getLabelValue('AddQuotation') %></div>
				</a>
			</div>
			<div class="ui-block-b">
				<a href="/app/Quotation/search" rel="external">
					<img src="/public/images/SalesIllustration/search-quotation.png">
					<div class="imgCaption"><%= getLabelValue('SearchQuotation') %></div>
				</a>
			</div>
			<div class="ui-block-c">
				<a href="/app/Quotation/searchEmailRequest" rel="external">
					<img src="/public/images/SalesIllustration/search-email.png">
					<div class="imgCaption"><%= getLabelValue('SEARCHEMAILSREQUESTED') %></div>
				</a>
			</div>
		</div>

		<div class="ui-grid-b analytics">
			<div class="ui-block-a">
        		<div class="illustrationdisplay">
          			<table class="searchtable" width="100%">
            			<tr class="searchtableheader"><td><%= getLabelValue('interactiveChart') %></td></tr>
            			<tr class="search1">
            				<td class="tabletext">
            					<img src="/public/images/bar-chart-activity-lead.png">
            				</td>
            			</tr>	
           			</table>
           		</div>
		    </div>	

			<div class="ui-block-b">
        		<div class="illustrationdisplay">
          			<table class="searchtable" width="100%">
            			<tr class="searchtableheader"><td><%= getLabelValue('leadManagement') %></td></tr>
            			<tr class="search1">
            				<td class="tabletext">
            					<img src="/public/images/pai-chart1.png">
            				</td>
            			</tr>	
           			</table>
           		</div>
		    </div>

			<div class="ui-block-c">
        		<div class="illustrationdisplay">
          			<table class="searchtable" width="100%">
            			<tr class="searchtableheader"><td><%= getLabelValue('interactiveChart') %></td></tr>
            			<tr class="search1">
            				<td class="tabletext">
            					<img src="/public/images/pai-chart-activity-lead.png">
            				</td>
            			</tr>	
           			</table>
           		</div>
		    </div>
		</div>
	</div>
</div>