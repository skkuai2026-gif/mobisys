<div data-role="page">
	<link rel="stylesheet" href="/public/css/c2l_dashboard.css">
	<style type="text/css">
		.ui-btn-right > a {
			margin-right: 2em !important;
			margin-top: 1em !important;
		}
		.online_server_url {
			padding: 0em !important;
			font-size: 16px !important;
		}
		.radioWidth {
			width: 100px !important;
		}
		.ui-radio {
			width: 200px !important;
		}
	</style>


	<div data-role="header" id="header" data-position="inline">
		<h1><%= getLabelValue('onlineServer') %></h1>
		<div class="ui-btn-right">
			<a href="javascript: submitForm();" data-role="button">
				<%= getLabelValue('SAVEVALIDATE')%>
			</a>
		</div>
	</div>

	<div data-role="content" id="content">
		<div class="illustrationdisplay">
			<form method="POST" action="<%= url_for :action => :onlineServer %>" name="onlineServerForm">
				<div data-role="fieldcontain">
					<label class = "online_server_url" for="online_server_url"><%= getLabelValue('onlineServer') %>:</label>
					<input type="text" placeholder="<%= getLabelValue('onlineServer') %>" value="<%= @onlineServer %>" name="online_server_url">
				</div>
				<div class="ui-field-contain">
					<label style="font-size: 16px !important;padding: 0;">Create DB Seed</label>
					<%= renderRadioButton('create_db_seed', $rhoconfig[:create_db_seed] , 'YES', 'YES') %>
					<%= renderLabel('YES', 'YES','radioWidth') %>
					<%= renderRadioButton('create_db_seed', $rhoconfig[:create_db_seed] , 'NO', 'NO') %>
					<%= renderLabel('NO', 'NO','radioWidth') %>
				</div>
			</form>
		</div>
	</div>

	<script type="text/javascript">
		function submitForm(){
			if($("#online_server_url").val() == ""){
				alert("Please enter online server url");
			}
			else {
				document.onlineServerForm.submit();
			}
		}

		$(document).ready(function() {
			$(window).keydown(function(event){
				if(event.keyCode == 13) {
					event.preventDefault();
					return false;
				}
			});
			$("input[name='online_server_url']").off('keypress').on('keypress', function (event) {
			    var regex = new RegExp("[\\\\\\\]~`#%^+\{\}|\"<>\[]+");
			    var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
			    if (regex.test(key)) {
			       event.preventDefault();
			       return false;
			    }
			});
		});
	</script>
</div>