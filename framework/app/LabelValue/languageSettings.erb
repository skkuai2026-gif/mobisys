<div data-role="page">
	<link rel="stylesheet" href="/public/css/c2l_dashboard.css">
	<div data-role="header" id="header" data-position="inline">
		<a href="/app/Menu/settings" rel="external" data-direction="reverse" data-role="none">
			<img src="/public/images/SalesIllustration/icon_BackArrow-Red.png">
		</a>
		<h1><%= getLabelValue('LANGUAGESETTINGS') %></h1>
	</div>

	<div data-role="content" id="content">
		<div class="ui-grid-a">
			<% @locales.each do |locale| %>
				<div class="ui-block-a-equi">
					<a href="/app/LabelValue/changeLanguage?language=<%=locale.cd.to_s.downcase%>" data-role="button" data-theme="a" rel="external"><%= getLabelValue(locale.desc.to_s) %></a>
				</div>
			<% end %>
		</div>
	</div>
</div>