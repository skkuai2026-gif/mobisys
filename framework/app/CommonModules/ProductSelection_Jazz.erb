<div class="product-selection-tab-content product-selection-wrapper left-0">
	<input type="hidden" name="offlineApplicationEnvironment" id="offlineApplicationEnvironment" value="<%= @offlineApplicationEnvironment %>">
	<% if @offlineApplicationEnvironment == "UAT" %>
	<div class="col-25 product-page-col-1 product-family-wrapper">
	<% else %>
	<div class="col-33 product-page-col1 product-family-wrapper">
	<% end %>
		<div class="family_list">
			<h4><%= getLabelValue('productFamilyCd') %></h4>
			<% @productFamilyHash.each do |productFamilyId, productFamilyArray| %>
				<% productFamilyArray.each do |productFamily| %>
				<label>
				<%
				checked = ""
				if @baseProduct && @baseProduct.productFamilyCd.to_s == productFamily[:key].to_s
					checked = "checked"
				end
				%>
					<input type="radio" class="selectProductFamily" name="selectProductFamily" id="<%= productFamily[:id] %>" value="<%= productFamily[:key] %>" data-label="<%= productFamily[:value] %>" <%= checked %>>
					<%= productFamily[:value] %>
				</label>
				<% end %>
			<% end %>
		</div>
	</div>



	<% if @offlineApplicationEnvironment == "UAT" %>
	<div class="col-25 product-page-col-2 product-name-wrapper">
	<% else %>
	<div class="col-33 product-page-col2 product-name-wrapper">
	<% end %>
		<% @productIdHash.each do |productFamilyId, productIdArray| %>
			<div class="product_list" data-parent="<%= productFamilyId %>">
				<h4><%= @productFamilyHash[productFamilyId] ? @productFamilyHash[productFamilyId][0][:value] : '' %> Products</h4>
				<% productIdArray.each do |productId| %>
				<label>
				<%
				checked = ""
				value = @offlineApplicationEnvironment == "UAT" ? productId[:key] : productId[:id]
				if (@baseProduct && @offlineApplicationEnvironment == "UAT" && @baseProduct.productId.to_s == productId[:key].to_s) || (@baseProduct && @baseProduct.productSeq.to_s == productId[:id].to_s)
					checked = "checked"
				end
				%>
					<input type="radio" class="selectProductId" name="selectProductId" id="<%= productId[:id] %>" value="<%= value %>" data-label="<%= productId[:value] %>" <%= checked %>>
					<%= productId[:value] %>
				</label>
				<% end %>
			</div>
		<% end %>
	</div>

	<% if @offlineApplicationEnvironment == "UAT" %>
	<div class="col-25 product-page-col-3 plan-option-wrapper">
		<% @productVersionHash.each do |productId, productVersionArray| %>
			<div class="version_list" data-parent="<%= productId %>">
				<h4></h4>
				<% productVersionArray.each do |productVersion| %>
				<label>
				<%
				checked = ""
				if @baseProduct && @baseProduct.productSeq.to_s == productVersion[:key].to_s 
					checked = "checked"
				end
				%>
					<input type="radio" class="selectProductVersion" name="selectProductVersion" id="<%= productVersion[:id] %>" value="<%= productVersion[:key] %>" data-label="<%= productVersion[:value] %>" <%= checked %>>
					<%= productVersion[:value] %>
				</label>
				<% end %>
			</div>
		<% end %>
	<% else %>
	<div class="col-33 product-page-col3 plan-option-wrapper">
		<% @productPlanOptionHash.each do |productSeq, productPlanOptionArray| %>
			<div class="plan_list" data-parent="<%= productSeq %>">
				<h4></h4>
				<% productPlanOptionArray.each do |productPlanOption| %>
				<label>
				<%
				checked = ""
				if @baseProduct && @baseProduct.productPlanOptionCd.to_s == productPlanOption[:key].to_s && @baseProduct.productSeq.to_s == productSeq.to_s
					checked = "checked"
				end
				%>
					<input type="radio" class="selectProductPlan" name="selectProductPlan" id="<%= productSeq %>_<%= productPlanOption[:id] %>" value="<%= productPlanOption[:key] %>" data-label="<%= productPlanOption[:value] %>" <%= checked %>>
					<%= productPlanOption[:value] %>
				</label>
				<% end %>
			</div>
		<% end %>
	<% end %>
	</div>



	<% if @offlineApplicationEnvironment == "UAT" %>
	<div class="col-25 product-page-col-4">
		<% @productPlanOptionHash.each do |productSeq, productPlanOptionArray| %>
			<div class="plan_list" data-parent="<%= productSeq %>">
				<h4></h4>
				<% productPlanOptionArray.each do |productPlanOption| %>
				<label>
				<%
				checked = ""
				if @baseProduct && @baseProduct.productPlanOptionCd.to_s == productPlanOption[:key].to_s && @baseProduct.productSeq.to_s == productSeq.to_s
					checked = "checked"
				end
				%>
					<input type="radio" class="selectProductPlan" name="selectProductPlan" id="<%= productSeq %>_<%= productPlanOption[:id] %>" value="<%= productPlanOption[:key] %>" data-label="<%= productPlanOption[:value] %>" <%= checked %>>
					<%= productPlanOption[:value] %>
				</label>
				<% end %>
			</div>
		<% end %>
	</div>
	<% end %>
</div>


<script src="/app/CommonModules/ProductSelection_Jazz.js" type="text/javascript"></script>