<div class="product-selection-wrapper-mobile">
	<input type="hidden" name="offlineApplicationEnvironment" id="offlineApplicationEnvironment" value="<%= @offlineApplicationEnvironment %>">
	<div class="project-content-bg">
		<div class="project-content no-padding-bottom padding-top0">
			<div data-role="collapsible-set" class="collapse-panel product-selection-collapse-panel" data-collapsed-icon="false" data-expanded-icon="false" data-corners="false" data-theme="c">
			    <% @productFamilyHash.each do |productFamilyId, productFamilyArray| %>
					<div data-role="collapsible" data-collapsed="true" class="family_list">
				    	<% productFamilyArray.each do |productFamily| %>
						    <h3>
						    	<label style="width:100%;" data-iconpos="right">
						    		<%
									checked = ""
									if @baseProduct && @baseProduct.productFamilyCd.to_s == productFamily[:key].to_s
										checked = "checked"
									end
									%>
						    		<input class="selectProductFamily" type="radio" value="<%= productFamily[:key] %>" name="selectProductFamily" id="<%= productFamily[:id] %>" <%= checked %>/>
						    		<span><%= productFamily[:value] %></span>
						    	</label>
						    </h3>
						    <div data-role="collapsible-set" class="collapse-panel sub-product-selection" data-collapsed-icon="false" data-expanded-icon="false" data-corners="false" data-theme="c" data-familyId="<%= productFamilyId %>">
						    </div>
						<% end %>
					</div>
					<div class="clearfix"></div>
				<% end %>
			</div>
		</div>
	</div>
</div>
<%  productIdCollapsible = "data-role='collapsible-set' data-collapsed='true'" if @offlineApplicationEnvironment == "UAT" %>
<% @productIdHash.each do |productFamilyId, productIdArray| %>
	<% productIdArray.each do |productId| %>
		<div data-role="collapsible" data-collapsed="true" class="product_list" data-parent="<%= productFamilyId %>">
			<h3>
		    	<label data-iconpos="right">
		    		<%
					checked = ""
					value = @offlineApplicationEnvironment == "UAT" ? productId[:key] : productId[:id]
					if (@baseProduct && @offlineApplicationEnvironment == "UAT" && @baseProduct.productId.to_s == productId[:key].to_s) || (@baseProduct && @baseProduct.productSeq.to_s == productId[:id].to_s)
						checked = "checked"
					end
					if @offlineApplicationEnvironment == "UAT" 
						productIdCollapsible = "data-role='collapsible'"
						dataProductId = productId[:id]
					else
						dataProductId = productId[:id]
					end
					%>
		    		<input class="selectProductId" type="radio" name="selectProductId" value="<%= productId[:id] %>" id="<%= productId[:id] %>" <%= checked %>/>
		    		<span><%= productId[:value] %></span>
		    	</label>
		    </h3>
			<div <% productIdCollapsible %> data-productid="<%= dataProductId %>">
			</div>
		</div>
	<% end %>
<% end %>

<% if @offlineApplicationEnvironment == "UAT" %>
	<% @productVersionHash.each do |productId, productVersionArray| %>
		<% productVersionArray.each do |productVersion| %>
			<div data-role="collapsible" data-collapsed="true" class="version_list" data-parent="<%= productVersion[:id] %>">
				<h3>
					<label data-iconpos="right">
			    		<%
						checked = ""
						if @baseProduct && @baseProduct.productSeq.to_s == productVersion[:key].to_s 
							checked = "checked"
						end
						%>
			    		<input type="radio" class="selectProductVersion" name="selectProductVersion" id="<%= productVersion[:id] %>" value="<%= productVersion[:key] %>" data-label="<%= productVersion[:value] %>" <%= checked %>>	
			    		<span><%= productVersion[:value] %></span>
			    	</label>
			    </h3>
			    <div <% productIdCollapsible %> data-versionid="<%= productVersion[:key] %>">
				</div>
			</div>
		<% end %>
	<% end %>
<% end %>

<% @productPlanOptionHash.each do |productSeq, productPlanOptionArray| %>
	<div class="plan_list" data-parent="<%= productSeq %>">
		<% productPlanOptionArray.each do |productPlanOption| %>
			<label>
				<%
					checked = ""
					if @baseProduct && @baseProduct.productPlanOptionCd.to_s == productPlanOption[:key].to_s && @baseProduct.productSeq.to_s == productSeq.to_s
						checked = "checked"
					end
				%>
				<input type="radio" class="selectProductPlan" name="selectProductPlan" id="<%= productSeq %>_<%= productPlanOption[:id] %>" value="<%= productPlanOption[:key] %>" data-label="<%= productPlanOption[:value] %>" <%= checked %>>
				<span><%= productPlanOption[:value] %></span>
			</label>
		<% end %>
	</div>
<% end %>

<script src="/app/CommonModules/ProductSelectionMobile_Jazz.js" type="text/javascript"></script>