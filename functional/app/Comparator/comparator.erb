    <SCRIPT LANGUAGE="JavaScript">
       
       function Comparator(categoryCd,productCd,competitorCd,competitorProductCd,collateralCd)
       {
         this.categoryCd=categoryCd;
         this.productCd=productCd;
         this.competitorCd=competitorCd;
         this.competitorProductCd=competitorProductCd;
         this.collateralCd=collateralCd;
       }
       
       var compArray = new Array();
       
      <% @comparators.each do |comparator|   %>              
       compArray[compArray.length] = new Comparator('<%=comparator.categoryCd%>','<%=comparator.productCd%>','<%=comparator.competitorCd%>','<%=comparator.competitorProductCd%>','<%=comparator.collateralCd%>');
     <% end %>
 
     var unique = function(origArr,paramName) {  
           var newArr = [],  
               origLen = origArr.length,  
               found,  
               x, y;  
         
           for ( x = 0; x < origLen; x++ ) {  
               found = undefined;  
               for ( y = 0; y < newArr.length; y++ ) {  
                   if ( eval('origArr[x].'+paramName) === eval('newArr[y].'+paramName)) {  
                     found = true;  
                     break;  
                   }  
               }  
               if ( !found) newArr.push( origArr[x] );  
           }  
          return newArr;  
       }; 
       
       
       function comptForProduct(productCd){
        var newArr = new Array(); 
       
        for(i=0;i<compArray.length;i++){
       
          if(compArray[i].productCd===productCd){
           newArr[newArr.length] = compArray[i];
       
          }
        }
       
        return newArr;  
       }
       
       function productForCompt(competitorCd,productCd,categoryCd){
        var newArr = new Array(); 
       
        for(i=0;i<compArray.length;i++){
       
          if(compArray[i].competitorCd===competitorCd &&
            compArray[i].productCd===productCd &&
            compArray[i].categoryCd===categoryCd
          ){
           newArr[newArr.length] = compArray[i];
       
          }
        }
       
        return newArr;  
       }
       
       function collateralForSelection(categoryCd,productCd,competitorCd,competitorProductCd){
       
         for(i=0;i<compArray.length;i++){
           if(compArray[i].competitorProductCd===competitorProductCd &&
             compArray[i].competitorCd===competitorCd &&
             compArray[i].productCd===productCd &&
             compArray[i].categoryCd===categoryCd
            ){
             return compArray[i].collateralCd;
           }
          }
          return '';
          
       }
       
       
       function productForCategory(categoryCd){
        var newArr = new Array(); 
       
        for(i=0;i<compArray.length;i++){
       
          if(compArray[i].categoryCd===categoryCd){
           newArr[newArr.length] = compArray[i];
       
          }
        }
       
        return newArr;  
       }
       
       function populateSelect(newOptions,select,paramName){
       
         //alert(paramName);
     
         if(select.prop) {
           var options = select.prop('options');
         }
         else {
           var options = select.attr('options');
         }
       
         $('option', select).remove();
     
     
            if(paramName=='categoryCd'){
                select.append('<option>Select Product Category</option>');
             }
             else if(paramName=='productCd'){
               
                select.append('<option>Select Product</option>');
             }
             else if(paramName=='competitorCd'){
                select.append('<option>Select Insurance Player</option>');
             }
             else if(paramName=='competitorProductCd'){
                select.append('<option>Select Product</option>');
             }
     
         
         

         for(i=0;i<newOptions.length;i++){
           
           if(paramName=='categoryCd'){
             select.append('<option value="'+newOptions[i].categoryCd+'">'+newOptions[i].categoryCd+'</option>');
           }
           else if(paramName=='productCd'){
             
             select.append('<option value="'+newOptions[i].productCd+'">'+newOptions[i].productCd+'</option>');
           }
           else if(paramName=='competitorCd'){
             
             select.append('<option value="'+newOptions[i].competitorCd+'">'+newOptions[i].competitorCd+'</option>');
           }
           else if(paramName=='competitorProductCd'){
             
             select.append('<option value="'+newOptions[i].competitorProductCd+'">'+newOptions[i].competitorProductCd+'</option>');
           }
           
         }
       
       
       }


       
       
             
    $( '#comparatorPage' ).live( 'pageinit',function(event){
         
         
         $('#category').change(function() {
             var product = $('#product');
             var productArr = productForCategory($('#category').val());
             productArr = unique(productArr,'productCd');  
             populateSelect(productArr,product,'productCd');
         
             if(productArr.length==1){
               $('#product').change();
             }else{
               $('option', $('#compt')).remove();
               $('option', $('#comptProduct')).remove();
             }
          });
         
          
       
       
         $('#product').change(function() {
             var compt = $('#compt');
             var comptArr = comptForProduct($('#product').val());
             //alert(comptArr.length);
             comptArr = unique(comptArr,'competitorCd');  
             populateSelect(comptArr,compt,'competitorCd');
             if(comptArr.length==1){
               $('#compt').change();
             }else{
               $('option', $('#comptProduct')).remove();
             }
         });
       
       
         $('#compt').change(function() {
           var comptProduct = $('#comptProduct');
           var comptProductArr = productForCompt($('#compt').val(),$('#product').val(),$('#category').val());
           comptProductArr = unique(comptProductArr,'competitorProductCd');  
           populateSelect(comptProductArr,comptProduct,'competitorProductCd');
       
         });
       
       
         $('#submit').click(function() {
           var collateralTxt = collateralForSelection($('#category').val(),$('#product').val(),$('#compt').val(),$('#comptProduct').val());
           var url = '/app/Comparator/click?fileName='+collateralTxt;
           $.get(url,function(data) {});
       
         });
         
         var myarray = unique(compArray,'categoryCd');  
         var select = $('#category');
         populateSelect(myarray,select,'categoryCd');
         select.change();
         //var selectpr = $('#product');
         //selectpr.change();
         //var selectcomp = $('#compt');
         //selectcomp.change();
         //alert('done');
        });
 
   </SCRIPT>
