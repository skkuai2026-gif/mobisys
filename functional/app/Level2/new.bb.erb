<div data-role="page">

  <div data-role="header" data-position="inline">
    <%= link_to "Back", :action => :index %>
    <h1>New Level2</h1>
  </div>

  <div data-role="content">
    <form method="POST" action="<%= url_for :action => :create %>">
      <input type="hidden" name="id" value="<%= @level2.object %>"/>
      <table>
          
            <tr>
                <td class="itemLabel">Levelcd: </td>
                <td class="itemValue"><input type="text" name="level2[levelCd]"/></td>
            </tr>
          
            <tr>
                <td class="itemLabel">Icon: </td>
                <td class="itemValue"><input type="text" name="level2[icon]"/></td>
            </tr>
          
            <tr>
                <td class="itemLabel">Header: </td>
                <td class="itemValue"><input type="text" name="level2[header]"/></td>
            </tr>
          
            <tr>
                <td class="itemLabel">Text: </td>
                <td class="itemValue"><input type="text" name="level2[text]"/></td>
            </tr>
          
      </table>
      <input type="submit" value="Create"/>
    </form>
  </div>

</div>
