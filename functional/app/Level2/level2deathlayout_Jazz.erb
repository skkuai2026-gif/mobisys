<link rel="stylesheet" type="text/css" href="/public/css/style.css" /> 
<%= pageTagStart('collateralPage','Symbiosys - Sales Illustration') %>
    <%= headerTag("COLLATERAL", "home") %>

    <div data-role="main" class="ui-content">
        <%= menuTag('COLLATERAL',true) %>       
        <div class="main-content-wrapper" style="background-color: white;">
            <% randomId = rand.to_s[2..-1] %>
            <ul id="css3menu1" class="topmenu" style="width:100%;">
            	<% last = @level0s.length-1
            	@level0s.each_with_index do|level0,index|
          			if index == last
            			menuString = "lastmenu"
          			else
            			menuString = "topmenu"
          			end%>
          			<li class="<%=menuString%>" style="width:16%;">
          				<% if level0.menu == "YES" %>
                			<a href="#">
                		<% elsif level0.menu == "NO" %>
                			<a href="/app/Level0/{<%=level0.object%>}/click?level0id=<%=level0.object%>">
                		<% end %>
              			<% if level0.levelCd == @level0.levelCd %>
                  			<label class="level0label0selected"><%= level0.name1 %></label>
                		<% else %>
                  			<label class="level0label0"><%= level0.name1 %></label>
                		<% end %>
              			<BR>
              			<label class="level0label1"><%= level0.name2 %></label>
            			</a>
            			<% if level0.menu == "YES" %>
                  			<ul>
                  				<% @level1s.each do |level1|
                  					if level1.level0_levelCd == level0.levelCd %>
                          				<li style="position:relative;display:inline-block;">
                            				<a href="/app/Level1/{<%=level0.object%>}/click?level1id=<%=level1.object%>">
                              					<img src="<%=@collateralHM[level1.icon].fileName%>" alt="<%=@collateralHM[level1.icon].header%>"/>
                            				</a>
                          				</li>
                          			<% end 
                      			end %>
                  			</ul>
                		<% end %>
          			</li>
          		<% end %>
    		</ul>
    		<!-- Left Navigation panels -->
    		<div class="level2leftnavigation">
      			<ul class="productfeature-nav">
        			<% @level3s_level2.each do |level3| %>
            			<a href="/app/Level2/{<%=@level0.object%>}/click?level1id=<%=@level1_clicked.object%>&level2id=<%=@level2_clicked.object%>&level3id=<%=level3.object%>">
              			<li><img src="<%=@collateralHM['IMAGETRANS'].fileName%>" class="productfeature-nav-img" style="background:url(<%=@collateralHM[level3.icon].fileName%>) <% if level3.levelCd==@level3_clicked.levelCd%>0 -77px <% end %>;"/></li>
            			</a>
            		<% end %>
      			</ul>
    		</div>
  			<!-- End Left Navigation panels -->
  			<div id="contentpane" class="level2rightcontentpane">
        		<!-- top row of content with level 4 menus -->
        		<table border=0 width="98%">
        			<tr>
        				<td width="100%" rowspan=2><span class="level2header"><%=@level2_clicked.header%></span></td>            
            			<% @level4s.each do |level4| %>                
                			<td>
                				<% if level4.collateralView == "INLINE" %>
                    				<a href="/app/Level2/{<%=@level0.object%>}/click?level1id=<%=@level1_clicked.object%>&level2id=<%=@level2_clicked.object%>&level3id=<%=@level3_clicked.object%>&level4id=<%=level4.object%>">
                  				<% else %>
                  					<a href="#" id="<%=level4.levelCd%>_id" >
                  					<script>
                    					$('#<%=level4.levelCd%>_id').click(function () {  
                      						$.get("/app/Collateral/showpopup?levelCd=<%=level4.levelCd%>",function(data) {});
                    					}); 
                  					</script>                  
                  				<% end %>                
                				<% if level4.levelCd == @level4.levelCd %>
                  					<span class="level4tabselected">
                  				<% else %>
                  					<span class="level4tab">
                  				<% end %>                
                    			&nbsp;<%=level4.name%>&nbsp;</span>
                				</a>
                			</td>
                		<% end %>
	          		</tr>
        		</table>
        		<hr>
        		<div class="level3text">
              		<%=@text_h%>
        		</div>        
        		<div class="level3text">
              		<%=@text_f%>
        		</div>
        		<br>
        		<div class="level3text">
          			<table>
            			<tr>
              				<td> How much annual income will your dependants need if you die today? (Rs.)</td>
              				<td width=40% align=center>
              					<span id="neededAnnualIncomeVal">500000</span><br/>
                				<input  id="neededAnnualIncome" type="range" class="rangecontrol" min="0" max="10000000" value="500000" step="100000" style="display:none;" onchange="document.getElementById('neededAnnualIncomeVal').innerHTML=this.value;"/>      
              				</td>
            			</tr>
            			<tr>
              				<td>How much annual income does your family get from other sources (other than your earnings)? (Rs.)</td>
              				<td width=40% align=center>
              					<span   id="familyAnnualIncomeVal">500000</span><br/>
              					<input  id="familyAnnualIncome" type="range" class="rangecontrol" min="0" max="10000000" value="500000" step="100000" style="display:none;" onchange="document.getElementById('familyAnnualIncomeVal').innerHTML=this.value;"/>
              				</td>
            			</tr>
            			<tr>
            				<td> What is your expected inflation rate? (percent)</td>
              				<td width=40% align=center>
              					<span   id="inflationRateVal">6</span><br/>
              					<input  id="inflationRate" type="range" class="rangecontrol" min="0" max="20" value="6" step="0.5" style="display:none;"onchange="document.getElementById('inflationRateVal').innerHTML=this.value;"/>
              				</td>
            			</tr>
            			<tr>
              				<td>What is your expected return on investment? (percent)</td>
              				<td width=40% align=center>
                    			<span   id="investmentRateVal">6</span><br/>
                    			<input  id="investmentRate" type="range" class="rangecontrol" min="0" max="20" value="6" step="0.5" style="display:none;"onchange="document.getElementById('investmentRateVal').innerHTML=this.value;"/>                    
              				</td>
            			</tr>
            			<tr>
            				<td>For how many years do you want to provide this income for your family? (Years)</td>
              				<td width=40% align=center>
              					<span   id="incomePeriodVal">10</span><br/>
              					<input  id="incomePeriod" type="range" class="rangecontrol" min="0" max="50" value="10" step="1" style="display:none;"onchange="document.getElementById('incomePeriodVal').innerHTML=this.value;"/>
              				</td>
            			</tr>
            			<tr>
              				<td>If you have any outstanding loans in your name which your family would have to repay, give the amount (Rs.)</td>
              				<td width=40% align=center>
              					<span   id="outstandingLoansVal">500000</span><br/>
                  				<input  id="outstandingLoans" type="range" class="rangecontrol" min="0" max="10000000" value="500000" step="100000" style="display:none;" onchange="document.getElementById('outstandingLoansVal').innerHTML=this.value;"/>
              				</td>
            			</tr>
            			<tr>
            				<td>What is the present value of all your investments? (Rs.)</td>
              				<td width=40% align=center>
              					<span   id="availableInvestmentsVal">500000</span><br/>
              					<input  id="availableInvestments" type="range" class="rangecontrol" min="0" max="10000000" value="500000" step="100000" style="display:none;" onchange="document.getElementById('availableInvestmentsVal').innerHTML=this.value;"/>
              				</td>
            			</tr>
            			<tr>
              				<td>How much insurance do you already have? (Rs.)</td>
              				<td width=40% align=center>
              					<span   id="presentInsuranceVal">500000</span><br/>
              					<input  id="presentInsurance" type="range" class="rangecontrol" min="0" max="10000000" value="500000" step="100000" style="display:none;" onchange="document.getElementById('presentInsuranceVal').innerHTML=this.value;"/>
              				</td>
            			</tr>
            			<tr>
              				<td colspan=2 align=center>
                  				<img name="submitdeath" id="submitdeath" src="/public/images/calculate.png" width="165" height="46" border="0"/>
              				</td>
            			</tr>
          			</table>
          			<table width=80%>
            			<tr>
              				<td>Income needed by your dependants (Rs.)</td>
              				<td width=40% align=right><span   id="incomeNeedsVal">&nbsp;</span><br/></td>
            			</tr>
            			<tr>
            				<td>Outstanding loans to be repayed (Rs.)</td>
              				<td width=40% align=right><span id="outstandingLoansOPVal">&nbsp;</span><br/></td>
            			</tr>
            			<tr>
            				<td>Total insurance needs (Rs.)</td>
              				<td width=40% align=right><span   id="insuranceNeedsVal">&nbsp;</span><br/></td>
            			</tr>
            			<tr>
              				<td>Present value of all your investments (Rs.)</td>
              				<td width=40% align=right>
              					<span   id="availableInvestmentsOPVal">&nbsp;</span><br/>
              				</td>
            			</tr>
            			<tr>
              				<td>Amount of insurance you already have (Rs.)</td>
              				<td width=40% align=right><span   id="presentInsuranceOPVal">&nbsp;</span><br/></td>
            			</tr>
            			<tr>
            				<td>Additional amount of life insurance you need to buy (Rs.)</td>
              				<td width=40% align=right><span   id="additionalInsuranceVal">&nbsp;</span><br/></td>
            			</tr>
          			</table>
        		</div>        
    		</div>
  			<!-- End main content -->
  			</div>
  		</div>
  	</div>
<%= pageTagEnd %>

<script>
	function calculateFutureValue(currentValue, rate, term){
		var futureValue = 0.0;
		for(i=term; i>0; i--){
			rate = Math.pow((1 + rate/100), term);
			futureValue += rate * currentValue;            
		}
		return futureValue;
	}
	$(document).ready(function () {
		$('#submitdeath').click(function() {
	  		neededIncome = calculateFutureValue(document.getElementById('neededAnnualIncome').value, document.getElementById('inflationRate').value, document.getElementById('incomePeriod').value);
	  		familyTotalIncome = calculateFutureValue( document.getElementById('familyAnnualIncome').value, document.getElementById('investmentRate').value, document.getElementById('incomePeriod').value);
	  		incomeNeeds = parseInt(neededIncome - familyTotalIncome);
			document.getElementById('incomeNeedsVal').innerHTML = incomeNeeds 
			document.getElementById('outstandingLoansOPVal').innerHTML = document.getElementById('outstandingLoans').value;
			document.getElementById('insuranceNeedsVal').innerHTML = incomeNeeds - (-1*document.getElementById('outstandingLoans').value);
			document.getElementById('availableInvestmentsOPVal').innerHTML = document.getElementById('availableInvestments').value;
			document.getElementById('presentInsuranceOPVal').innerHTML = document.getElementById('presentInsurance').value;
			document.getElementById('additionalInsuranceVal').innerHTML = incomeNeeds - (-1 * document.getElementById('outstandingLoans').value) - document.getElementById('presentInsurance').value;
		});
	});
</script>  
