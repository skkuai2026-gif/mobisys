<div data-role="page">

  <div data-role="header" data-position="inline">
    <h1>Edit <%= @level2.levelCd %></h1>
    <a href="<%= url_for :action => :show, :id => @level2.object %>" class="ui-btn-left" data-icon="back" data-direction="reverse">
      Cancel
    </a>
    <a href="<%= url_for :action => :delete, :id => @level2.object %>" class="ui-btn-right" data-icon="delete" data-direction="reverse">
      Delete
    </a>
  </div>

  <div data-role="content">
    <form method="POST" action="<%= url_for :action => :update %>">
      <input type="hidden" name="id" value="<%= @level2.object %>"/>
      
          <div data-role="fieldcontain">
            <label for="level2[levelCd]" class="fieldLabel">Levelcd</label>
            <input type="text" id="level2[levelCd]" name="level2[levelCd]" value="<%= @level2.levelCd %>" <%= placeholder( "Levelcd" ) %> />
          </div>
      
          <div data-role="fieldcontain">
            <label for="level2[icon]" class="fieldLabel">Icon</label>
            <input type="text" id="level2[icon]" name="level2[icon]" value="<%= @level2.icon %>" <%= placeholder( "Icon" ) %> />
          </div>
      
          <div data-role="fieldcontain">
            <label for="level2[header]" class="fieldLabel">Header</label>
            <input type="text" id="level2[header]" name="level2[header]" value="<%= @level2.header %>" <%= placeholder( "Header" ) %> />
          </div>
      
          <div data-role="fieldcontain">
            <label for="level2[text]" class="fieldLabel">Text</label>
            <input type="text" id="level2[text]" name="level2[text]" value="<%= @level2.text %>" <%= placeholder( "Text" ) %> />
          </div>
          
          <div data-role="fieldcontain">
            <label for="level2[layout]" class="fieldLabel">Layout</label>
            <input type="text" id="level2[layout]" name="level2[layout]" value="<%= @level2.layout %>" <%= placeholder( "Layout" ) %> />
          </div>
              
          <div data-role="fieldcontain">
            <label for="level2[sortOrder]" class="fieldLabel">Sort order</label>
            <input type="text" id="level2[sortOrder]" name="level2[sortOrder]" value="<%= @level2.sortOrder %>" <%= placeholder( "Sort order" ) %> />
          </div>

          <div data-role="fieldcontain">
              <label for="level2[level1_levelCd]" class="fieldLabel">Level1 Reference</label>
              <select name="level2[level1_levelCd]">
                <% 
                  @level1s.each do |level1|
                    %>
                      <option value="<%= level1.levelCd%>"
                        <%= "selected" if level1.levelCd == @level2.level1_levelCd%>
                      >
                          <%=level1.name%>
                      </option>
                    <%
                  end
                %>
              </select>
          </div>
      
      <input type="submit" value="Update"/>
    </form>
  </div>

</div>
