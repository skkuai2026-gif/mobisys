		<div id="test-cal">
			<form method="post">
				<label>gender</label> <select name="gender" class="retirement-field">
					<option selected>male</option>
					<option>female</option>
				</select><br>
				<label>age</label> <input type="text" name="age" value="30" /><br>
				<label>marital_status</label> <select name="marital_status">
					<option>single</option>
					<option selected>married</option>
					<option>cohabited</option>
					<option>divorced</option>
				</select><br>
				<label>num_of_children</label> <select name="num_of_children">
					<option>0</option>
					<option>1</option>
					<option selected>2</option>
					<option>3</option>
				</select><br>
				<label>num_of_dependents</label> <select name="num_of_dependents">
					<option>0</option>
					<option>1</option>
					<option selected>2</option>
					<option>3</option>
					<option>4</option>
				</select><br>
				<label>monthly_income</label> <input type="text" name="monthly_income" value="40000" /><br>
				<label>liquid_assets[cash_deposit]</label> <input type="text" name="liquid_assets[cash_deposit]" value="40000" /><br>
				<label>liquid_assets[time_deposit]</label> <input type="text" name="liquid_assets[time_deposit]" value="10000" /><br>
				<label>liquid_assets[stock]</label> <input type="text" name="liquid_assets[stock]" value="100000" /><br>
				<label>liquid_assets[fund_bond]</label> <input type="text" name="liquid_assets[fund_bond]" value="50000" /><br>
				<label>liquid_assets[others]</label> <input type="text" name="liquid_assets[others]" value="0" /><br>
				<label>annual_return_rate</label> <input type="text" name="annual_return_rate" value="0.03" /><br>
				<label>total_coverage_of_life_policies</label> <input type="text" name="total_coverage_of_life_policies" value="500000" /><br>
				<label>num_of_years_for_supporting</label> <input type="text" name="num_of_years_for_supporting" value="5" /><br>
				<label>total_coverage_of_critical_illness_policies</label> <input type="text" name="total_coverage_of_critical_illness_policies" value="500000" /><br>
				<label>expected_years_of_loss_of_income</label> <input type="text" name="expected_years_of_loss_of_income" value="5" /><br>
				<label>monthly_house_rental</label> <input type="text" name="monthly_house_rental" value="11700" /><br>
				<label>other_monthly_expenses</label> <input type="text" name="other_monthly_expenses" value="10000" /><br>
				<label>immediate_cash_needs[mortgage]</label> <input type="text" name="immediate_cash_needs[mortgage]" value="1000000" /><br>
				<label>immediate_cash_needs[education_funds]</label> <input type="text" name="immediate_cash_needs[education_funds]" value="60000" /><br>
				<label>immediate_cash_needs[funeral_expense]</label> <input type="text" name="immediate_cash_needs[funeral_expense]" value="20000" /><br>
				<label>immediate_cash_needs[others]</label> <input type="text" name="immediate_cash_needs[others]" value="0" /><br>
				<label>target_retirement_age</label> <input type="text" name="target_retirement_age" value="65" class="retirement-field" /><br>
				<label>ideal_retirement_lifestyle</label> <select name="ideal_retirement_lifestyle" class="retirement-field">
					<option></option>
					<option>ordinary</option>
					<option selected>superior</option>
					<option>luxurious</option>
				</select><br>
				<label>expect_years_of_retirement</label> <input type="text" name="expect_years_of_retirement" value="25" class="retirement-field" /><br>
				<label>mpf_monthly_contribution</label> <input type="text" name="mpf_monthly_contribution" value="2500" class="retirement-field" /><br>
				<label>children[0][children_age]</label> <input type="text" name="children[0][children_age]" value="5" class="education-field" /><br>
				<label>children[0][age_to_enter_university]</label> <input type="text" name="children[0][age_to_enter_university]" value="22" class="education-field" /><br>
				<label>children[0][expected_years_of_studying]</label> <input type="text" name="children[0][expected_years_of_studying]" value="4" class="education-field" /><br>
				<label>children[0][country_for_studying]</label> <select name="children[0][country_for_studying]" class="education-field">
					<option></option>
					<option selected>hong_kong</option>
					<option>uk</option>
					<option>usa</option>
					<option>canada</option>
					<option>australia</option>
					<option>new_zealand</option>
					<option>china</option>
				</select><br>
				<label>children[0][manual_total_expense_per_year]</label> <input type="text" name="children[0][manual_total_expense_per_year]" value="0" class="education-field" /><br>
				<label>children[1][children_age]</label> <input type="text" name="children[1][children_age]" value="9" class="education-field" /><br>
				<label>children[1][age_to_enter_university]</label> <input type="text" name="children[1][age_to_enter_university]" value="22" class="education-field" /><br>
				<label>children[1][expected_years_of_studying]</label> <input type="text" name="children[1][expected_years_of_studying]" value="3" class="education-field" /><br>
				<label>children[1][country_for_studying]</label> <select name="children[1][country_for_studying]" class="education-field">
					<option></option>
					<option>hong_kong</option>
					<option>uk</option>
					<option selected>usa</option>
					<option>canada</option>
					<option>australia</option>
					<option>new_zealand</option>
					<option>china</option>
				</select><br>
				<label>children[1][manual_total_expense_per_year]</label> <input type="text" name="children[1][manual_total_expense_per_year]" value="0" class="education-field" /><br>
				<label>children[2][children_age]</label> <input type="text" name="children[2][children_age]" value="7" class="education-field" /><br>
				<label>children[2][age_to_enter_university]</label> <input type="text" name="children[2][age_to_enter_university]" value="22" class="education-field" /><br>
				<label>children[2][expected_years_of_studying]</label> <input type="text" name="children[2][expected_years_of_studying]" value="4" class="education-field" /><br>
				<label>children[2][country_for_studying]</label> <select name="children[2][country_for_studying]" class="education-field">
					<option></option>
					<option>hong_kong</option>
					<option>uk</option>
					<option>usa</option>
					<option>canada</option>
					<option selected>australia</option>
					<option>new_zealand</option>
					<option>china</option>
				</select><br>
				<label>children[2][manual_total_expense_per_year]</label> <input type="text" name="children[2][manual_total_expense_per_year]" value="0" class="education-field" /><br>
				<label>education_fund</label> <input type="text" name="education_fund" value="500000" class="education-field" /><br>
				<label>annual_inflation_rate</label> <input type="text" name="annual_inflation_rate" value="0.03" /><br>
				<input type="submit" value="Calculate" /><br>
				<input type="button" class="empty_retirement_fields" value="Empty Retirement Fields" /><br>
				<input type="button" class="empty_education_fields" value="Empty Education Fields" /><br>
				<input type="reset" value="Reset" /><br>
				<input type="button" class="test_sendreport" value="Test Send Report" /><br>
			</form>
			<div class="results">
				<label>Results</label>
				<textarea></textarea>
			</div>
			<div id="sendreport_results" style="position:absolute;z-index:2000;"></div>
		</div>
