<!DOCTYPE html> 
<html> 
  <head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1"> 
  <title>jQuery Mobile Framework - Dialog Example</title> 
  <link rel="stylesheet" href="/public/jqmobile/jquery.mobile-1.0.min.css">
  <script src="/public/jquery/jquery-1.6.4.min.js" type="text/javascript"></script>
  <script type="text/javascript" charset="utf-8" src="/public/jqmobile/jquery.mobile-1.0.min.js"></script>
 </head> 
<body> 

<div data-role="page" id="dialogPage">
  
    <div data-role="header" data-theme="d">
      <h1>Media</h1>
   </div>

    <div data-role="content" data-theme="c">
      <%
        if @fileType == "MP4"
          %>
            <video width="320" height="240" controls="controls">
              <source src="<%=@mediaName%>" type="video/mp4" />
              <!--Your browser does not support the video tag.-->
            </video>
          <%
        else
          %>
           <a href="<%=@mediaName%>">Open</a>
          <%
        end
      %>
      <a href="#" data-role="button" data-rel="back" data-theme="c">Ok</a>    
    </div>

<script type="text/javascript">
$( '#dialogPage' ).live( 'pageinit',function(event){
       
    
  
});

</script>    
</div>


</body>
</html>