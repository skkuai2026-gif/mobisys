            <div class="itemValue"><%= @level0.layout %></div>
          </li>
          
          <li>
            <div class="itemLabel">Sort order</div>
            <div class="itemValue"><%= @level0.sortOrder %></div>
          </li>

          <li>
            <div class="itemLabel">Menu</div>
            <div class="itemValue"><%= @level0.menu %></div>
          </li>
          
          <li>
            <div class="itemLabel">Landing page</div>
