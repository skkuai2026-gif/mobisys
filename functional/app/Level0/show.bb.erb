<div data-role="page" data-add-back-btn="true">

  <div data-role="header" data-position="inline">
    <%= link_to "Back", :action => :index %>
    <h1><%= @level0.levelCd %></h1>
    <%= link_to "Edit", :action => :edit, :id => @level0.object %>
  </div>

  <div data-role="content">
    <table>
      
      <tr>
    	<td class="itemLabel">LevelCd</td>
        <td class="itemValue"><%= @level0.levelCd%></td>
      </tr>
      
      <tr>
    	<td class="itemLabel">Name1</td>
        <td class="itemValue"><%= @level0.name1%></td>
      </tr>
      
      <tr>
    	<td class="itemLabel">Name2</td>
        <td class="itemValue"><%= @level0.name2%></td>
      </tr>
      
      <tr>
    	<td class="itemLabel">Icon</td>
        <td class="itemValue"><%= @level0.icon%></td>
      </tr>
      
    </table>
  </div>

</div>
