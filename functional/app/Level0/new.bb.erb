<div data-role="page">

  <div data-role="header" data-position="inline">
    <%= link_to "Back", :action => :index %>
    <h1>New Level0</h1>
  </div>

  <div data-role="content">
    <form method="POST" action="<%= url_for :action => :create %>">
      <input type="hidden" name="id" value="<%= @level0.object %>"/>
      <table>
          
            <tr>
                <td class="itemLabel">Levelcd: </td>
                <td class="itemValue"><input type="text" name="level0[levelCd]"/></td>
            </tr>
          
            <tr>
                <td class="itemLabel">Name1: </td>
                <td class="itemValue"><input type="text" name="level0[name1]"/></td>
            </tr>
          
            <tr>
                <td class="itemLabel">Name2: </td>
                <td class="itemValue"><input type="text" name="level0[name2]"/></td>
            </tr>
          
            <tr>
                <td class="itemLabel">Icon: </td>
                <td class="itemValue"><input type="text" name="level0[icon]"/></td>
            </tr>
          
      </table>
      <input type="submit" value="Create"/>
    </form>
  </div>

</div>
