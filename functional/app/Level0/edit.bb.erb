<div data-role="page">

  <div data-role="header" data-position="inline">
    <%= link_to "Back", :action => :show, :id => @level0.object %>
    <h1>Edit <%= @level0.levelCd%></h1>
    <%= link_to "Delete", :action => :delete, :id => @level0.object %>
  </div>

  <div data-role="content">
    <form method="POST" action="<%= url_for :action => :update %>">
      <input type="hidden" name="id" value="<%= @level0.object %>"/>
      <table>
          
          <tr>
              <td class="itemLabel">Levelcd: </td>
              <td class="itemValue"><input type="text" name="level0[levelCd]" value="<%= @level0.levelCd %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Name1: </td>
              <td class="itemValue"><input type="text" name="level0[name1]" value="<%= @level0.name1 %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Name2: </td>
              <td class="itemValue"><input type="text" name="level0[name2]" value="<%= @level0.name2 %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Icon: </td>
              <td class="itemValue"><input type="text" name="level0[icon]" value="<%= @level0.icon %>"/></td>
          </tr>
          
      </table>
      <input type="submit" value="Update"/>
    </form>
  </div>

</div>
