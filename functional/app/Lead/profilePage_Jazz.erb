					</p>
				</div>
				<div class="row-details">
					<p class="col-left">Age</p>
					<p class="col-right">
						<input class="input-controll" type="text" placeholder="Enter a value">
					</p>
				</div>
				<div class="row-details">
					<p class="col-left">Occupation</p>
