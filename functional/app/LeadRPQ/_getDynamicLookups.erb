<%
require 'CommonModules/mobisysbrowserhelper'

case @option

when "industries" %>
<option selected disabled>Select</option>
<%	@industries.each do |industry| %>
  	<option value="<%= industry.cd %>"><%= getLabelValue(industry.desc) %></option>
<% 
	end 

when "natureofduty" %>
<option selected disabled>Select</option>
<%	@natureOfDutyLookups.each do |nature| %>
  	<option value="<%= nature.cd %>"><%= getLabelValue(nature.desc) %></option>
<% 
	end

when "occupationclass" %>
<option selected disabled>Select</option>
<%	@occupationClassLookups.each do |occ| %>
  	<option value="<%= occ.cd %>"><%= getLabelValue(occ.desc) %></option>
<% 
	end

when "supplementaryID" %>
<option selected disabled>Select</option>
<%	@supplementaryIdLookup.each do |suppl| %>
  	<option value="<%= suppl.cd %>"><%= suppl.desc %></option>
<% 
	end

when "district"
	if !@districtLookUps.empty?
		@districtLookUps.each do |district|
%>
  		<option value="<%= district.cd %>"><%= getLabelValue(district.desc) %></option>
<% 
		end
	end 
	
when "city"
	if !@cityLookUps.empty?
		@cityLookUps.each do |city|
%>
  		<option value="<%= city.cd %>"><%= getLabelValue(city.desc) %></option>
<% 
		end
	end
end 
%>