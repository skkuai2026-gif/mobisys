<div data-role="page">

  <div data-role="header" data-position="inline">
    <%= link_to "Back", :action => :show, :id => @level4.object %>
    <h1>Edit <%= @level4.levelCd%></h1>
    <%= link_to "Delete", :action => :delete, :id => @level4.object %>
  </div>

  <div data-role="content">
    <form method="POST" action="<%= url_for :action => :update %>">
      <input type="hidden" name="id" value="<%= @level4.object %>"/>
      <table>
          
          <tr>
              <td class="itemLabel">Levelcd: </td>
              <td class="itemValue"><input type="text" name="level4[levelCd]" value="<%= @level4.levelCd %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Name: </td>
              <td class="itemValue"><input type="text" name="level4[name]" value="<%= @level4.name %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Icon: </td>
              <td class="itemValue"><input type="text" name="level4[icon]" value="<%= @level4.icon %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Text h: </td>
              <td class="itemValue"><input type="text" name="level4[text_h]" value="<%= @level4.text_h %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Text f: </td>
              <td class="itemValue"><input type="text" name="level4[text_f]" value="<%= @level4.text_f %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Layout: </td>
              <td class="itemValue"><input type="text" name="level4[layout]" value="<%= @level4.layout %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Sortorder: </td>
              <td class="itemValue"><input type="text" name="level4[sortOrder]" value="<%= @level4.sortOrder %>"/></td>
          </tr>
          
      </table>
      <input type="submit" value="Update"/>
    </form>
  </div>

</div>
