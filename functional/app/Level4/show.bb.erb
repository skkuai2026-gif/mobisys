<div data-role="page" data-add-back-btn="true">

  <div data-role="header" data-position="inline">
    <%= link_to "Back", :action => :index %>
    <h1><%= @level4.levelCd %></h1>
    <%= link_to "Edit", :action => :edit, :id => @level4.object %>
  </div>

  <div data-role="content">
    <table>
      
      <tr>
    	<td class="itemLabel">LevelCd</td>
        <td class="itemValue"><%= @level4.levelCd%></td>
      </tr>
      
      <tr>
    	<td class="itemLabel">Name</td>
        <td class="itemValue"><%= @level4.name%></td>
      </tr>
      
      <tr>
    	<td class="itemLabel">Icon</td>
        <td class="itemValue"><%= @level4.icon%></td>
      </tr>
      
      <tr>
    	<td class="itemLabel">TextH</td>
        <td class="itemValue"><%= @level4.text_h%></td>
      </tr>
      
      <tr>
    	<td class="itemLabel">TextF</td>
        <td class="itemValue"><%= @level4.text_f%></td>
      </tr>
      
      <tr>
    	<td class="itemLabel">Layout</td>
        <td class="itemValue"><%= @level4.layout%></td>
      </tr>
      
      <tr>
    	<td class="itemLabel">SortOrder</td>
        <td class="itemValue"><%= @level4.sortOrder%></td>
      </tr>
      
    </table>
  </div>

</div>
