<%= panelTagStart(false) %>
	<%= modelTagStart('proposerPolicyPartyRole', @policyHolderPolicyPartyRole, @policy)%>

		<div style="display: none;">
			<%= inputTag("roleCd") %>
			<%= inputTag("refGuid") %>
		</div>
	<% modelTagEnd %>
	<%= modelTagStart("PolicyProposerDO", @policyHolder, @policy) %>
		<%
			partyPckg = 'PolicyProposerDO'
			@tagName = 'PolicyProposerDO'
		%>

		<%= subPanelTagStart("PartyDetails",false) %>	
			<%= prdFieldDataTag("#{partyPckg}",'roleCd') %>
			
			<div id='<%= @tagName %>_individualDetail'>
				<%= prdFieldDataTag("#{partyPckg}","firstName1,lastName1,birthDt,age,genderCd") %>
			</div>
		<%= subPanelTagEnd %>
	
		<% if @renderPolicyHolderAddressPanel %>
			<div id="<%=@tagName%>_partyAddress">
				<% partyAddressPckg = 'PartyAddressDO' %>
				<% if renderHomeAddressPanel %>
					<div id="<%=@tagName%>_homeAddressContainer">
						<%= prdFieldDataTag("#{partyPckg}",'copyFromAddr1') %>
						<div id="<%=@tagName%>_home-address-details">
							<%= modelTagStart('proposerPartyAddressHome', @policyHolderHomeAddress, @policyHolder) %>
								<%= prdFieldDataTag("#{partyAddressPckg}",'addressLine1Lang1,addressLine2Lang1,countryCd,pinCode,districtCd,stateCd,cityCd') %>
								<div style="display: none;">
		        					<%= inputTag("addressTypeCd") %>
		    					</div>
							<% modelTagEnd %>
						</div>
					</div>
				<% end %>
			</div>
		<% end %>

		<% if @renderPolicyHolderContactPanel %>
			<%= render(:partial => 'NBPartyContact_Jazz', :locals => {:partyPckg => partyPckg, :party_resi_contact => @policyHolderContactHome, :party_off_contact => @policyHolderContactOffice, :party_mob_contact => @policyHolderContactMobile, :party => @policyHolder, :emailModelId => 'proposerPartyEmail', :partyEmailObject => @policyHolderEmail, 
		  :resiTagId => 'proposerPartyContactResidential', :offTagId => 'proposerPartyContactOffice', :mobTagId => 'proposerPartyContactMobile'}) %>
		<% end %>
	<% modelTagEnd %>

<%= panelTagEnd %>

<%= setupFilterUsingFieldTargetValueMap('TitleGender', false, "PolicyProposerDO") %>
<%= setupFilterUsingFieldTargetValueMap('RelationGender', true, "PolicyProposerDO") %>

<% partyPckg = 'PolicySupplementaryLifeDO' %>
<% if $currentProduct.getFacetValue('FAMILYINSUREDDETAILS').to_s == 'YES' %>
    <% addSupLabel = "#{getLabelValue('ADDFAMILY')}" %>
<% else %>
    <% addSupLabel = "#{getLabelValue('ADDSUPPLEMENTLIFE')}" %>
<% end %>
<%= fieldDataEntryGridTagStart('supplementaryDetails',partyPckg,nil, nil, nil,nil,'delete','',nil,true,true,false,false,false) %>
	<% @supplementary_form = '' %>
	<% if @supplementaryLife != nil %>
		<% @supplementaryLife.each_with_index do |supplementary, count| %>
			<% policyProduct = @supPolicyProductHM[supplementary.guid] %>
			<% @supplementary_form << addMoreTraveller(@policy, supplementary, count, policyProduct, @supPolicyProductCount.to_i + 1) %>
		<% end %>
	<% end %>
	<%= panelTagStart(true) %>
		<%= @supplementary_form %>
	<%= panelTagEnd %>
<%= fieldDataEntryGridTagEnd('supplementaryDetails', @supplementaryLife, addSupLabel,true,true) %>
<input type="hidden" name="suplementaryInsuredCount" id="suplementaryInsuredCount" value='<%= @suplementaryInsuredCount + @supplementaryLife.size %>'/>
<% if @supplementaryProductFacet%>
	<input type="hidden" name="supPolicyProductCount" id="supPolicyProductCount" value='<%= @supPolicyProductCount + @supPolicyProductHM.size %>'/>
<% end %>
