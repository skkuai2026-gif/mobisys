<script type="text/javascript">
var initialPaymentCount = <%= @initialPaymentCount %>;
var paymentForm = "";
var refundForm = "";
var visibleInitialPaymentCount = <%= @initialPaymentCount %>;


function changePaymentTab(tabName) {
	$("#initialPaymentContainer").hide();
	$("#renewalPaymentContainer").hide();
	$("#refundPaymentContainer").hide();
	$("#"+tabName).show();
	$("li#initialPaymentContainerLi>a").removeClass("selectedTab");
	$("li#renewalPaymentContainerLi>a").removeClass("selectedTab");
	$("li#refundPaymentContainerLi>a").removeClass("selectedTab");
	str = "li#" + tabName + "Li>a";
	$(str).addClass("selectedTab");
}


function addInitialPaymentMethod() {
	$(".allInitialPayments div[data-role='collapsible']").each(function(){
		$(this).collapsible("collapse");
	});

	$("[name*='initialPayments']").hide();
	$.ajax({                                    
		url: "/app/Policy/addInitialPaymentMethod",
		async: false,
		data: {'inwardObject': '<%= @inward.object.to_s %>', 'initialPaymentCount': initialPaymentCount, 'visibleInitialPaymentCount': visibleInitialPaymentCount},
		headers: {
        	'Transition-Enabled': false
        },
		success: function(data) {
			$('.allInitialPayments').append(data);
			$('.allInitialPayments').trigger('create');
			$("div."+initialPaymentCount).collapsible("expand");
			initialPaymentCount = initialPaymentCount + 1;
			visibleInitialPaymentCount = visibleInitialPaymentCount + 1;
		}
	});
}


function deleteInitialPaymentMethod(initialPaymentCount) {
	$('div#initialPayment'+initialPaymentCount+' input[name$="[removed]"]').val("YES");
	$('div.'+initialPaymentCount).hide();
	$(".allInitialPayments div[data-role='collapsible']").each(function(){
		$(this).collapsible("collapse");
	});

	visibleInitialPaymentCount = visibleInitialPaymentCount - 1;
	var tempCount = visibleInitialPaymentCount - 1;
	$("h3[class*='iniPayHeaderDetails']:visible a span.numberSpan").each(function(){
		$(this).html(visibleInitialPaymentCount-tempCount);
		tempCount = tempCount - 1;
	});
}


function getBankBranchLookups(bankCd, paymentObj, micrNum) {
	if (bankCd != "") {
		var selectID = paymentObj+"[branchName]";
		var spanID = paymentObj+"[branchLookup]";
		var ajaxData = "bankCd="+bankCd
	}
	else if (micrNum != "") {
		var ajaxData = "micrNum="+micrNum
	}

	$.ajax({
     	url: "/app/Policy/getBankBranchLookups",
     	async: false,
     	data: ajaxData,
        headers: {
          'Transition-Enabled': false
        },
     	success: function(data) {
     		if (bankCd != "") {
	     		if (data != "") {
		           	create = '<select id="'+selectID+'" name="'+selectID+'">';    
		           	create += data;
		           	create += '</select>';
	           	}
	           	$('span[name="'+ spanID +'"]').html(create);
	           	$('span[name="'+ spanID +'"]').trigger('create');
           	}
			else if (micrNum != "NOMICR") {
				if (data.toUpperCase() != "") {
					$("input[name='"+paymentObj+"[bankCd]']").val(JSON.parse(data).bankName);
					$("input[name='"+paymentObj+"[branchName]']").val(JSON.parse(data).bankBranch);
				}
   				setReadOnly($("input[name='"+paymentObj+"[bankCd]']"), true);
   				setReadOnly($("input[name='"+paymentObj+"[branchName]']"), true);
			}
       	}
  	});
}


function payerDependency(object, payerTypeCd, paymentType, onLoad) {
	if (payerTypeCd == "AGENT") {
		$('span[name="'+object+'[refGuidLookup]"]').parent().hide();
		if (onLoad) {
			$('span[name="'+object+'[refGuidLookup]"] select').attr('disabled','disabled');
		}
		else {
			$('span[name="'+object+'[refGuidLookup]"] select').selectmenu('enable');
		}
		$('input[name="'+object+'[payerPartyRefGuid]"]').attr('disabled','disabled');
		$('#'+paymentType+'Payer input[id*="removed"][id*="Policy[Party]"]').val("YES");
		$('#'+paymentType+'PaymentContainer .legend').hide();
		$("#"+paymentType+"Payer").hide();
	}
	else if (payerTypeCd == "OTHER") {
		$('span[name="'+object+'[refGuidLookup]"]').parent().hide();
		if (onLoad) {
			$('span[name="'+object+'[refGuidLookup]"] select').attr('disabled','disabled');
		}
		else {
			$('span[name="'+object+'[refGuidLookup]"] select').selectmenu('enable');
		}
		$('input[name="'+object+'[payerPartyRefGuid]"]').removeAttr('disabled');
		$('#'+paymentType+'Payer input[id*="removed"][id*="Policy[Party]"]').val("");
		$('#'+paymentType+'PaymentContainer .legend').show();
		$("#"+paymentType+"Payer").show();
	}
	else if (payerTypeCd == "SUPPLEMENTARY") {
		$('span[name="'+object+'[refGuidLookup]"]').parent().show();
		if (onLoad) {
			$('span[name="'+object+'[refGuidLookup]"] select').removeAttr('disabled');
		}
		else {
			$('span[name="'+object+'[refGuidLookup]"] select').selectmenu('enable');
		}
		$('input[name="'+object+'[payerPartyRefGuid]"]').attr('disabled','disabled');
		$('#'+paymentType+'Payer input[id*="removed"][id*="Policy[Party]"]').val("YES");
		$('#'+paymentType+'PaymentContainer .legend').hide();
		$("#"+paymentType+"Payer").hide();
	}
	else {
		$('span[name="'+object+'[refGuidLookup]"]').parent().hide();
		if (onLoad) {
			$('span[name="'+object+'[refGuidLookup]"] select').attr('disabled','disabled');
		}
		else {
			$('span[name="'+object+'[refGuidLookup]"] select').selectmenu('enable');
		}
		$('input[name="'+object+'[payerPartyRefGuid]"]').attr('disabled','disabled');
		$('#'+paymentType+'Payer input[id*="removed"][id*="Policy[Party]"]').val("YES");
		$('#'+paymentType+'PaymentContainer .legend').hide();
		$("#"+paymentType+"Payer").hide();
	}
}


function submitForm() {
	if(paymentForm != $('#paymentForm').serialize() || refundForm != $('#refundForm').serialize()) {		
		$('span[id="errordiv"]').hide();
		$.ajax({                                    
			url: "/app/Policy/submitPaymentDetails",
			method: 'POST',
			async: false,
			data: $('#paymentForm').serialize(),
			headers: {
	        	'Transition-Enabled': false
	        },
			success: function(data) {
				$("a#submit").hide();
				if (data == "true") {
					$("a#paymentGateWay").show();
				}
				else {
					$("a#paymentGateWay").hide();	
				}
				<% if @facetData[:renderRefundPanel] %>
					$.ajax({
						url: "/app/Policy/submitPaymentDetails",
						method: 'POST',
						async: false,
						data: $('#refundForm').serialize(),
						headers: {
				        	'Transition-Enabled': false
				        },
						success: function(data) {
							$("a#submit").hide();
						}
					});
				<% end %>
			}
		});
	}
}

  	
function clearDataOfPaymentFields(type) {
	$('input[name="' + type +'[micrNum]"]').val('');
	$('input[name="' + type +'[bankCd]"]').val('');
	$('select[name="' + type +'[bankCd]"]').val('').selectmenu('refresh');
	$('input[name="' + type +'[branchName]"]').val('');
	$('select[name="' + type +'[branchName]"]').val('').selectmenu('refresh');
	$('select[name="' + type +'[cardExpiryYear]"]').val('').selectmenu('refresh');
	$('select[name="' + type +'[cardExpiryMnth]"]').val('').selectmenu('refresh');
	$('input[name="' + type +'[accountName]"]').val('');
	$('input[name="' + type +'[inwardNum]"]').val('');
	$('input[name="' + type +'[accountNum]"]').val('');
	$('input[name="' + type +'[cardTypeCd]"]').val('');
	$('select[name="' + type +'[cardTypeCd]"]').val("").selectmenu("refresh");
} 


