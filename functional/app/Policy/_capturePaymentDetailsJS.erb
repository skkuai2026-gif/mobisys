			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[branchName]"]').parents(".half").hide();
			$('select[name="<%=getObjectMapping(@refundFinancialAccount)%>[bankCd]"]').parents(".half").hide();
			$('select[name="<%=getObjectMapping(@refundFinancialAccount)%>[branchName]"]').parents(".half").hide();
			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[accountName]"]').parents(".half").hide();
			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[accountNum]"]').parents(".half").hide();
		}


		$('#refundPaymentContainer select[name="<%=getObjectMapping(@refundPayment)%>[paymentMethodCd]"]').change(function(){
        	var type = "<%=getObjectMapping(@refundFinancialAccount)%>";
        	var refundPaymentMethod = $('#refundPaymentContainer select[name="<%=getObjectMapping(@refundPayment)%>[paymentMethodCd]"]').val();
        	$('#refundPaymentContainer select[name="<%=getObjectMapping(@renewalFinancialAccount)%>[paymentMethodCd]"]').val(refundPaymentMethod);

        	clearDataOfPaymentFields(type);
	  		if ($(this).val() == "directCredit") {
	  			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[micrNum]"]').parents(".half").show();
	  			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[bankCd]"]').parents(".half").show();
	  			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[branchName]"]').parents(".half").show();
	  			$('select[name="<%=getObjectMapping(@refundFinancialAccount)%>[bankCd]"]').parents(".half").show().selectmenu("refresh");
	  			$('select[name="<%=getObjectMapping(@refundFinancialAccount)%>[branchName]"]').parents(".half").show().selectmenu("refresh");
	  			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[accountName]"]').parents(".half").show();
	  			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[accountNum]"]').parents(".half").show();
	  		}
	  		else {
	  			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[micrNum]"]').parents(".half").hide();
	  			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[bankCd]"]').parents(".half").hide();
	        $('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[branchName]"]').parents(".half").hide();
	  	    $('select[name="<%=getObjectMapping(@refundFinancialAccount)%>[bankCd]"]').parents(".half").hide();
	  		  $('select[name="<%=getObjectMapping(@refundFinancialAccount)%>[branchName]"]').parents(".half").hide();
	  			$('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[accountName]"]').parents(".half").hide();
	  		  $('input[name="<%=getObjectMapping(@refundFinancialAccount)%>[accountNum]"]').parents(".half").hide();
	  			
	  		}
	  	});
	<% end %>

	//Mark fields mandatory based on Validation Metadata
	<%
	if @mandatoryFields
		@mandatoryFields.each do |object, fields|
			fields.each do |field|
	%>
				$("label[for='<%=getObjectMapping(object)%>[<%= field %>]']").append('<label for=" *" class="mandatory1">&nbsp;*</label>');
	<% 
			end
		end
	end 
	%>
});
</script>