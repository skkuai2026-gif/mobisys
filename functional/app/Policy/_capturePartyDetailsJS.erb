<script type="text/javascript">
function getSupplementaryIds(policy, policyPartyRole) {
	var ajaxData = "policyObject="+$('input[name="'+policy+'[object]"]').val();
	var selectID = policyPartyRole+"[refGuid]";
	var spanID = policyPartyRole + "[refGuidLookup]";

	$.ajax({
     	url: "/app/Policy/getSupplementaryIds",
     	data: ajaxData,
     	async: false,
		headers: {
        	'Transition-Enabled': false
        },
     	success: function(data) {
           	create = '<select id="'+selectID+'" name="'+selectID+'">';    
           	create += data;
           	create += '</select>';
           	$('span[name="'+ spanID +'"]').html(create);
           	$('span[name="'+ spanID +'"]').trigger('create');
       }
  	});

}


function checkForMinor() {
	var minorFlag = false;
	<% if @facetData[:majorAge].to_s != "" %>
		$("div[name=beneficiaries]").each(function(){
			var parentId = "#" + $(this).attr("id");

			if($(parentId + " input[name*=removed]").val() == "") {
				var age = $(parentId + " input[name*=age]").val();

				if (parseInt(age) < parseInt("<%= @facetData[:majorAge] %>") && age != "") {
					minorFlag = true;
					return false;				
				}
			}
			else if ($(parentId + ' select[name*="[partySameAsCd]"]').val() != "NEW" && $(parentId + ' select[name*="[partySameAsCd]"]').val() != "") {
				var age = $(parentId + " input[name*=age]").val();

				if (parseInt(age) < parseInt("<%= @facetData[:majorAge] %>") && age != "") {
					minorFlag = true;
					return false;				
				}	
			}
		});
	<% end %>

	if(minorFlag) {
		$('#appointeeContainer input[name$="[removed]"]').val("");
		$("#appointeeContainerLi").show();		
	}
	else {
		$('#appointeeContainer input[name$="[removed]"]').val("YES");
		$("#appointeeContainerLi").hide();		
	}	
}


function getPartyAge(policyObject, roleCd, party) {
	$.ajax({
     	url: "/app/Policy/getPartyAge",
     	data: "policyObject="+policyObject+"&roleCd="+roleCd,
     	async: false,
		headers: {
        	'Transition-Enabled': false
        },
     	success: function(data) {
     		$('input[id="'+party+'[age]"]').val(data);
			checkForMinor();
     	}
 	});
}


