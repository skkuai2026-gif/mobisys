        }
        else {
			getDOB(this.value, '<%= getObjectMapping(@party)%>[birthDt]');
			<% if @beneficiary %>
			checkForMinor();
			<% end %>
		}
	});


	$('input[name*="[percentage]"]').change( function(){
		if (isNaN(this.value)) {
	    	showDialog("", "VALID_SPLIT", 'warning', 0, 'capture');
	    	this.value = this.value.replace(/[^0-9]/g, '');
	  	}
	}); 


	if ($("select[name='<%=getObjectMapping(@party)%>[citizenshipCd]']").val()=="OTHERS"){
  		$("input[name='<%=getObjectMapping(@party)%>[otherCitizenship]']").parents('div[class="half"]').show();
  	}
  	else{
  		$("input[name='<%=getObjectMapping(@party)%>[otherCitizenship]']").parents('div[class="half"]').hide();
  	}

  	$("select[name='<%=getObjectMapping(@party)%>[citizenshipCd]']").change(function(){
		if ($(this).val()=="OTHERS"){
	  		$("input[name='<%=getObjectMapping(@party)%>[otherCitizenship]']").parents('div[class="half"]').show();
	  	}
	  	else{
	  		$("input[name='<%=getObjectMapping(@party)%>[otherCitizenship]']").parents('div[class="half"]').hide();
	  	}  		
  	});
     
     
	// making auto populated fields readonly
	if ('<%= @policy.quotationRefGuid %>' != '' && '<%= @party.roleCd %>' != "NOMINEE" && '<%= @party.roleCd %>' != "APPOINTEE" && '<%= @party.roleCd %>' != "PAYER"){
		$('select[name="<%=getObjectMapping(@party)%>[partyTypeCd]"]').attr('disabled', true);
		$('select[name="<%=getObjectMapping(@party)%>[partyTypeCd]"]').trigger("create");
		
		$('select[name="<%=getObjectMapping(@party)%>[titleCd]"]').attr('disabled', true);
		$('select[name="<%=getObjectMapping(@party)%>[titleCd]"]').trigger("create");
		
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[firstName1]"]'), true);
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[middleName1]"]'), true);
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[lastName1]"]'), true);
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[extensionName1]"]'), true);
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[firstName2]"]'), true);
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[middleName2]"]'), true);
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[lastName2]"]'), true);
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[extensionName2]"]'), true);
		
		$('input[name="<%=getObjectMapping(@party)%>[genderCd]"]').attr('disabled', true);
		$('input[name="<%=getObjectMapping(@party)%>[genderCd]"]').trigger("create");
		
		$('select[name="<%=getObjectMapping(@party)%>[relationCd]"]').attr('disabled', true);
		$('select[name="<%=getObjectMapping(@party)%>[relationCd]"]').trigger("create");
		
		$('input[name="<%=getObjectMapping(@party)%>[smoker]"]').attr('disabled', true);
		$('input[name="<%=getObjectMapping(@party)%>[smoker]"]').trigger("create");
		
		$('input[name="<%=getObjectMapping(@party)%>[nsap]"]').attr('disabled', true);
		$('input[name="<%=getObjectMapping(@party)%>[nsap]"]').trigger("create");
		
		$('select[name="<%=getObjectMapping(@party)%>[coverageCountryCd]"]').attr('disabled', true);
		$('select[name="<%=getObjectMapping(@party)%>[coverageCountryCd]"]').trigger("create");
		
		$('select[name="<%=getObjectMapping(@party)%>[coverageCityCd]"]').attr('disabled', true);
		$('select[name="<%=getObjectMapping(@party)%>[coverageCityCd]"]').trigger("create");

		$('input[name="<%=getObjectMapping(@party)%>[maritalStatusCd]"]').attr('disabled', true);
		$('input[name="<%=getObjectMapping(@party)%>[maritalStatusCd]"]').trigger("create");
		
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[birthDt]"]'), true);
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[age]"]'), true);
		setReadOnly($('input[name="<%=getObjectMapping(@party)%>[corporateName1]"]'), true);
	}

	
	//Mark fields mandatory based on Validation Metadata
	<% 
	if @mandatoryFields
		if @mandatoryFields[@party]
			@mandatoryFields[@party].each do |field| 
	%>
			$("label[for='<%=getObjectMapping(@party)%>[<%= field %>]']").append('<label for=" *" class="mandatory1">&nbsp;*</label>');
	<% 
			end
		end
		if @mandatoryFields[@policyPartyRole]
			@mandatoryFields[@policyPartyRole].each do |field| 
	%>
			$("label[for='<%=getObjectMapping(@policyPartyRole)%>[<%= field %>]']").append('<label for=" *" class="mandatory1">&nbsp;*</label>');
	<% 
			end
		end 
	end
	%>
});
</script>