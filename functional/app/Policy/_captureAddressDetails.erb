<% if @facetData[:renderMultiLanguagePanel] %>
	<div data-role="dualfieldcontain">
		<div class="half">
			<%= renderLabel('language', 'language1', 'languageLabel', @party)%>
		</div>
		<div class="half">
			<%= renderLabel('language', 'language2', 'languageLabel', @party)%>
		</div>
	</div>
<% end %>


