<div data-role="dualfieldcontain">
	<% if @facetData[:renderAddressCountryCd] %>
		<div class="half">
		    <%= renderLabel('countryCd','countryCd', nil, addressObj) %>
		    <%= getLookup('COUNTRY','countryCd', addressObj.countryCd, addressObj,' maxlength="120"')%>
		</div>	
    <% end %>
	<% if @facetData[:renderPinCode] %>  
		<div class="half">
		  	<%= renderLabel('pinCode', 'pinCode', nil, addressObj) %>
		  	<%= renderInputField('pinCode', addressObj.pinCode, 'Pincode', addressObj, ' maxlength="10"') %>
	  	</div>
    <% end %>
</div>


<div data-role="dualfieldcontain">	 
	<% if @facetData[:renderDistrictCd] %> 
		<div class="half">
		  	<%= renderLabel('districtCd','stateCd', nil, addressObj) %>
		  	<span class="districtLookUpData<%= addressObj.addressTypeCd %>" name="districtLookUpData<%= addressObj.addressTypeCd %>">
		  		<%# if @districtLookUps.empty? %>
		  			<%= renderInputField('districtCd', addressObj.districtCd, 'District', addressObj, ' maxlength="30"') %>
	  			<%# else %>
		  			<%#= getLookup('DYNAMICLOOKUP','districtCd', addressObj.districtCd, addressObj , @districtLookUps) %>
	  			<%# end %>
	  		</span>
	  	</div>
    <% end %>
	<% if @facetData[:renderCityCd] %>
		<div class="half">
		  	<%= renderLabel('cityCd','cityCd', nil, addressObj) %>
		  	<span class="cityLookUpData<%= addressObj.addressTypeCd %>" name="cityLookUpData<%= addressObj.addressTypeCd %>">
		  		<%# if @cityLookUps.empty? %>
		  			<%= renderInputField('cityCd', addressObj.cityCd, 'City', addressObj, ' maxlength="30"') %>
	  			<%# else %>
					<%#= getLookup('DYNAMICLOOKUP','cityCd', addressObj.cityCd, addressObj, @cityLookUps) %>
	  			<%# end %>
		  	</span>
		</div>	
    <% end %>
</div>

<%= renderHiddenField('addressTypeCd', addressObj.addressTypeCd, 'addressTypeCd', addressObj) %>
<%= renderHiddenField('removed', addressObj.removed, 'removed', addressObj) %>
<%= render :partial => "captureAddressDetailsJS", :locals => { :addressObj => addressObj} %>