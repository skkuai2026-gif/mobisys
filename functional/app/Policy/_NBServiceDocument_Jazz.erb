<style type="text/css">
#full-image .close-before-save {
	margin-bottom: 54px;
}

#full-image img {
	width: auto;
}

#extractButton {
	font-size: 12px;
	padding: 5px;
}
</style>
<% @windows_platform = System.get_property('platform') == 'WINDOWS_DESKTOP' %>
<% if @navbarIds != '' %>
	<%= navbarTagStart(@navbarIds,@navbarLabels) %>
		<%= modelTagStart("documentContainer",@container) %>
			<input type="hidden" id="multiDocMode" name="multiDocMode" value="<%= @multiDocMode %>"/>
			<input type="hidden" id="ocrEnabledDocs" name="ocrEnabledDocs" value="<%= @documentHashMap.select{|x,y| x if y.to_s != ""}.keys.join(",") %>"/>
			<div data-role="tabs">
				<% if @multiDocMode %>
					<div class="requirement-content-wrapper" data-role="">
						<div class="requirement-content-wrapper-left">
							<div class="collapse-panel">
								<div data-role="collapsible" data-collapsed="false">
									<ul data-role="listview">
										<% 
										count = 0
										@categoryLabelHM.each do |index, docCategoryCd|
											active = count==0 ? "active":""
										%>
										<p id="tab-<%= index %>-proof" class="categorySelector <%= active %>"><%= getLabelValue(docCategoryCd) %></p>
										<% 
											count+=1
										end 
										%>
									</ul>
								</div>
							</div>
						</div>

						<div class="requirement-content-wrapper-right">
							<% count = 0 %>
							<% serviceDocumentCounter = 0
							@requirementsHM.each do |categoryCd, serviceDocuments| %>
								<div id="tab-<%= categoryCd %>-proof-panel" class="ui-body-d tablist-content">	
									<% serviceDocuments.each do |documentCd, serviceDocument|
										images = @imageHM[serviceDocument.uniqueKey]
										gridID = "grid_#{serviceDocumentCounter}_serviceDocument" %>
										<%= modelTagStart(gridID, serviceDocument, @container, serviceDocumentCounter) %>
											<div style="display: none;">
												<%= inputTag("isAutoGeneratedFl") %>
											</div>
											<div class="proof-bg-multi">
												<div class="proof-left-multi">
													<p class="col-right">
														<%= inputTag("selected") %>
													</p>
													<div class="documentDesc">
														<%= getLabelValue(serviceDocument.docDescription) %>
														<%= errorTag("selected") %>
													</div>

													<% if @windows_platform && $rhoconfig[:windowsOpenCameraInBrowser] %>
								                		<a href="javascript:redirect_to_browser('<%=serviceDocument.uniqueKey%>', '<%=serviceDocument.documentCd%>', '<%=@policy.object%>');" class="takepic" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/1camera.png"></a>
									          		<% else %>
														<a href="javascript:takePicture('<%= gridID %>');" class="takepic byCamera" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/1camera.png"></a>
														<a href="javascript:takePicture('<%= gridID %>','gallery');" class="takepic" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/gallery.png"></a>
														<a href="javascript:takePicture('<%= gridID %>','document');" class="takepic" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/browse.png"></a>
													<% end %>
													<% if $rhoconfig[:ocr_enabled].value.to_s == "YES"  && @documentHashMap.has_key?(documentCd) && @documentHashMap[documentCd].to_s != "" %>
														<div class="ocrF1">
															<%= inputTag("disableOcrFl")%> 
															<%= labelTag("disableOcrFl") %>
														</div>
													<% end %>
												</div>

												<div class="proof-right-multi attach-image-section" name="<%=serviceDocument.uniqueKey %>">
													<% status = "" %>
													<% if @windows_platform && $rhoconfig[:windowsOpenCameraInBrowser] %>
														<% image_hash = get_cam_pic_on_view(serviceDocument.uniqueKey) %>
														<% image_hash.each do |key,imageDO| %>
															<% offlineFile = imageDO.OfflineFileList[0]%>
															<%
															if offlineFile.to_s != ""
																imageURL = ""
																if offlineFile.fileLocation.include?(".pdf")
																	imageURL = "/public/jazz/images/pdf_512.png"
																elsif offlineFile.fileLocation.include?(".gif")
																	imageURL = "/public/jazz/images/gif_512.png"
																elsif offlineFile.fileLocation.include?(".doc")
																	imageURL = "/public/jazz/images/doc_512.png"
																elsif offlineFile.fileLocation.include?(".tiff")
																	imageURL = "/public/jazz/images/tiff_512.png"
																elsif offlineFile.fileLocation.include?(".xls")
																	imageURL = "/public/jazz/images/xls_512.png"
																else
																	if offlineFile.fileEncrypted == 'YES'
																		decodedContent = MobiSys::Encryption.decryptContent("#{offlineFile.fileContents}|#{offlineFile.encryptionIv}")
																		imageURL = 'data:image/jpeg;base64,'+MobiSys::Encryption.encodeContents(decodedContent)
																	else
																		imageURL = 'data:image/jpeg;base64,'+offlineFile.fileContents
																	end
																end
															%>
																<div class="proof-img" name="<%=offlineFile.parentKey %>">
																	<a href="#full-image" data-rel="popup" data-position-to="window" data-transition="pop" for="<%= imageURL %>" data-imagevalue="<%=offlineFile.parentKey %>" >
																		<img src="<%= imageURL %>"/>
																	</a>
																	<% if imageDO.uploadStatus.to_s == '' %>
																		<a style="position:absolute;top:0;z-index:99;right:0;" id="deleteAnchor<%=offlineFile.parentKey%>" href="javascript:deletePopup('<%=offlineFile.parentKey%>','DELETE_CONFIRMATION','image')
																" data-servicedocGuid="<%=serviceDocument.uniqueKey%>"><img src="/public/jazz/images/del.jpg" alt="Delete" title="Delete"></a>
																	<% end %>
																	<% status = imageDO.uploadStatus.to_s %>
																</div>
										            		<% end %>
											        	<% end %>
											    	<% elsif images %>
														<% images.each_with_index do |imageDO,index| %>
															<% offlineFile = imageDO.OfflineFileList[0]%>
															<%
															if offlineFile.to_s != "" 
																imageURL = ""
																if offlineFile.fileLocation.include?(".pdf")
																	imageURL = "/public/jazz/images/pdf_512.png"
																elsif offlineFile.fileLocation.include?(".gif")
																	imageURL = "/public/jazz/images/gif_512.png"
																elsif offlineFile.fileLocation.include?(".doc")
																	imageURL = "/public/jazz/images/doc_512.png"
																elsif offlineFile.fileLocation.include?(".tiff")
																	imageURL = "/public/jazz/images/tiff_512.png"
																elsif offlineFile.fileLocation.include?(".xls")
																	imageURL = "/public/jazz/images/xls_512.png"
																else
																	if offlineFile.fileEncrypted == 'YES'
																		decodedContent = MobiSys::Encryption.decryptContent("#{offlineFile.fileContents}|#{offlineFile.encryptionIv}")
																		imageURL = 'data:image/jpeg;base64,'+MobiSys::Encryption.encodeContents(decodedContent)
																	else
																		imageURL = 'data:image/jpeg;base64,'+offlineFile.fileContents
																	end
																end
															%>
															<div class="proof-img" name="<%=offlineFile.parentKey %>">
																<a href="#full-image" data-rel="popup" data-position-to="window" data-transition="pop" for="<%= imageURL %>" data-imagevalue="<%=offlineFile.parentKey %>">
																	<img src="<%= imageURL %>" alt="">
																</a>
																<% if imageDO.uploadStatus.to_s == '' %>
																	<a style="position:absolute;top:0;z-index:99;right:0;" id="deleteAnchor<%=offlineFile.parentKey%>" href="javascript:deletePopup('<%=offlineFile.parentKey%>','DELETE_CONFIRMATION','image')
															" data-servicedocGuid="<%=serviceDocument.uniqueKey%>"><img src="/public/jazz/images/del.jpg" alt="Delete" title="Delete"></a>
																<% end %>
																<% status = imageDO.uploadStatus.to_s %>
															</div>
															<% end %>
														<% end %>
													<% end %>
													<input type ="hidden" id = <%="grid_#{count}_serviceDocument_uploadStatus" %> value ="<%= status%>"/>
													<% count= count+1 %>
												</div>

												<div style='display: none;'>
													<%= inputTag("referenceObject") %>
													<%= inputTag("docCategoryTypeCd") %>
													<%= inputTag("docCategoryCd") %>
													<%= inputTag("partyGuid") %>
													<%= inputTag("receivedDt") %>
													<%= inputTag("acceptanceStatusCd") %>
													<%= inputTag("documentCd") %>
													<%= inputTag("imageCount") %>
												</div>
											</div>
											<% serviceDocumentCounter = serviceDocumentCounter + 1 %>
										<% modelTagEnd %>
									<% end %>
								</div>
							<% end %>
						</div>

						<div style='display: none;'>
							<%= inputTag("entityGuid") %>
							<%= inputTag("entityTypeCd") %>
							<%= inputTag("policyGuid") %>
						</div>
					</div>
				<% else %>
					<div class="requirement-content-wrapper" data-role="">
						<div class="requirement-content-wrapper-left">
							<div class="collapse-panel">
								<div data-role="collapsible" data-collapsed="false">
									<ul data-role="listview">
										<% 
										count = 0
										@categoryLabelHM.each do |index, docCategoryCd|
											active = count==0 ? "active":""
										%>
										<p id="tab-<%= index %>-proof" class="categorySelector <%= active %>"><%= getLabelValue(docCategoryCd) %></p>
										<% 
											count+=1
										end 
										%>
									</ul>
								</div>
							</div>
						</div>

						<div class="requirement-content-wrapper-right">
							<% count = 0 %>
							<% 
							@requirementsHM.each_with_index do |(key, serviceDocument), index| 
								images = @imageHM[serviceDocument.guid]
								gridID = "grid_#{index}_serviceDocument"
							%>
								<%= modelTagStart(gridID, serviceDocument, @container, index) %>
									<div style="display: none;">
										<%= inputTag("isAutoGeneratedFl") %>
									</div>
									<div id="tab-<%= serviceDocument.docCategoryCd %>-proof-panel" class="ui-body-d tablist-content">
										<div class="proof-bg">
											<div class="proof-left">
												<h3><%= getLabelValue(@categoryLabelHM[serviceDocument.docCategoryCd]) %></h3>

												<div class="project-data-full">
													<div class="row-details">
														<%= labelTag("documentCd") %>
														<p class="col-right docc">
															<%= inputTag("documentCd") %>
														</p>
															<%= errorTag("selected") %>
													</div>
												</div>

												<% if @windows_platform && $rhoconfig[:windowsOpenCameraInBrowser]%>
							                		<input type="button" id="capture<%=serviceDocument.object%>" class="takepic capture" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>" value="<%= getLabelValue('addPic')%>" data-inline="true" onclick="javascript:redirect_to_browser('<%=serviceDocument.uniqueKey%>', 'SINGLEDOC', '<%=@policy.object%>');">
								          		<% else %>
													<a href="javascript:takePicture('<%= gridID %>');" class="takepic ui-btn ui-btn-attach" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><%= getLabelValue('addPic') %></a>
													<a href="javascript:takePicture('<%= gridID %>','gallery');" class="takepic ui-btn ui-btn-attach" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><%= getLabelValue('choosePic') %></a>
													<a href="javascript:takePicture('<%= gridID %>','document');" class="takepic ui-btn ui-btn-attach" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><%= getLabelValue('browse') %></a>
												<% end %>
											</div>

											<div class="proof-right attach-image-section" name="<%=serviceDocument.uniqueKey %>">
												<% status = "" %>
												<% if @windows_platform && $rhoconfig[:windowsOpenCameraInBrowser]%>
													<% image_hash = get_cam_pic_on_view(serviceDocument.uniqueKey) %>
													<% image_hash.each do |key,offlineFile| %>
														<%
														if offlineFile.to_s != "" 
															imageURL = ""
															if offlineFile.fileLocation.include?(".pdf")
																imageURL = "/public/jazz/images/pdf_512.png"
															elsif offlineFile.fileLocation.include?(".gif")
																imageURL = "/public/jazz/images/gif_512.png"
															elsif offlineFile.fileLocation.include?(".doc")
																imageURL = "/public/jazz/images/doc_512.png"
															elsif offlineFile.fileLocation.include?(".tiff")
																imageURL = "/public/jazz/images/tiff_512.png"
															elsif offlineFile.fileLocation.include?(".xls")
																imageURL = "/public/jazz/images/xls_512.png"
															else
																if offlineFile.fileEncrypted == 'YES'
																	decodedContent = MobiSys::Encryption.decryptContent("#{offlineFile.fileContents}|#{offlineFile.encryptionIv}")
																	imageURL = 'data:image/jpeg;base64,'+MobiSys::Encryption.encodeContents(decodedContent)
																else
																	imageURL = 'data:image/jpeg;base64,'+offlineFile.fileContents
																end
															end
														%>
														<div class="proof-img" name="<%=offlineFile.parentKey %>">
															<a href="#full-image" data-rel="popup" data-position-to="window" data-transition="pop" for="<%= imageURL %>" data-imagevalue="<%=offlineFile.parentKey %>">
																<img src="<%= imageURL %>"/>
															</a>
															<% if @policy.policyNum.to_s == '' %>
																<a style="position:absolute;top:0;z-index:99;right:0;" id="deleteAnchor<%=offlineFile.parentKey%>" href="javascript:deletePopup('<%=offlineFile.parentKey%>','DELETE_CONFIRMATION','image')
															" data-servicedocGuid="<%=serviceDocument.guid%>"><img src="/public/jazz/images/del.jpg" alt="Delete" title="Delete"></a>
															<% end %>
														</div>
														<% end %>
										        	<% end %>
										    	<% elsif images %>
													<% images.each_with_index do |imageDO,index| %>
														<% offlineFile = imageDO.OfflineFileList[0]%>
					        							<%
														if offlineFile.to_s != "" 
															imageURL = ""
															if offlineFile.fileLocation.include?(".pdf")
																imageURL = "/public/jazz/images/pdf_512.png"
															elsif offlineFile.fileLocation.include?(".gif")
																imageURL = "/public/jazz/images/gif_512.png"
															elsif offlineFile.fileLocation.include?(".doc")
																imageURL = "/public/jazz/images/doc_512.png"
															elsif offlineFile.fileLocation.include?(".tiff")
																imageURL = "/public/jazz/images/tiff_512.png"
															elsif offlineFile.fileLocation.include?(".xls")
																imageURL = "/public/jazz/images/xls_512.png"
															else
																if offlineFile.fileEncrypted == 'YES'
																	decodedContent = MobiSys::Encryption.decryptContent("#{offlineFile.fileContents}|#{offlineFile.encryptionIv}")
																	imageURL = 'data:image/jpeg;base64,'+MobiSys::Encryption.encodeContents(decodedContent)
																else
																	imageURL = 'data:image/jpeg;base64,'+offlineFile.fileContents
																end
															end
														%>
														<div class="proof-img" name="<%=offlineFile.parentKey %>">
															<a href="#full-image" data-rel="popup" data-position-to="window" data-transition="pop" for="<%= imageURL %>" data-imagevalue="<%=offlineFile.parentKey %>" >
																<img src="<%= imageURL %>" alt="">
															</a>
															<% if imageDO.uploadStatus.to_s == '' %>
																<a style="position:absolute;top:0;z-index:99;right:0;" id="deleteAnchor<%=offlineFile.parentKey%>" href="javascript:deletePopup('<%=offlineFile.parentKey%>','DELETE_CONFIRMATION','image')
															" data-servicedocGuid="<%=serviceDocument.guid%>"><img src="/public/jazz/images/del.jpg" alt="Delete" title="Delete"></a>	
															<% end %>
															<% status = imageDO.uploadStatus.to_s %>
														</div>
														<% end %>
													<% end %>
												<% end %>
												<input type ="hidden" id = <%="grid_#{count}_serviceDocument_uploadStatus" %> value ="<%= status%>"/>
												<% count= count+1 %>
											</div>

											<div style='display: none;'>
												<%= inputTag("referenceObject") %>
												<%= inputTag("docCategoryTypeCd") %>
												<%= inputTag("docCategoryCd") %>
												<%= inputTag("partyGuid") %>
												<%= inputTag("receivedDt") %>
												<%= inputTag("acceptanceStatusCd") %>
												<%= inputTag("imageCount") %>
											</div>
										</div>
									</div>
								<% modelTagEnd %>
							<% end %>
						</div>

						<div style='display: none;'>
							<%= inputTag("entityGuid") %>
							<%= inputTag("entityTypeCd") %>
							<%= inputTag("policyGuid") %>
						</div>
					</div>
				<% end %>
			</div>
		<% modelTagEnd %>


		<div data-role="popup" id="full-image" data-theme="a" class="ui-corner-all popup-wrapper">
			<div class="popup-close-cust">
				<a href="#" data-rel="back" class="icon-close"></a>
			</div>
			<div class="close-before-save">
				<img src="" alt="">
			</div>
		</div>
	<%= navbarTagEnd %>
<% end %>