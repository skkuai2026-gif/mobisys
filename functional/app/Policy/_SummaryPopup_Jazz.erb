<div id="summaryPopUp">
	<table data-role="table" id="temp-table" data-mode="reflow" class="ui-responsive table-stroke">
		<thead>
			<tr>
				<th><%= getLabelValue('applicant') %></th>
				<th><%= getLabelValue('productID') %></th>
				<% if planColumn %>
					<th><%= getLabelValue('planOptionCd') %></th>
				<% end %>
				<th><%= getLabelValue('sumAssured') %></th>
				<th><%= getLabelValue('modalPremium') %></th>
			</tr>
		</thead>
		<% total_modal_premium = 0.0 %>
		<tbody>
		<% summaryResult.each do |row| %>
			<tr>
				<td><%= row[:fullname] %></td>
				<td><%= row[:product] %></td>
				<% if planColumn %>
					<td><%= row[:plan] %></td>
				<% end %>
				<td class="text-center"><%= row[:sum_assured] %></td>
				<td class="text-center"><%= row[:modal_premium] %></td>
			</tr><% total_modal_premium += row[:modal_premium].gsub(",", "").to_f %>
		<% end %>
			<tr>
			<% if planColumn %>
				<th colspan="4" class="text-right"><%= getLabelValue('totalModalPremium') %></th>
			<% else %>
				<th colspan="3" class="text-right"><%= getLabelValue('totalModalPremium') %></th>
			<% end %>
				<td class="text-center"><%=maskDecimal(total_modal_premium,"###,###,###.##")%></td>
			</tr>
		</tbody>
	</table>
</div>