<%= modelTagStart("signatureContainer", @signatureContainer) %>
	<div style="display: none">
		<%= inputTag("entityGuid") %>
		<%= inputTag("entityTypeCd") %>
	</div>
	<%= modelTagStart("captureSignature#{@signatureObject.guid}", @signatureObject, @signatureContainer) %>
	    <div style="text-align: center;" >
			<%= signaturePopupTag("signature",@signatureObject.guid,true,'captureSign','captureSign',false) %>
		</div>
		<div style="display: none">
			<%= inputTag("signatureDt") %>
            <%= inputTag("signatureTypeCd") %>
            <%= inputTag("entityGuid") %>
            <%= inputTag("partyGuid") %>
            <%= inputTag("entityType") %>
            <%= inputTag("roleCd") %>
        </div>
	<% modelTagEnd %>
<% modelTagEnd %>
<script type="text/javascript">
$('.okSignatureButton[data-id="<%=@signatureObject.guid%>"]').click(function () {
	var signatureGuid = '<%= @signatureObject.guid %>' ;
	setSignature("captureSignature<%=@signatureObject.guid%>_signature","<%=@signatureObject.guid%>");
})

function setSignature(id,signatureGuid){ 
	today = '<%= Time.now.strftime("%d/%m/%Y") %>'
	var signature = $('#' + id).val();
	var strSignature = signature.toString();
	if(strSignature.indexOf("ZLIBCMP")==-1)
	{
		var signatureDtFieldId = id.replace('signature','signatureDt');
		var signatureImgId = "signature" + signatureGuid + "_img";
		var signatureDtId = "signature" + signatureGuid + "_dt";
		if (signature != undefined && signature != '' && signature != null)
		{
			$('#' + signatureDtFieldId).val(today);
			$('#'+signatureImgId).attr("src",signature).show();
			$('#' + signatureDtId).html(today);
		}
		else if (signature == '' || signature == null)
		{
			$('#'+signatureImgId).attr("src","").hide();
			$('#' + signatureDtId).html('');
		}
	}
}

</script>