<fieldset style='margin-left: 92%; margin-top: 2%; position: absolute; z-index: 500;'>
	<input type="button" data-inline="true" data-icon="delete" data-iconpos="notext" onclick="deleteBeneficiary('<%= @beneficiaryCount %>');">
</fieldset>