//Method to update total allocation percentage
function updateFundTotal() {
    var allocationPerc = 0;
    var topupAllocationPerc = 0;

    $('input[id*="policyFunds_allocationPerc"]').each(function() {
        if ($("[id='"+$(this).attr('id').replace("allocationPerc", "removed")+"']").val() != "YES"){

            allocationPerc += parseInt($(this).val());
        }
    });
    
    $('input[id*="policyFunds_topupAllocationPerc"]').each(function() {
        if ($("[id='"+$(this).attr('id').replace("topupAllocationPerc", "removed")+"']").val() != "YES"){
            topupAllocationPerc += parseInt($(this).val());
        }
    });
    
    if(!isNaN(allocationPerc)){
    	$("#policyFunds_allocationPerc_lbl span").html(' (' + allocationPerc+'%)');
    }
    if(!isNaN(topupAllocationPerc)){
    	$("#policyFunds_topupAllocationPerc_lbl span").html(' (' + topupAllocationPerc+'%)');
    }
}

function policyFunds_allocationPerc_func(object){
    if(!isNaN(object.value)){
        var removed = object.id.replace("allocationPerc", "removed");
        if($("#basePlan_topUpAllocSameAsPremAllocFl-0").prop("checked")==true){
            var id = object.id.replace("allocationPerc","topupAllocationPerc");
            $("#"+id).val(object.value);
            $("#"+id).attr("readonly","readonly");
        }
        if(parseInt(object.value) >= 0){
            $("#"+removed).val('');
        }
        else{
            $("#"+removed).val('YES');
        }
        updateFundTotal();
    }
}

function policyFunds_topupAllocationPerc_func(object){
    if(!isNaN(object.value)){
        updateFundTotal();
    }
}


