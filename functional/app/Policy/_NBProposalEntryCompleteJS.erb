function firstPremPolicyPaymentDtl_addButton_func(object) {
	var inwardDetailCount = parseInt($('#inwardDetailCount').val());
    var displayCount = $('#firstPremPolicyPaymentDtl_addButton .button-add-section .notification').text();
    if (($("#grid_"+inwardDetailCount+"_firstPremPolicyPaymentDtl_paymentMethodCd")).val() == "" && ($("#grid_"+inwardDetailCount+"_firstPremPolicyPaymentDtl_removed")).val() != "YES" &&
    	($("#grid_"+inwardDetailCount+"_firstPremPolicyPaymentDtl_inwardAmount")).val() == "")
    {
    	raiseAlert(getLabelValue('ERR_ADDRECORD'),[],locale);
    }
    else{
	    $.ajax({                                    
	        url: "/app/Policy/addInitialPaymentMethod",
	        async: false,
	        data: {'inwardObject': $('#inward_object').val(), 'policyObject': $('#policy_object').val(), 'inwardDetailCount' : inwardDetailCount},
	        headers: {
	        'Transition-Enabled': false
	        },
	        success: function(data) {
	        	$('#inwardDetailCount').val(inwardDetailCount + 1);
	            displayCount =  parseInt(displayCount) + 1; 
	            var gridCount = (inwardDetailCount+1).toString();
	            $('#firstPremPolicyPaymentDtl_addButton .button-add-section .notification').text(displayCount);
	            sectionExist = $(".firstPremPolicyPaymentDtl-main-class >.ui-collapsible-set >.ui-collapsible");
	            if (sectionExist.length > 0){
	                $(".firstPremPolicyPaymentDtl-main-class > .ui-collapsible-set >.ui-collapsible:last").next('.clearfix').after(data);
	            }
	            else{
	                $(".firstPremPolicyPaymentDtl-main-class >.ui-collapsible-set").prepend(data);
	            }
	            $(".firstPremPolicyPaymentDtl-main-class").trigger('create');
	            var paymentMethodCd = document.querySelector('select[id="grid_'+gridCount+'_firstPremPolicyPaymentDtl_paymentMethodCd"]');
				firstPremPolicyPaymentDtl_paymentMethodCd_func(paymentMethodCd,true);

				var micrNum = document.querySelectorAll('input[id*="_firstPremPolicyPaymentDtl_micrNum"]');
				for(var i = 0; i < micrNum.length; i++){
					firstPremPolicyPaymentDtl_micrNum_func(micrNum[i]);
				}

				var bankCd = document.querySelectorAll('select[id*="_firstPremPolicyPaymentDtl_bankCd"]');
				for(var i = 0; i < bankCd.length; i++){
					firstPremPolicyPaymentDtl_bankCd_onFocus(bankCd[i]);
				}

				var bankBranch = document.querySelectorAll('select[id*="_firstPremPolicyPaymentDtl_bankBranch"]');
				for(var i = 0; i < bankBranch.length; i++){
					firstPremPolicyPaymentDtl_bankBranch_onFocus(bankBranch[i]);
				}
				$(".datepicker:not(.inputreadonly)").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: "dd/mm/yy",
                yearRange: "c-100:c+100"
            });
	       	}
	    });
	}
}

