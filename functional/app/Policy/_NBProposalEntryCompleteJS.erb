function disablePartyFieldsIfQuotationRefGuide(party){
	$('#' + party +'_partyTypeCd').selectmenu().selectmenu('disable').trigger("refresh");
	$('#' + party +'_titleCd').selectmenu().selectmenu('disable').trigger("refresh");
	
	setReadOnly($('#' + party +'_firstName1'), true);
	setReadOnly($('#' + party +'_middleName1'), true);
	setReadOnly($('#' + party +'_lastName1'), true);
	setReadOnly($('#' + party +'_extensionName1'), true);
	setReadOnly($('#' + party +'_firstName2'), true);
	setReadOnly($('#' + party +'_middleName2'), true);
	setReadOnly($('#' + party +'_lastName2'), true);
	setReadOnly($('#' + party +'_extensionName2'), true);
	setReadOnly($('#' + party +'_age'), true);
	setReadOnly($('#' + party +'_corporateName1'), true);
	setReadOnly($('#'+party+'_otherTitle'),true);
	setReadOnly($('#'+party+'_otherRelation'),true);
	
	$('input[type="radio"][id*="' + party +'_genderCd"]').checkboxradio().checkboxradio('disable').trigger("refresh");
	$('#' + party +'_relationCd').selectmenu().selectmenu('disable').trigger("refresh");
	$('input[type="radio"][id*="' + party +'_smoker"]').checkboxradio().checkboxradio('disable').trigger("refresh");
	$('input[type="radio"][id*="' + party +'_nsap"]').checkboxradio().checkboxradio('disable').trigger("refresh");
	$('#' + party +'_coverageCountryCd').selectmenu().selectmenu('disable').trigger("refresh");
	$('#' + party +'_coverageCityCd').selectmenu().selectmenu('disable').trigger("refresh");
	$('#' + party +'_maritalStatusCd').selectmenu().selectmenu('disable').trigger("refresh");
	$('#' + party +'_birthDt').addClass('inputreadonly');
}

function disableFieldsIfQuotationRefGuid(){
	if($('#policy_quotationRefGuid').val()!='' && $('#policy_policyNum').val()==''){
		currentTab = $('#sym_current_Tab').val();
		switch(currentTab){
			case "tab_owner":
				if ($("#PolicyProposerDO_titleCd").val() == "OTHER"){
					$("#PolicyProposerDO_otherTitle").parents(".project-data").show();
				}
				else{
					$("#PolicyProposerDO_otherTitle").parents(".project-data").hide();
				}
				disablePartyFieldsIfQuotationRefGuide("PolicyProposerDO");
				break;
			case "tab_primary":
				if ($("#PolicyPrimaryLifeDO_titleCd").val() == "OTHER"){
					$("#PolicyPrimaryLifeDO_otherTitle").parents(".project-data").show();
				}
				else{
					$("#PolicyPrimaryLifeDO_otherTitle").parents(".project-data").hide();
				}
				$('input[type="checkbox"][id*="policy_insuredSameAsProposer"]').checkboxradio().checkboxradio('disable').trigger("refresh");
				disablePartyFieldsIfQuotationRefGuide("PolicyPrimaryLifeDO");
				break;
			case "tab_joint":
				if ($("#PolicyJointLifeDO_titleCd").val() == "OTHER"){
					$("#PolicyJointLifeDO_otherTitle").parents(".project-data").show();
				}
				else{
					$("#PolicyJointLifeDO_otherTitle").parents(".project-data").hide();
				}
				$('input[type="checkbox"][id*="policy_jointLife"]').checkboxradio().checkboxradio('disable').trigger("refresh");
				disablePartyFieldsIfQuotationRefGuide("PolicyJointLifeDO");
				break;

			case "tab_coverage":
				if($("#policy_uwDecisionCd").val() != "ACCEPTEDRATED"){
					// Plan fields
					$('#basePlan_productTerm').selectmenu().selectmenu('disable').trigger("refresh");
					$('#basePlan_premiumPayingTerm').selectmenu().selectmenu('disable').trigger("refresh");
					$('#basePlan_currencyCd').selectmenu().selectmenu('disable').trigger("refresh");
					$('#basePlan_paymentTypeCd').selectmenu().selectmenu('disable').trigger("refresh");
					$('#basePlan_paymentFrequencyCd').selectmenu().selectmenu('disable').trigger("refresh");

					setReadOnly($('#basePlan_baseSumAssured'), true);
					setReadOnly($('#basePlan_baseAnnualPremium'), true);
					setReadOnly($('#basePlan_modalPremium'), true);    
					setReadOnly($('#basePlan_capturedPremiumAmt'), true);

					// Topup fields
					$('input[type="checkbox"][id*="policy_initialTopupFl"]').checkboxradio().checkboxradio('disable').trigger("refresh");
					setReadOnly($('#initialInvesttopup_topUpAmount'), true);

					$('input[type="checkbox"][id*="policy_regularTopupFl"]').checkboxradio().checkboxradio('disable').trigger("refresh");
					setReadOnly($('#regulartopup_topUpAmount'), true);
					setReadOnly($('#regulartopup_topUpPeriod'), true);
					setReadOnly($('#regulartopup_topupFrequencyVal'), true);

					// Fund fields
					$('#basePlan_portfolioModelCd').selectmenu().selectmenu('disable').trigger("refresh");
					$('input[type="checkbox"][id*="basePlan_topUpAllocSameAsPremAllocFl"]').checkboxradio().checkboxradio('disable').trigger("refresh");
					$('input[type="checkbox"][id*="policyFunds_removeButton"]').checkboxradio().checkboxradio('disable').trigger("refresh");
					setReadOnly($('input[id*="policyFunds_allocationPerc"]'), true);
					setReadOnly($('input[id*="policyFunds_topupAllocationPerc"]'), true);

					// Rider fields
					setReadOnly($('[id*="riderDetails_productTerm"]'), true);
					setReadOnly($('[id*="riderDetails_premiumPayingTerm"]'), true);
					setReadOnly($('[id*="riderDetails_baseSumAssured"]'), true);
					setReadOnly($('[id*="riderDetails_coi"]'), true);
					setReadOnly($('[id*="riderDetails_baseAnnualPremium"]'), true);
					setReadOnly($('[id*="riderDetails_modalPremium"]'), true);
					
					$('input[type="checkbox"][id*="riderDetails_selected"]').checkboxradio().checkboxradio('disable').trigger("refresh");
					$('select[id*="riderDetails_productSeq"]').selectmenu().selectmenu('disable').trigger("refresh");
					$('select[id*="riderDetails_productPlanOptionCd"]').selectmenu().selectmenu('disable').trigger("refresh");
					$('select[id*="riderDetails_policyProductInsured_roleCd"]').selectmenu().selectmenu('disable').trigger("refresh");
					$('select[id*="riderDetails_policyProductInsured_insuredPartyRefGuid"]').selectmenu().selectmenu('disable').trigger("refresh");
					$("#button-refreshRiders").attr('disabled','disabled');
					$('a[id$="refreshRiders_addButton"]').parent().hide();
				}
				break;
			case "tab_supplementary":
				supplementaryList = document.querySelectorAll('input[id*="_supplementaryParty_object"]');
				for(var j = 0; j < supplementaryList.length; j++){	
					party = supplementaryList[j].id.replace("_object","");
					var titleCd = document.getElementById(supplementaryList[j].id.replace("_object","_titleCd"));
					if (titleCd != null){
						if ($("#"+titleCd.id).val() == "OTHER"){
							$("#"+titleCd.id.replace("_titleCd","_otherTitle")).parents(".project-data").show();
						}
						else{
							$("#"+titleCd.id.replace("_titleCd","_otherTitle")).parents(".project-data").hide();
						}
					}
					disablePartyFieldsIfQuotationRefGuide(party);
					$('i[id$="_removed"]').hide();
				}
				$('a[id$="supplementaryDetails_addButton"]').parent().hide();
				break;
		}
	}
}

function captureSignature() {
	submitForm();
	document.EAPPProposal.action = "captureSignature";
	document.EAPPProposal.submit();
	loading('show');
}

function captureAgentDeclaration() {
	submitForm();
	document.EAPPProposal.action = "captureAgentDeclaration";
	// Check if form is modified else just trigger FETCH
	initialFormSerialized = initialFormSerialized.replace(/sym_current_Tab=[^&]*&/i, "").replace(/sym_navbar=[^&]*&/i, "");
	submitFormSerialized = $("#" +document.forms[0].id).serialize().replace(/sym_current_Tab=[^&]*&/i, "").replace(/sym_navbar=[^&]*&/i, "");
	if(initialFormSerialized == submitFormSerialized) {
		document.EAPPProposal.action = "captureAgentDeclaration?mode=FETCH";
	}
	document.EAPPProposal.submit();
	loading('show');
}

function eappSubmit() {
	submitForm();
	document.EAPPProposal.action = "executeSubmit";
	document.EAPPProposal.submit();
	loading('show');
}

function executeAutoUWSubmit() {
	submitForm();
	document.EAPPProposal.action = "executeSubmit?doPolicySubmit=false";
	document.EAPPProposal.submit();
	loading('show');
}

function showPolicyResult() {
	submitForm();
	document.EAPPProposal.action = "showPolicyResult";
	document.EAPPProposal.submit();
	loading('show');
}

function paymentGateway() {
	submitForm();
	document.EAPPProposal.action = "executePaymentGateWay";
	document.EAPPProposal.submit();
	loading('show');
}

