function checkForMinor(){
	var majorAge = $('#ageFacet').val(); 
	var minorFlag = false;
	var policyObject = $('#policy_object').val();
	var removed = ""
	$("input[id*='_nomineeParty_removed']").each(function(){
		removed = $(this).val();
	});				
	$("input[id*='_nomineeParty_age']").each(function(){
		if (minorFlag) { return false; }
		var partySameAsCdId = $(this).attr("id").replace('nomineeParty_age','nomineePolicyPartyRole_partySameAsCd');
		
		var age = $(this).val();

		if (($('#'+partySameAsCdId).val() == 'OTHER' || $('#'+partySameAsCdId).val() == '') && age.length > 0 && parseInt(age) < parseInt(majorAge) && removed != "YES"){
			if ($('#'+partySameAsCdId.replace("partySameAsCd","nomineeRefGuid")).val() == $('#'+$(this).attr("id").replace("age","guid")).val()){
				minorFlag = true;
			}
		}
		else if ($('#'+partySameAsCdId).val() == 'SUPPLEMENTARY') {
			guid = $('#'+partySameAsCdId.replace("partySameAsCd","refGuid")).val();
			$.ajax({
				url: "/app/Policy/getPartyAge",
				data: "policyObject="+policyObject+"&guid="+guid,
				async: false,
				headers: {
					'Transition-Enabled': false
				},
				success: function(data) {
					var age = parseInt(data);
					if (parseInt(age) < parseInt(majorAge) && age != "" && removed != "YES"){
						minorFlag = true;
						return false;
					}	
				}
			});
		}
		else {
			roleCd = $('#'+partySameAsCdId).val();
			$.ajax({
				url: "/app/Policy/getPartyAge",
				data: "policyObject="+policyObject+"&roleCd="+roleCd,
				async: false,
				headers: {
					'Transition-Enabled': false
				},
				success: function(data) {
					var age = parseInt(data);
					if (parseInt(age) < parseInt(majorAge) && age != "" && removed != "YES") {
						minorFlag = true;
						return false;
					}	
				}
			});
		}
	});
	if(minorFlag) {
		$("#tab_nominee .tab-name>.ui-block-b").show();
	}
	else {
		$("#tab_nominee .tab-name>.ui-block-b").hide();
	}
}

