function getBankBranchLookups(micrNum_id, micrNum) {
	$.ajax({
     	url: "/app/Policy/getBankBranchLookups",
     	async: false,
     	data: "micrNum="+micrNum,
        headers: {
          'Transition-Enabled': false
        },
     	success: function(data) {
     		if (micrNum.toUpperCase() != "NOMICR") {
	     		if (data != "") {
					$("#"+micrNum_id.replace("micrNum","bankCd")).val(JSON.parse(data).bankName);
					$("#"+micrNum_id.replace("micrNum","bankBranch")).val(JSON.parse(data).bankBranch);
					$("#"+micrNum_id.replace("micrNum","branchName")).val(JSON.parse(data).branchName);
				}
   				setReadOnly($("#"+micrNum_id.replace("micrNum","bankCd")), true);
   				setReadOnly($("#"+micrNum_id.replace("micrNum","bankBranch")), true);
   				setReadOnly($("#"+micrNum_id.replace("micrNum","branchName")), true);
			}
       	}
  	});
}

function clearAndHideShowPaymentData(object,onLoad) {
	if (object != null){
		inputType = object.type
		if (inputType == "radio") {
		var id = object.id.substring(object.id,object.id.lastIndexOf("-"));
		}
		else{
			id = object.id
		}
		if(id.indexOf("renewal")>=0){
			id = id.replace("renewalPayment","renewalFinancialAccount");
		}
		else if(id.indexOf("refund")>=0){
			id = id.replace("refundPayment","refundFinancialAccount");
		}

		//Common fields in all three payment types
		var micrNum_id = id.replace("paymentMethodCd","micrNum");
		var bankCd_id = id.replace("paymentMethodCd","bankCd");
		var accountName_id = id.replace("paymentMethodCd","accountName");

		//Fields specific to Initial Payment
		var paymentSubTypeCd_id = id.replace("paymentMethodCd","paymentSubTypeCd");
		var bankBranch_id = id.replace("paymentMethodCd","bankBranch");
		var instrumentDt_id = id.replace("paymentMethodCd","instrumentDt");
		var inwardNum_id = id.replace("paymentMethodCd","inwardNum");
		var qrcode_id = id.replace("paymentMethodCd","qrcode");

		//Fields specific to Renewal & Refund Payment
		var branchName_id = id.replace("paymentMethodCd","branchName");
		var accountNum_id = id.replace("paymentMethodCd","accountNum");
		var cardExpiryYear_id = id.replace("paymentMethodCd","cardExpiryYear");
		var cardExpiryMnth_id = id.replace("paymentMethodCd","cardExpiryMnth");
		var cardTypeCd_id = id.replace("paymentMethodCd","cardTypeCd");
		
		if (object.value == "CHEQUE") {
			if(id.indexOf("renewal")>=0 || id.indexOf("refund")>=0){
				$('#'+micrNum_id).parents(".project-data").hide();
				$('#'+bankCd_id).parents(".project-data").hide();
				$('#'+accountName_id).parents(".project-data").hide();
				$('#'+branchName_id).parents(".project-data").hide();
				$('#'+accountNum_id).parents(".project-data").hide();
				$('#'+cardExpiryYear_id).parents(".project-data").hide();
				$('#'+cardExpiryMnth_id).parents(".project-data").hide();
				$('#'+cardTypeCd_id).parents(".project-data").hide();
				$('#'+qrcode_id).hide();
			}
			else {
				$('#'+paymentSubTypeCd_id).parents(".project-data").show();
				$('#'+micrNum_id).parents(".project-data").show();
				$('#'+bankCd_id).parents(".project-data").show();
				$('#'+bankBranch_id).parents(".project-data").show();
				$('#'+instrumentDt_id).parents(".project-data").show();
				$('#'+inwardNum_id).parents(".project-data").show();
				$('#'+accountName_id).parents(".project-data").show();
				$('#'+qrcode_id).hide();
			}
		}
		else if (object.value == "IPG") {
			$('#'+paymentSubTypeCd_id).parents(".project-data").show();
			$('#'+micrNum_id).parents(".project-data").hide();
			$('#'+bankCd_id).parents(".project-data").hide();
			$('#'+bankBranch_id).parents(".project-data").hide();
			$('#'+instrumentDt_id).parents(".project-data").hide();
			$('#'+inwardNum_id).parents(".project-data").show();
			$('#'+accountName_id).parents(".project-data").hide();
			$('#'+qrcode_id).hide();
		}
		else if (object.value == "ATM") {
			$('#'+paymentSubTypeCd_id).parents(".project-data").hide();
			$('#'+micrNum_id).parents(".project-data").hide();
			$('#'+bankCd_id).parents(".project-data").hide();
			$('#'+bankBranch_id).parents(".project-data").hide();
			$('#'+instrumentDt_id).parents(".project-data").hide();
			$('#'+inwardNum_id).parents(".project-data").show();
			$('#'+accountName_id).parents(".project-data").hide();
			$('#'+qrcode_id).hide();
		}
		else if (object.value == "creditCard") {
			$('#'+micrNum_id).parents(".project-data").hide();
			$('#'+bankCd_id).parents(".project-data").hide();
			$('#'+branchName_id).parents(".project-data").hide();
			$('#'+accountNum_id).parents(".project-data").show();
			$('#'+accountName_id).parents(".project-data").show();
			$('#'+cardExpiryYear_id).parents(".project-data").show();
			$('#'+cardExpiryMnth_id).parents(".project-data").show();
			$('#'+cardTypeCd_id).parents(".project-data").show();
			$('#'+qrcode_id).hide();
		}
		else if (object.value == "directDebit" || object.value == "directCredit") {
			$('#'+micrNum_id).parents(".project-data").show();
			$('#'+bankCd_id).parents(".project-data").show();
			$('#'+branchName_id).parents(".project-data").show();
			$('#'+accountNum_id).parents(".project-data").show();
			$('#'+accountName_id).parents(".project-data").show();
			$('#'+cardExpiryYear_id).parents(".project-data").hide();
			$('#'+cardExpiryMnth_id).parents(".project-data").hide();
			$('#'+cardTypeCd_id).parents(".project-data").hide();
			$('#'+qrcode_id).hide();
		}
		else if (object.value == "QRCODE") {
			$('#'+qrcode_id).show();
			$('#'+paymentSubTypeCd_id).parents(".project-data").hide();
			$('#'+micrNum_id).parents(".project-data").hide();
			$('#'+bankCd_id).parents(".project-data").hide();
			$('#'+bankBranch_id).parents(".project-data").hide();
			$('#'+instrumentDt_id).parents(".project-data").hide();
			$('#'+inwardNum_id).parents(".project-data").hide();
			$('#'+accountName_id).parents(".project-data").hide();
		}
		else {
			//Common fields in all three payment types
			$('#'+micrNum_id).parents(".project-data").hide();
			$('#'+bankCd_id).parents(".project-data").hide();
			$('#'+accountName_id).parents(".project-data").hide();

			//Fields specific to Initial Payment
			$('#'+paymentSubTypeCd_id).parents(".project-data").hide();
			$('#'+bankBranch_id).parents(".project-data").hide();
			$('#'+instrumentDt_id).parents(".project-data").hide();
			$('#'+inwardNum_id).parents(".project-data").hide();

			//Fields specific to Renewal & Refund Payment
			$('#'+branchName_id).parents(".project-data").hide();
			$('#'+accountNum_id).parents(".project-data").hide();
			$('#'+cardExpiryYear_id).parents(".project-data").hide();
			$('#'+cardExpiryMnth_id).parents(".project-data").hide();
			$('#'+cardTypeCd_id).parents(".project-data").hide();
			$('#'+qrcode_id).hide();
		}

		if(!onLoad){
			//Common fields in all three payment types
			$('#'+micrNum_id).val('');
			$('#'+bankCd_id).val('');
			if($('#'+bankCd_id).is("select")){
				$('#'+bankCd_id).val('').selectmenu().selectmenu('refresh');
			}
			$('#'+accountName_id).val('');

			//Fields specific to Initial Payment
			$('#'+paymentSubTypeCd_id).val('').selectmenu().selectmenu('refresh');
			$('#'+bankBranch_id).val('');
			if($('#'+bankBranch_id).is("select")){
				$('#'+bankBranch_id).val('').selectmenu().selectmenu('refresh');
			}
			$('#'+instrumentDt_id).val('');
			$('#'+inwardNum_id).val('');

			//Fields specific to Renewal & Refund Payment
			$('#'+branchName_id).val('');
			if($('#'+branchName_id).is("select")){
				$('#'+branchName_id).val('').selectmenu().selectmenu('refresh');
			}
			$('#'+accountNum_id).val('');
			$('#'+cardExpiryYear_id).val('').selectmenu().selectmenu('refresh');
			$('#'+cardExpiryMnth_id).val('').selectmenu().selectmenu('refresh');
			$('#'+cardTypeCd_id).val('').selectmenu().selectmenu('refresh');
		}
	}
}


