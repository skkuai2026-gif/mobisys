function getAge(birthDt, fieldId1, fieldId2, fieldId3) {
    $.ajax({
    	url: "/app/Policy/getAge",
     	data: {'birthDt': birthDt},
     	async: false,
        headers: {
          'Transition-Enabled': false
        },
     	success: function(data) {
     		var ageData = $.parseJSON(data);
            ageParts = ageData.split("|");
            $('#'+ fieldId1).val(ageParts[0]);
            age = ageParts[0];
            try {
            	$('#'+ fieldId2).val(ageParts[1]);
                $('#'+ fieldId3).val(ageParts[2]);
            } catch(e){}
          }
    });
 	return age;
}

function getDOB(age, fieldId) {
 	$.ajax({
   		url: "/app/Policy/getBirthDt",
   		data: {'age':age},
     	async: false,
        headers: {
          'Transition-Enabled': false
        },
   		success: function(data) {
   			$('#'+ fieldId).val(data);
   		}
 	});
}

