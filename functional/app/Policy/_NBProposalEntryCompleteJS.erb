function payerDependency(object, payerTypeCd, paymentType, onLoad) {
	if (payerTypeCd == "AGENT") {
		$('select#'+object+'_payerPartyRefGuid').attr('disabled','disabled');
		$('select#'+object+'_payerPartyRefGuid').selectmenu('disable');
		$('#'+paymentType+'Payer_removed').val("YES");
		$('#'+paymentType+'PaymentContainer').hide();
		$("#"+paymentType+"Payer").hide();
	}
	else if (payerTypeCd == "OTHER") {
		$('select#'+object+'_payerPartyRefGuid').attr('disabled','disabled');
		$('select#'+object+'_payerPartyRefGuid').selectmenu('disable');
		$('#'+paymentType+'Payer_removed').val("");
		$('#'+paymentType+'PaymentContainer').show();
		$("#"+paymentType+"Payer").show();
		$('#'+object+'Payer_home-permanent-business-bar li[name="officeAddressLi"]').hide();
		$("#"+object+"Payer_corporateDetail").hide();
		citizenshipCdObj = document.getElementById(object+"_citizenshipCd");
		if(citizenshipCdObj != null){
			hideShowOtherCitizenship(citizenshipCdObj);
		}
		if (paymentType == 'initial'){
			initialPayerPartyEmployment_occupationTypeCd_func();
			changePartyHolderAddressTab('homeAddressContainer', 'initialPayer');
			initialPayer_copyFromAddr1_func();
			initialPayer_copyFromAddr2_func();
			initialPayer_copyFromAddr3_func();
			$("#initialPayer_copyFromAddr1").closest(".project-data").hide();
			removeCopyFromAddrOptions("initialPayer");
		}
		else if(paymentType == 'renewal'){
			renewalPayerPartyEmployment_occupationTypeCd_func();
			changePartyHolderAddressTab('homeAddressContainer', 'renewalPayer');
			renewalPayer_copyFromAddr1_func();
			renewalPayer_copyFromAddr2_func();
			renewalPayer_copyFromAddr3_func();
			$("#renewalPayer_copyFromAddr1").closest(".project-data").hide();
			removeCopyFromAddrOptions("renewalPayer");
		}
	}
	else if (payerTypeCd == "SUPPLEMENTARY") {
		if (onLoad) {
			$('select#'+object+'_payerPartyRefGuid').removeAttr('disabled');
		}
		else {
			$('select#'+object+'_payerPartyRefGuid').selectmenu('enable');
		}
		$('input[name="'+object+'[payerPartyRefGuid]"]').attr('disabled','disabled');
		$('#'+paymentType+'Payer_removed').val("YES");
		$('#'+paymentType+'PaymentContainer').hide();
		$("#"+paymentType+"Payer").hide();
	}
	else{
		$('select#'+object+'_payerPartyRefGuid').removeAttr('disabled');
		$('select#'+object+'_payerPartyRefGuid').selectmenu('disable');
		$('#'+object+'_payerPartyRefGuid').attr('disabled','disabled');
		$('#'+paymentType+'Payer_removed').val("YES");
		$('#'+paymentType+'PaymentContainer').hide();
		$("#"+paymentType+"Payer").hide();
	}
}

