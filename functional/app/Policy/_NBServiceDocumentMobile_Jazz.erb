<div class="slider-wrapper-mobile display-none-desktop">
	<%= modelTagStart("documentContainer",@container) %>
	<input type="hidden" id="multiDocMode" name="multiDocMode" value="<%= @multiDocMode %>"/>
	<input type="hidden" id="ocrEnabledDocs" name="ocrEnabledDocs" value="<%= @documentHashMap.select{|x,y| x if y.to_s != ""}.keys.join(",") %>"/>
	<input type='hidden' name='sym_navbar' id='sym_navbar' value='<%= @navbarToBeLoaded %>'>
	<div class="slider slider-nav">
	<%
		idList = @navbarIds.split(',')
		labelList = @navbarLabels.split(',')
		idList.each_with_index do |id, index|
			id = @tabToBeLoaded + '-' + id
	%>
		<div onClick="javascript:submitTabForm('<%= @tabToBeLoaded %>',false,'<%= id %>');">
			<div class="owner-name active"><p><%= labelList[index].split("-")[1].scan(/(\A\w|(?<=\s)\w)/).flatten.join.upcase %></p></div>
			<div class="owner-full-name"><%= labelList[index].split("-")[1] %></div>
		</div>

	<%	end	%>
	</div>
	<!--Slider-->
	
	<!-- <div class="slider slider-single"> -->
		<!--Slide-->
		<div>
			<div class="collapse-panel" data-role='collapsible-set' data-iconpos="right" data-corners="false" data-theme="c">
				<!--section-->
				<% if @multiDocMode %>
					<% serviceDocumentCounter = 0 %>
					<% @categoryLabelHM.each do |index, docCategoryCd| %>
						<div data-role="collapsible">
							<h3 ><%= getLabelValue(docCategoryCd) %></h3>
							<%	count = 0
								@requirementsHM.each do |categoryCd, serviceDocuments| %>
								<div id="tab-<%= categoryCd %>-proof-panel">
									<% if index == categoryCd %>
										<% serviceDocuments.each do |documentCd, serviceDocument| 
											images = @imageHM[serviceDocument.uniqueKey]
											gridID = "grid_#{serviceDocumentCounter}_serviceDocument" %>
											<div class="documents-proof-details">
												<%= modelTagStart(gridID, serviceDocument, @container, serviceDocumentCounter) %>
												<div style="display: none;">
													<%= inputTag("isAutoGeneratedFl") %>
												</div>

												<%= inputTag("selected") %>
												<div class="documents-name"><%= getLabelValue(serviceDocument.docDescription) %></div>
												
												<div class="documents-upload-bg">
													<a href="javascript:takePicture('<%= gridID %>','document');" class="takepic" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/browse.png"></a>
													<a href="javascript:takePicture('<%= gridID %>','gallery');" class="takepic" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/gallery.png"></a>
													<a href="javascript:takePicture('<%= gridID %>');" class="takepic" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/1camera.png"></a>
												</div>
												<div class="documentDesc">
													<%= errorTag("selected")%>
												</div>
												<div name="<%=serviceDocument.uniqueKey %>" class="documents-upload-gallery">
													<% status = "" %>
													<% if $rhoconfig[:ocr_enabled].value.to_s == "YES"  && @documentHashMap.has_key?(documentCd) && @documentHashMap[documentCd].to_s != "" %>
														<div class="ocrF1">
															<%= inputTag("disableOcrFl")%> 
															<%= labelTag("disableOcrFl") %>
														</div>
													<% end %>
													<div class="excolo-slider sliderA">
														<% if images %>
															<% images.each_with_index do |imageDO,index| %>
																<% offlineFile = imageDO.OfflineFileList[0]%>
																<%
																if offlineFile.to_s != ""
																	imageURL = ""
																	if offlineFile.fileLocation.include?(".pdf")
																		imageURL = "/public/jazz/images/pdf_512.png"
																	elsif offlineFile.fileLocation.include?(".gif")
																		imageURL = "/public/jazz/images/gif_512.png"
																	elsif offlineFile.fileLocation.include?(".doc")
																		imageURL = "/public/jazz/images/doc_512.png"
																	elsif offlineFile.fileLocation.include?(".tiff")
																		imageURL = "/public/jazz/images/tiff_512.png"
																	elsif offlineFile.fileLocation.include?(".xls")
																		imageURL = "/public/jazz/images/xls_512.png"
																	else
																		if offlineFile.fileEncrypted == 'YES'
																			decodedContent = MobiSys::Encryption.decryptContent("#{offlineFile.fileContents}|#{offlineFile.encryptionIv}")
																			imageURL = 'data:image/jpeg;base64,'+MobiSys::Encryption.encodeContents(decodedContent)
																		else
																			imageURL = 'data:image/jpeg;base64,'+offlineFile.fileContents
																		end
																	end
																%>
																<div class="proof-img" name="<%=offlineFile.parentKey %>">
																	<a href="#full-image" data-rel="popup" data-position-to="window" data-transition="pop" for="<%= imageURL %>" data-imagevalue="<%=offlineFile.parentKey %>">
																		<img src="<%= imageURL %>" class="imgThumbnail" alt="">
																	</a>
																	<% if imageDO.uploadStatus.to_s == '' %>
																		<a style="position:absolute;top:0;z-index:99;right:0;" id="deleteAnchor<%=offlineFile.parentKey%>" href="javascript:deletePopup('<%=offlineFile.parentKey%>','DELETE_CONFIRMATION','image')
																" data-servicedocGuid="<%=serviceDocument.uniqueKey%>"><img src="/public/jazz/images/del.jpg" alt="Delete" title="Delete"></a>
																	<% end %>
																	<% status = imageDO.uploadStatus.to_s %>
																</div>
																<% end %>
															<% end %>
														<% end %>
													</div>
													<input type ="hidden" id = <%="grid_#{count}_serviceDocument_uploadStatus" %> value ="<%= status%>"/>
													<% count= count+1 %>
													<div style='display: none;'>
														<%= inputTag("referenceObject") %>
														<%= inputTag("docCategoryTypeCd") %>
														<%= inputTag("docCategoryCd") %>
														<%= inputTag("partyGuid") %>
														<%= inputTag("receivedDt") %>
														<%= inputTag("acceptanceStatusCd") %>
														<%= inputTag("documentCd") %>
														<%= inputTag("imageCount") %>
													</div>
													<% serviceDocumentCounter = serviceDocumentCounter + 1 %>
												</div>
												<% modelTagEnd %>
											</div>
										<% end	%>
									<% end	%>
								</div>
								<% end	%>
							
						</div>
						<!--/section-->
						<div class="clearfix"></div>
					<% end %>
					<div style='display: none;'>
						<%= inputTag("entityGuid") %>
						<%= inputTag("entityTypeCd") %>
						<%= inputTag("policyGuid") %>
					</div>
				<% else %>
					<% serviceDocumentCounter = 0 %>
					<% @categoryLabelHM.each do |categoryCd, docCategoryCd| %>
						<div data-role="collapsible">
							<h3 ><%= getLabelValue(docCategoryCd) %></h3>
							<%	count = 0
								@requirementsHM.each_with_index do |(key, serviceDocument), index|  %>
									<% if categoryCd == key %>
								<div id="tab-<%= key %>-proof-panel">
											<% images = @imageHM[serviceDocument.uniqueKey]
											gridID = "grid_#{index}_serviceDocument" %>
											<div class="documents-proof-details">
												<%= modelTagStart(gridID, serviceDocument, @container, index) %>
												<div style="display: none;">
													<%= inputTag("isAutoGeneratedFl") %>
												</div>
												
												<div class="project-data-full">
													<div class="row-details">
														<%= labelTag("documentCd") %>
														<p class="col-right docc">
															<%= inputTag("documentCd") %>
														</p>
															<%= errorTag("selected") %>
													</div>
												</div>
											
												<div class="documents-upload-bg">
													<a href="javascript:takePicture('<%= gridID %>','document');" class="takepic" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/browse.png"></a>
													<a href="javascript:takePicture('<%= gridID %>','gallery');" class="takepic" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/gallery.png"></a>
													<a href="javascript:takePicture('<%= gridID %>');" class="takepic" id="capture<%=serviceDocument.uniqueKey%>" data-param ="<%=serviceDocument.object%>"><img src="/public/jazz/images/1camera.png"></a>
												</div>
												<div class="documentDesc">
													<%= errorTag("selected")%>
												</div>
												<div name="<%=serviceDocument.uniqueKey %>" class="documents-upload-gallery">
													<% status = "" %>
													<div class="excolo-slider sliderA">
														<% if images %>
															<% images.each_with_index do |imageDO,index| %>
																<% offlineFile = imageDO.OfflineFileList[0]%>
																<%
																if offlineFile.to_s != "" 
																	imageURL = ""
																	if offlineFile.fileLocation.include?(".pdf")
																		imageURL = "/public/jazz/images/pdf_512.png"
																	elsif offlineFile.fileLocation.include?(".gif")
																		imageURL = "/public/jazz/images/gif_512.png"
																	elsif offlineFile.fileLocation.include?(".doc")
																		imageURL = "/public/jazz/images/doc_512.png"
																	elsif offlineFile.fileLocation.include?(".tiff")
																		imageURL = "/public/jazz/images/tiff_512.png"
																	elsif offlineFile.fileLocation.include?(".xls")
																		imageURL = "/public/jazz/images/xls_512.png"
																	else
																		if offlineFile.fileEncrypted == 'YES'
																			decodedContent = MobiSys::Encryption.decryptContent("#{offlineFile.fileContents}|#{offlineFile.encryptionIv}")
																			imageURL = 'data:image/jpeg;base64,'+MobiSys::Encryption.encodeContents(decodedContent)
																		else
																			imageURL = 'data:image/jpeg;base64,'+offlineFile.fileContents
																		end
																	end
																	%>
																	<div class="proof-img" name="<%=offlineFile.parentKey %>">
																		<a href="#full-image" data-rel="popup" data-position-to="window" data-transition="pop" for="<%= imageURL %>" data-imagevalue="<%=offlineFile.parentKey %>">
																			<img src="<%= imageURL %>" class="imgThumbnail" alt="">
																		</a>
																		<% if imageDO.uploadStatus.to_s == '' %>
																			<a style="position:absolute;top:0;z-index:99;right:0;" id="deleteAnchor<%=offlineFile.parentKey%>" href="javascript:deletePopup('<%=offlineFile.parentKey%>','DELETE_CONFIRMATION','image')
																	" data-servicedocGuid="<%=serviceDocument.uniqueKey%>"><img src="/public/jazz/images/del.jpg" alt="Delete" title="Delete"></a>
																		<% end %>
																		<% status = imageDO.uploadStatus.to_s %>
																	</div>
																<% end %>
															<% end %>
														<% end %>
													</div>
													<input type ="hidden" id = <%="grid_#{count}_serviceDocument_uploadStatus" %> value ="<%= status%>"/>
													<% count= count+1 %>
													<div style='display: none;'>
														<%= inputTag("referenceObject") %>
														<%= inputTag("docCategoryTypeCd") %>
														<%= inputTag("docCategoryCd") %>
														<%= inputTag("partyGuid") %>
														<%= inputTag("receivedDt") %>
														<%= inputTag("acceptanceStatusCd") %>
														<%= inputTag("documentCd") %>
														<%= inputTag("imageCount") %>
													</div>
													<% serviceDocumentCounter = serviceDocumentCounter + 1 %>
												</div>
												<% modelTagEnd %>
											</div>
									<% end	%>
								<% end	%>
								</div>
							
						</div>
						<!--/section-->
						<div class="clearfix"></div>
					<% end %>
					<div style='display: none;'>
						<%= inputTag("entityGuid") %>
						<%= inputTag("entityTypeCd") %>
						<%= inputTag("policyGuid") %>
					</div>
				<% end %>
			</div>
		</div>
	<!-- </div> -->
	<!--/Slider-->
	<% modelTagEnd %>
</div>

<div data-role="popup" id="full-image" data-theme="a" class="ui-corner-all popup-wrapper">
	<div class="popup-close-cust">
		<a href="#" data-rel="back" class="icon-close"></a>
	</div>
	<div class="close-before-save">
		<img src="" alt="">
	</div>
</div>