<% if @tabToBeLoaded == "tab_basic" %>
	<%= tabTagStart("tab_basic") %>
		<%= navbarTagStart(@basicNavbarIds,@basicNavbarLabels) %>
			<% if @navbarToBeLoaded == 'tab_basic-basicDetails' %>
				<%= render :partial => "NBProposalBasic_Jazz" %>
				<%= render :partial => "NBProposalCommPreference_Jazz" %>
			<% else %>
				<%= render :partial => "NBProposalAgent_Jazz" %>
			<% end %>
		<%= navbarTagEnd %>
	<%= tabTagEnd %>
<% end %>
