<script type ="text/javascript">
function getInwardBankBranchLookups(bankCd, paymentObj, micrNum) {
	if (bankCd != "") {
		var selectID = paymentObj+"[bankBranch]";
		var spanID = paymentObj+"[branchLookup]";
		var ajaxData = "bankCd="+bankCd
	}
	else if (micrNum != "") {
		var ajaxData = "micrNum="+micrNum
	}

	$.ajax({
     	url: "/app/Policy/getBankBranchLookups",
     	async: false,
     	data: ajaxData,
        headers: {
          'Transition-Enabled': false
        },
     	success: function(data) {
     		if (bankCd != "") {
	     		if (data != "") {
		           	create = '<select id="'+selectID+'" name="'+selectID+'">';    
		           	create += data;
		           	create += '</select>';
	           	}
	           	$('span[name="'+ spanID +'"]').html(create);
	           	$('span[name="'+ spanID +'"]').trigger('create');
           	}
			else if (micrNum.toUpperCase() != "NOMICR") {
	     		if (data != "") {
					$("input[name='"+paymentObj+"[bankCd]']").val(JSON.parse(data).bankName);
					$("input[name='"+paymentObj+"[bankBranch]']").val(JSON.parse(data).bankBranch);
				}
   				setReadOnly($("input[name='"+paymentObj+"[bankCd]']"), true);
   				setReadOnly($("input[name='"+paymentObj+"[bankBranch]']"), true);
			}
       	}
  	});
}


