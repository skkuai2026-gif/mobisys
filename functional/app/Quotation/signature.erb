<div data-role="page">
    <link rel="stylesheet" href="/public/css/Eapp/c2l_EAPP.css">
    <script type="text/javascript" src="/public/js/Eapp/c2l_EAPP.js"></script>
    <script type="text/javascript" src="/public/jquerysimpledialog/jquery.mobile.simpledialog2.min.js"></script>
    <script type="text/javascript" src="/public/js/format.min.js"></script>
    <script type="text/javascript" src="/public/js/jquery.fancybox.pack.js"></script>
    <link rel="stylesheet" href="/public/css/jquery.fancybox.css" type="text/css" media="screen" />
    <script src="/public/js/jquery.signaturepad.js" type="text/javascript"></script>
    <script src="/public/js/json2.min.js" type="text/javascript"></script>
    <link rel="stylesheet" href="/public/css/jquery.signaturepad.css"/>

    <style type="text/css">
    .sigNav {
        width: 751px;
    }
    </style>
  
    <div data-role="header" id="header" data-position="inline">
        <a href="<%= url_for :action => :illustration1, :id=>@quotation.object %>" rel="external" id = "back" name="back" data-direction="reverse" data-role="none">
            <img src="/public/images/SalesIllustration/icon_BackArrow-Red.png">
        </a>
        <h1 style="margin:0 30%;"><%= getLabelValue('signature')%></h1>
       <!-- <div class="ui-btn-right"> 
          <div class="headerRightButtons">
            <a href="#" name="save"  style="min-width:100px;">
              <img src="/public/images/Eapp/Save.png" height="40px" width="40px">
            </a>
          </div>
        </div> -->
    </div>
    <div data-role="content" id="email">
        <div class="illustrationdisplay">
            <div class="legend">
                <label class="strongLabel"></label>
            </div>
        
            <div class="panelContent">
                <form method="POST" name="signatureForm" id="signatureForm" action="<%= url_for :action => :saveSignature %>">
                    <%= renderObject(@quotation) %>
                    <div class="ui-grid-b">
                        <div class="ui-block-a">
                            <%= renderSignatureInlineField('signature', @quotation, returnAppHeightWeight('screen_width', 0.55), returnAppHeightWeight('screen_height', 0.30)) %>
                        </div>
                        <div class="ui-block-b"></div>
                        <div class="ui-block-c"></div>
                    </div>
                    <%if @agentSignatureCaptureFlag %>
                        <%= renderHiddenField('agentSignatureCaptureFlag',@agentSignatureCaptureFlag,'agentSignatureCaptureFlag')%>
                        <div class="ui-grid-b">
                            <div class="ui-block-a">
                                <%= renderSignatureInlineField('agentSignature', @quotation, returnAppHeightWeight('screen_width', 0.55), returnAppHeightWeight('screen_height', 0.30)) %>
                            </div>
                            <div class="ui-block-b"></div>
                            <div class="ui-block-c"></div>
                        </div>
                    <% end %>

                    <div class="ui-grid-b">
                        <div class="ui-block-a"><a href="#" name="done" data-role="button" data-theme="a" onclick="submitForm();">
                            <%= getLabelValue('ACCEPT')%>
                            </a></div>
                        <div class="ui-block-b"></div>
                        <div class="ui-block-c"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
 </div>

<script type="text/javascript">
    function submitForm()
    {
        $.ajax({                                    
            url: "/app/Quotation/saveSignature",
            method: 'POST',
            data: $('#signatureForm').serialize(),
            success: function() {
                //alert("Save Success");
            }
        });
    } 

    $(document).ready(function () {
        $('.sigPad').signaturePad({drawOnly:true});
        $("a#inline").fancybox({
            autoSize : false,
            height : '80%',
            width : '75%'
        });

        $("a[name='save']").click( function() { 
            submitForm();
        });
    });
</script>
