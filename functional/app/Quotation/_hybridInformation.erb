<div name = "hybridinformationdiv">
  <%= renderLegend('hybridInformation','HYBRIDINFORMATION') %>      
  <div class="illustrationdisplay" name ='hybridInformation'>  
    <div data-role="fieldcontain">
      <%= renderLabel('premiumGuarantees','PREMIUMGUARANTEES', nil, @baseProduct)   %>
      <%= renderCountField('premiumGuarantees', @baseProduct.premiumGuarantees,'Premium Guarantees', @baseProduct) %>
    </div>
      
    <fieldset class="ui-grid-c">
      <strong>
        <div class="ui-block-a"> </div>
        <div class="ui-block-b"> <%= renderLabel('premiumSplit','PREMIUMSPLIT','riderHeader') %> </div>
        <div class="ui-block-c"> <%= renderLabel('sumAssured','baseSumAssured','riderHeader') %> </div>
        <div class="ui-block-d"> <%= renderLabel('premium','modalPremium','riderHeader') %> </div>
      </strong>
    </fieldset>
      
    <% @partialProducts.each do |quotationProduct| %>
      
      <%= renderObject(quotationProduct, @quotation) %>
      <%= renderHiddenField('productId', quotationProduct.productId, 'Product Id', quotationProduct) %>
      <%= renderHiddenField('productTypeCd', quotationProduct.productTypeCd, 'productTypeCd', quotationProduct) %>
      <%= renderHiddenField('selected', quotationProduct.selected, 'Selected', quotationProduct) %>
      <%= renderHiddenField('planCode', quotationProduct.planCode, 'planCode', quotationProduct) %>
      
      <fieldset class="ui-grid-c">
        <div class="ui-block-a collateraldiv"> 
          <ul data-role="listview" >
            <li class="collateral">
              <a href="#" name="<%=quotationProduct.planCode%>_COLLATERAL">
                <script>
                  $('a[name="<%=quotationProduct.planCode%>_COLLATERAL"]').click(function () {  
                    $.get("/app/Collateral/showProductCollateral?planCode=<%= quotationProduct.planCode %>",function(data) {});
                  }); 
                </script>                      
                <%= renderLabel('planCode',quotationProduct.planCode+"LONG", nil, quotationProduct) %>                      
              </a>
              
            </li>
          </ul>
        </div>
  
        <div class="ui-block-b">  
          <% if quotationProduct.premiumSplit != nil %>
            <%= renderCountField('premiumSplit', quotationProduct.premiumSplit, 'Premium Split', quotationProduct) %>
          <% end %>
        </div>

        <div class="ui-block-c"> 
          <%= renderPreciseAmountField('baseSumAssured', quotationProduct.baseSumAssured, 'Sum Assured', quotationProduct) %> 
            <script>
              function updateHybridSA<%=quotationProduct.planCode%>(sa)
                {
                  $('input[name="<%= getObjectMapping(quotationProduct) %>[baseSumAssured]"]').val(sa);
                }
            </script>
        </div>

        <div class="ui-block-d"> 
          <%= renderPreciseAmountField('modalPremium', quotationProduct.modalPremium, 'Premium', quotationProduct) %> 
          <script>
            function updateHybridPremium<%=quotationProduct.planCode%>(premium)
            {
              $('input[name="<%= getObjectMapping(quotationProduct) %>[modalPremium]"]').val(premium);
            }
          </script>
        </div>
      </fieldset>
      <script>
        setReadOnly($("input[name='<%=getObjectMapping(quotationProduct) %>[baseSumAssured]']"), true);
        setReadOnly($("input[name='<%=getObjectMapping(quotationProduct) %>[modalPremium]']"), true);
      </script>
    <% end %>
  </div>
</div>
<script type="text/javascript">
$(document).ready(function(){
  $('input[name="<%= getObjectMapping(@baseProduct)%>[premiumGuarantees]"]').blur( function(){
      if (isNaN(this.value)) {
          $(this).val('');
      }
      else {
          if(!$(this).hasClass("readonly")) {
              calculatePremium(this.name.replace("premiumGuarantees","baseSumAssured"));
          }
      }
  });

  $('input[name*="[premiumSplit]"]').blur( function(){        
      if (isNaN(this.value)) {
          $(this).val('');
      }
      else {
          if(!$(this).hasClass("readonly")) {
              calculatePremium('<%= getObjectMapping(@baseProduct)%>[baseSumAssured]');
          }
      }
  });
});
</script>