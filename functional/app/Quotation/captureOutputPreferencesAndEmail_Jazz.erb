<%= headerTag('OUTPUTPREFERENCES', '', "","#{url_for :action => :show, :id => @quotation.object}") %>
<div data-role="main" class="ui-content">
    <div class="main-content-wrapper main-content-full">
        <%= formTagStart(@formname,@formaction) %>
            <div class="project-content-bg">
                <div class="div-with-border no-padding-bottom preferences-content">
                    <%= panelTagStart %>
                        <%= subPanelTagStart(@header_field, false,"",false) %>
                            <div class="content-fullform">  
                                <% if @view_email == "email" %>
                                    <%= modelTagStart("EMAIL", @emailRequest) %>
                                    <%= layoutFieldTag('toEmail,ccEmail,message', 1) %>
                                        <div style="display: none">
                                            <%= inputTag("entityGuid") %>
                                            <%= inputTag("entityNumber") %>
                                            <%= inputTag("entityName") %>
                                            <%= inputTag("outputPrefEntityGuid") %>
                                        </div>
                                    <% modelTagEnd %>
                                <% end %>

                                <%= modelTagStart("OUTPUTPREFERENCES", @outputPref) %>
                                    <% if @render_c_o_p %>
                                        <%= layoutFieldTag('languageCd,field1,field2,field3,field4,field5', 1) %>
                                    <%else%>
                                        <div style="display: none">
                                            <%= inputTag("languageCd") %>
                                            <%= inputTag("field1") %>
                                            <%= inputTag("field2") %>
                                            <%= inputTag("field3") %>
                                            <%= inputTag("field4") %>
                                            <%= inputTag("field5") %>
                                        </div>
                                    <% end %>
                                <% modelTagEnd %>
                                <%= modelTagStart("QUOTATIONOBJECT", @quotation) %>
                                <% modelTagEnd %>
                            </div>
                        <%= subPanelTagEnd %>
                    <%= panelTagEnd %>
                </div>
            </div>
        <%= formTagEnd() %>
    </div>
    <div class="footer-bg">
        <%= @submit_anchor_tag %>
    </div>
</div>
<script type="text/javascript" charset="utf-8" src="/app/Quotation/captureOutputPreferencesAndEmail_Jazz.js"></script>