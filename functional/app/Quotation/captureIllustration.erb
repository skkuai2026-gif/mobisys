        occupationClass = $('select[name="<%=getObjectMapping(@quotation)%>[occupationCd]"]').val();
        planType = $('select[name="<%=getObjectMapping(@baseProduct)%>[productFamilyCd]"]').val();
        planCode = $('select[name="<%=getObjectMapping(@baseProduct)%>[planCode]"]').val();
        
        //alert("planType:"+planType+";planCode:"+planCode);
        
