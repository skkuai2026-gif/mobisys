                            rider = riderObjects[i].split("|");                            
                            if(rider.length > 0 && rider[0] != "" && rider[0] != "RCCADD" && rider[0] != "RCCAI" && rider[0] != "OPD" /*&& rider[0] != "PBC"*/)
