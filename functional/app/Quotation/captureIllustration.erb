      }
      
      function disableDependantRider(rider){
        clickRiderObject = $('fieldset[name="rider_'+rider+'"] > div > div > input[name*="selected"]');
        if(clickRiderObject.is(':checked')){
          clickRiderObject.click();
          riderObject = $('fieldset[name="rider_'+rider+'"] > div > div > input[name*="selected"]');
          labelName = riderObject.attr("name");
          if ($("label[for='"+labelName+"']").hasClass("ui-checkbox-on")){
            $("label[for='"+labelName+"']").removeClass("ui-checkbox-on");
            $("label[for='"+labelName+"']").addClass("ui-checkbox-off");
          }
          
          $("label[for='"+labelName+"']").children("span").children("span").each(function(i){
            if($(this).hasClass("ui-icon-checkbox-on")){
              $(this).removeClass("ui-icon-checkbox-on");
              $(this).addClass("ui-icon-checkbox-off");
            }                            
          });
        }
        
        $('fieldset[name="rider_'+rider+'"]').hide();
        
      }

      function fetchDependantSAPR(rider, maxSA){
        riderObject = $('fieldset[name="rider_'+rider+'"] > div > div > input[name*="selected"]');
        sumAssured = 0;
        if (riderObject.is(':checked'))
        {
          labelName = riderObject.attr("name");
          
          sumAssuredName = labelName.replace("selected","baseSumAssured");
          sumAssured = $("input[name='"+sumAssuredName+"']").val();
        }
       
        if (sumAssured > maxSA)
        {
          sumAssured = maxSA
        }
        return sumAssured;
      }

      function updateWOPSA(annualPremium){        
        riderObject = $('fieldset[name="rider_PB"] > div > input[name*="baseSumAssured"]');
        riderObject.val(annualPremium);
        riderObject.each( function(i){
          calculatePremium(this.name);  
        });
                
      }

      function updatePBCPremium(){
        riderObject = $('fieldset[name="rider_PBC"] > div > input[name*="baseSumAssured"]');
        if(riderObject.val() != "")
        {
          riderObject.blur();
        }
      }
      
      function submitForm(){
        $("a[name='save']").focus();
        if(checkBasicDetails() && checkRecordExists())
        {
          //$.mobile.showPageLoadingMsg();
          // # enable the disabled field so that value gets submitted. Field is disabled for juvenile cases
          //$("select[name='<%=getObjectMapping(@quotation)%>[occupationCd]']").selectmenu('enable');
          
          // # submit form
          document.quotationForm.submit();          
        }  
      }
      
      function checkBasicDetails(){
        returnValue = true;
        firstname = $("input[name='<%=getObjectMapping(@quotation)%>[firstname]']").val();
        salesIllustrationCd = $("input[name='<%=getObjectMapping(@quotation)%>[quotationRefNum]']").val();
        if ( firstname == ""){
          showDialog("", "<%= getLabelValue('MANDATORYFORSAVE')%>", 'warning', 0, 'capture');
          returnValue = false;
        }
        alert("Returning from checkBasicDetails with " + returnValue);
        return returnValue;
      }
        
      function occupationCdChanged(){
        age = $("input[name='<%= getObjectMapping(@quotation)%>[age]']").val();
        occupationCd = $("select[name='<%= getObjectMapping(@quotation)%>[occupationCd]']").val();
        //alert("changed, age:"+age+" occ:"+occupationCd);
        if( age != "" && age <= 15 && occupationCd != JUVENILEOCCUPATIONCLASS)
        {
          $("select[name='<%= getObjectMapping(@quotation)%>[occupationCd]']").val(JUVENILEOCCUPATIONCLASS).change();
        }
        updateAllProducts(true);
      }

      function checkRecordExists(){
        returnValue = true;        
        salesIllustrationCd = $("input[name='<%=getObjectMapping(@quotation)%>[quotationRefNum]']").val();
        guid = $("input[name='<%=getObjectMapping(@quotation)%>[guid]']").val();
        if ( salesIllustrationCd != ""){
          
          $.ajax({
                    url: "/app/Quotation/checkQuotationRefNum",
                    data: {'quotationRefNum': salesIllustrationCd, 'guid': guid},
                    success: function(data) {
                      data = data.replace("<div>","");
                      data = data.replace("</div>","");
                      try{
                        if (data == "ALLOWSAVE")
                        {
                          returnValue = true;
                        }
                        else
                        {
                          returnValue = false;
                        }
                      }catch(e){alert(e);}
                    },
                    async: false                    
                 });          
        }
        
        if(!returnValue){
          showDialog("", "<%= getLabelValue('OVERWRITE')%>", 'error', 0, 'capture');          
          returnValue = false;
        }
        
        return returnValue;
      }

      function searchFunds(searchParam)
      {
        basePlanCode = $("select[name='<%=getObjectMapping(@baseProduct)%>[planCode]']").val();
        $.ajax({
                  url: "/app/Quotation/searchFunds",
                  data: {'basePlanCode': basePlanCode, 'search': searchParam},
                  success: function(data) {
                    $('div[name="fundSearch"]').html(data);                    

                  },
                  async: false                    
               });          
        
      }
      
      $('img[name*="collapse"]').click( function(){
        divName = this.name.replace("collapse_","");
        val = $('input[name="state_'+divName+'"]').val();
        // # replace image
        if(val == "+")
        {
          $('input[name="state_'+divName+'"]').val('-');
          $('img[name="collapse_'+divName+'"]').attr("src","/public/images/SalesIllustration/less.jpg");
          $('div[name="'+divName+'"]').show();          
        }
        else // # val == "-"
        {
          $('input[name="state_'+divName+'"]').val('+');
          $('img[name="collapse_'+divName+'"]').attr("src","/public/images/SalesIllustration/more.jpg");
          $('div[name="'+divName+'"]').hide();
        }
            
            
      });

      function addfund(fundCode){
        quotationProductObjectName = '<%= getObjectMapping(@baseProduct) %>';
        $.ajax({
      
                  url: "/app/Quotation/addFund",
                  data: {'fundCode': fundCode, 'quotationProductObject': '<%= @baseProduct.object.to_s %>', 'fundObjects': fundCount, 'quotationProductObjectName':quotationProductObjectName},
                  success: function(data) {

                    $('div[name="fundList"]').append("<div name='"+fundCode+"'> </div>");
                    data = data.replace("<div>||","");
                    data = data.replace("||</div>","");
                    
                    $('div[name="'+fundCode+'"]').html(data);
                    $('div[name="'+fundCode+'"]').trigger('create');
                    
                    fundCount = $('span[name="fundCount"]').html();
                    $('span[name="fundCount"]').html( parseInt(fundCount) + 1 );
                    fundCount ++;
                  },
                  async: false                    
               });
      }
      
      function removeFund(fundCode){
        $('div[name="'+fundCode+'"]').remove();
        fundCount = $('span[name="fundCount"]').html();
        $('span[name="fundCount"]').html( parseInt(fundCount) - 1 );

        allocationPerc = 0.0;
        $('input[name*="allocationPerc"]').each(function(i){
          allocationPerc += parseInt($(this).val());
        });
        
        $('span[name="allocationPerc"]').html( allocationPerc+'%' );
      }
      
      $('input[name*="allocationPerc"]').change(function(){
        
        allocationPerc = 0.0;
        $('input[name*="allocationPerc"]').each(function(i){
          allocationPerc += parseInt($(this).val());
        });
        $('span[name="allocationPerc"]').html( allocationPerc+'%' );
        
      });

      function renderLegends(){
        $('input[name*="state_"]').each(function(i){
          if ( $(this).val() == "+")
          {
            divName = this.name.replace("state_","");
            $('div[name="'+divName+'"]').hide();
          }
        });
      }

      function addTopup(){
        quotationProductObjectName = '<%= getObjectMapping(@baseProduct) %>';
        $.ajax({
                url: "/app/Quotation/addTopup",
                data: {'quotationProductObject': '<%= @baseProduct.object.to_s %>', 'topupObjects': topupCount, 'quotationProductObjectName':quotationProductObjectName},
                success: function(data) {
                  topupCount = topupCount + 1;
                  newHTML = $('div[name="topupList"]').html() + data 
                  $('div[name="topupList"]').html(newHTML);
                  $('div[name="topupList"]').trigger('create');                  
                }
              });
        
      }

      function removeTopup(topupName){
        $('div[name="'+topupName+'"]').remove();
      }

      function updatePDFAmount(option){
        if (option == "YES")
        {
          // calculate PDF amount
          annualPremium = $("input[name='<%= getObjectMapping(@baseProduct)%>[baseAnnualPremium]']").val();
          ppTerm = $("select[name='<%= getObjectMapping(@baseProduct)%>[premiumPayingTerm]']").val();
          planCode = $("select[name='<%= getObjectMapping(@baseProduct)%>[planCode]']").val();
          $.ajax({
                  url: "/app/Quotation/computePDFAmount",
                  data: {'annualPremium': annualPremium, 'ppTerm': ppTerm, 'planCode':planCode},
                  success: function(data) {
                    data = data.replace("<div>","");
                    data = data.replace("</div>","");
                    $("input[name='<%= getObjectMapping(@baseProduct)%>[pdfAmount]']").val(data);                    
                  }
                });          
        }
        else
        {
          // reset PDF amount
          $("input[name='<%= getObjectMapping(@baseProduct)%>[pdfAmount]']").val(0);
        }
      }
</script>  
</div>
