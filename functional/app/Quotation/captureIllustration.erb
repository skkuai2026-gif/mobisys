                                $("label[for='"+labelName+"']").addClass("ui-checkbox-off");
                              }
                              
                              $("label[for='"+labelName+"']").children("span").children("span").each(function(i){
                                if($(this).hasClass("ui-icon-checkbox-on")){
                                  $(this).removeClass("ui-icon-checkbox-on");
                                  $(this).addClass("ui-icon-checkbox-off");
                                }                            
                              });
                              
                            }
                            
                          });
                        }

