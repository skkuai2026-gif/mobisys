      function showHideAgeSections(age, recurring)
      {
        planCode = $('select[name="<%=getObjectMapping(@baseProduct)%>[planCode]"]').val();
        if (age == "")
        {
          hideMonthsDays();
          hidePayor();            
        }
        else
        {
          if (age <= 15){
            if(age == 0){
              showMonthsDays();
            }
            else{
              hideMonthsDays();
            }
            if (planCode.indexOf("SIS") < 0)
            {
              hidePayor();
            }
            else
            {
              showPayor(recurring);
            }
          }
          else{
            hideMonthsDays();
            if (planCode.indexOf("SIS") < 0)
            {
              hidePayor();
            }
            else
            {
              showPayor(recurring);
            }
          }
        }        
  
      }
      
      function updateAllProducts(reset){
        //alert("updateAllProducts:"+reset);
        
        if(reset)
        {
          $('input[name*="[baseSumAssured]"]').val("");
          $('input[name*="[baseAnnualPremium]"]').val("");
          $('input[name*="[modalPremium]"]').val("");
