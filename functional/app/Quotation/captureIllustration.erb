        else
        {
          setReadOnly($("input[name='Quotation[QuotationProduct][0][baseSumAssured]']"), false);
          setReadOnly($("input[name='Quotation[QuotationProduct][0][baseAnnualPremium]']"), true);
          setReadOnly($("input[name='Quotation[QuotationProduct][0][modalPremium]']"), true);
          setReadOnly($("input[name='Quotation[QuotationProduct][1][baseAnnualPremium]']"), true);
          setReadOnly($("input[name='Quotation[QuotationProduct][1][modalPremium]']"), true);
        }
        modalPremiumsList = new Array();
        updatePAProducts(reset);
        updateProducts(reset);        
