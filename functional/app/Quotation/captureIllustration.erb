<!-- script start -->
<script type="text/javascript">

      $('input[name="<%= getObjectMapping(@baseProduct)%>[premiumGuarantees]"]').blur( function(){
        if (isNaN(this.value))      
        {
          $(this).val('');
        }
        else{
          if(!$(this).hasClass("readonly"))
          {
            calculatePremium(this.name.replace("premiumGuarantees","baseSumAssured"));
          }
        }
      });

      $('input[name*="[premiumSplit]"]').blur( function(){        
        if (isNaN(this.value))      
        {
          $(this).val('');
        }
        else{
          if(!$(this).hasClass("readonly"))
          {
            calculatePremium('<%= getObjectMapping(@baseProduct)%>[baseSumAssured]');
          }
        }
      });
                          
      
      $(document).focus(function() {
        setTimeout("onFocus()", 100);
      });
      
      function onFocus(){        
        val = $('input[name="<%=getObjectMapping(@quotation)%>[age]"]').val();
        planCode = $('select[name="<%=getObjectMapping(@baseProduct)%>[planCode]"]').val();
          showHideAgeSections(val, false);
        if (val != "" && $('input[name="<%=getObjectMapping(@quotation)%>[dob]"]').val() == "")
        {
          getDOB(val, '<%=getObjectMapping(@quotation)%>[dob]');
        }
        
        
        updateAllProducts(false);
        renderRiders();
        updatePremiums();
        renderLegends();
      }
      
      var oldAgeValue = "";
      $('input[name="<%=getObjectMapping(@quotation)%>[age]"]').focus( function(){
        oldAgeValue = this.value;
      });
      
      $('input[name="<%=getObjectMapping(@quotation)%>[age]"]').blur( function(){
        if (oldAgeValue != this.value)
        {          
          if ( isNaN(this.value) || this.value < 0)      
          {
            $(this).val('');
          }
          else
          {
            showHideAgeSections(this.value, true);                
            getDOB(this.value, '<%=getObjectMapping(@quotation)%>[dob]');
            
            updateAllProducts(true);
          }
