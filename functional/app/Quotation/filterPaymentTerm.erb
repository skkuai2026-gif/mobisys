<% if @terms != nil %>
    <% @terms.each do |term| %>
      <option value="<%= term %>"> 
        <%= term %>
      </option>
    <% end %>  
<% else %>
    <option value="<%= @quotationProduct.premiumPayingTerm %>" selected> 
      <%= @quotationProduct.premiumPayingTerm %>
    </option>    
<% end %>