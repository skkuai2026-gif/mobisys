<%= modelTagStart(@quotation, nil, "basicDetails") %>
<div data-role="main" class="ui-content">
    <div class="main-content-wrapper main-content-full">
        <div class="add-lead-tab">
            <ul>
                <li><a href="#sales-illustration-personal-info" data-transition="slide" class="active"><span>1</span> <p class="tab-name">Personal Info</p></a></li>
                <li><i class="icon-arrow-right02"></i></li>

                <li><a href="#si-base-plan-details" data-transition="slide"><span>2</span> <p class="tab-name">Base Plan Details</p></a></li>
                <li><i class="icon-arrow-right02"></i></li>
                
                <li><a href="#sales-illustration-rider-details" data-transition="slide"><span>3</span> <p class="tab-name">Rider Details</p></a></li>
            </ul>
        </div>
        <div class="project-content-bg">
            <div class="div-with-border">
                <% quotationPckg = 'com.c2lbiz.symbiosys.insurance.businesscommon.dataobjects.policy' %>
                <%= prdFieldDataTag("#{quotationPckg}.PolicyDO",'quotAddtnlField2') %>
            </div>
        </div>
    </div>
</div>


