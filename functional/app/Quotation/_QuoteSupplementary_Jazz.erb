<% partyPckg = 'PolicySupplementaryLifeDO' %>
<div style="display: none;">
  <%= inputTag('quotationDt') %>
</div>
<% if $currentProduct.getFacetValue('FAMILYINSUREDDETAILS').to_s == 'YES' %>
	<% panelHeader = "#{getLabelValue('FAMILYINSUREDDETAILS')}" %>
	<% addSupLabel = "#{getLabelValue('ADDFAMILY')}"%>
<% else %>
	<% panelHeader = "#{getLabelValue('supplementary')}" %>
	<% addSupLabel = "#{getLabelValue('ADDSUPPLEMENTLIFE')}" %>
<% end %>
<%= fieldDataEntryGridTagStart('supplementaryQuotationParty',partyPackage,nil, nil, nil,nil,'delete','',nil,true,true,false,false,false) %>
	<%= panelTagStart(true) %>
		<% @supplementaryLife.each_with_index do |supplementary, count| %>
			<%= subPanelTagStart("#{panelHeader} #{count.to_i+ 1}") %>
				<div class='add-section'>
		    		<% gridID = "grid_#{@supplementLifeCount + count + 1 }_supplementaryQuotationParty" %>
		    		<%= modelTagStart(gridID, supplementary, @quotation,@supplementLifeCount + count + 1) %>
				        <i class='close-add-section icon-close' onClick='javascript:catchevent(this);' id='<%=gridID%>_removed'></i>
				        <%= prdFieldDataTag("#{partyPckg}","title,otherTitle",'','titleCd') %>
				        <%= subPanelTagStart("language1","false","",false) if @renderMultiLanguagePanel %>
				            <%= prdFieldDataTag("#{partyPckg}","firstname,middlename,lastname,extensionName",'#none,MIDDLENAMEREQUIRED,#none,#none','firstName1,middleName1,lastName1,extensionName1') %>
				        <% if @renderMultiLanguagePanel %>
							<div class="labelHeader breakLine"></div>
						<%= subPanelTagEnd %>
						<% end %>

				        <%= subPanelTagStart("language2","false","MULTILINGUALPARTYNAME",false) %>
				            <%= prdFieldDataTag("#{partyPckg}","firstname2,middlename2,lastname2,extensionName2",'#none,MIDDLENAMEREQUIRED,#none,#none','firstName2,middleName2,lastName2,extensionName2') %>
				            <div class="labelHeader breakLine"></div>
				        <%= subPanelTagEnd %>
				        
				        <%= prdFieldDataTag("#{partyPckg}","dob,age" , '' , 'birthDt,age') %>

				        <%= prdFieldDataTag("#{partyPckg}","genderCd,relationCd,otherRelation" , '' , '') %>
				        <%= prdFieldDataTag("#{partyPckg}","industryCd,natureOfDuty,occupationCd" , 'SUPPLYOCCUPATION' , 'industryCd,natureOfDuty,occupationClass') %>

				        <%= prdFieldDataTag("#{partyPckg}","smoker,nsap" , 'SUPPLYSMOKER,SUPPLYNSAP' , '') %>

				        <%= prdFieldDataTag("#{partyPckg}","coverageCountryCd,coverageCityCd" , 'SUPPLYCOVERAGELOCATION' , '') %>

				        <%= prdFieldDataTag("#{partyPckg}","contactNum,emailAddress" , '' , '') %>
				        
				        <div style="display: none;">
				            <%= inputTag("roleCd") %>
						
							<% unless MobiSys::BrowserHelper.renderPanel?("SUPPLYSMOKER", $currentProduct) %>
								<%= inputTag("smoker") %>
							<% end %>
				        </div>
				    <% modelTagEnd %>
				    <% if @supplementaryProductFacet %>
				    	
				    	<% @baseProduct = @supQuotProductHM[supplementary.guid]%>
				    	<% @quotationProductExtras = @supQuotProductExtraHM[@baseProduct.guid]%>
		        		<%= modelTagStart(gridID, @baseProduct, @quotation, @supQuotationProductCount) %>
				            <%= prdFieldDataTag("#{partyPckg}","baseAnnualPremium,baseSumAssured,modalPremium,productPlanOptionCd") %>
							<%= render :partial => "QuotePlanExtra_Jazz" %>
				            <%= inputTag("productTypeCd",nil,nil,nil,nil,nil,'HIDDEN') %>
				            <%= inputTag("partyRoleCd",nil,nil,nil,nil,nil,'HIDDEN') %>
				            <%= inputTag("insuredPartyRefGuid",nil,nil,nil,nil,nil,'HIDDEN') %>
				        <% modelTagEnd %>
				    <% end %>
				    <%= setupFilterUsingFieldTargetValueMap('TitleGenderSI', false, gridID) %>
				    <%= setupFilterUsingFieldTargetValueMap('CoverageCountryCity', true, gridID) %>
				    <%= setupFilterUsingFieldTargetValueMap('RelationGender', true, gridID) %>
				</div>
			<%= subPanelTagEnd %>
		<% end %>
	<%= panelTagEnd %>	
<%= fieldDataEntryGridTagEnd('supplementaryQuotationParty', @supplementaryLife, addSupLabel,true,true) %>
<input type="hidden" name="supplementLifeCount" id="supplementLifeCount" value='<%= @supplementLifeCount + @supplementaryLife.size %>'/>
<% if @supplementaryProductFacet %>
	<input type="hidden" name="supQuotationProductCount" id="supQuotationProductCount" value='<%= @supQuotationProductCount + @supQuotProductHM.size %>'/>
	<% if @baseProduct %>
		<%= modelTagStart("basePlan", @baseProduct, @quotation) %>
			<div style="display: none;">
				<%= inputTag("productTypeCd") %>
				<%= inputTag("productFamilyCd") %>
				<%= inputTag("productVersion") %>
				<%= inputTag("productSeq") %>
				<%= inputTag("productId") %>
				<%= inputTag("productPlanOptionCd") %>
			</div>
		<% modelTagEnd %>
	<% end %>
<% end %>
