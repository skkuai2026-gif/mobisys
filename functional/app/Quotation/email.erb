<div data-role="page">

  
  <div data-role="header" data-position="inline">
    <h1><%= renderLabel('email','EMAIL')%></h1>
    <div class="headerButtons" name = "headerButtons">     
      <a href="<%= url_for :action => :illustration1, :id => @quotation.object %>" class="ui-btn-left" data-direction="reverse">
        <img src="/public/images/SalesIllustration/icon_BackArrow-Red.png">
      </a>
    </div>
  </div>

  <div data-role="content" id="email">
      <div class="emaildisplay">
      <form method="POST" name="emailForm" action="<%= url_for :action => :emailQuotation %>">
      
        <%= renderObject(@emailRequest) %>
        <div class = "headerdiv">              
          <h3 align="center"> <%= getLabelValue('EMAILHEADER')   %></h3>
        </div>

        <div data-role="fieldcontain">
            <%= renderLabel('toEmail','TO', 'rightAlign') %>
            <%= renderEmailField('toEmail',@emailRequest.toEmail,'To', @emailRequest) %>
        </div>
            
        <div data-role="fieldcontain">
            <%= renderLabel('ccEmail','CC', 'rightAlign') %>
            <%= renderEmailField('ccEmail',@emailRequest.ccEmail,'Cc', @emailRequest) %>
            <%= renderHiddenField('entityGuid',@emailRequest.entityGuid,'entityGuid',@emailRequest) %>
            <%= renderHiddenField('entityNumber',@emailRequest.entityNumber,'entityNumber',@emailRequest) %>
            <%= renderHiddenField('entityName',@emailRequest.entityName,'entityName',@emailRequest) %>
        </div>

        <div data-role="fieldcontain">
          <%= renderLabel('message','INSERTMSG', 'rightTopAlign')   %>
          <textarea id="EmailRequest[message]" name="EmailRequest[message]"></textarea>
        </div>
        
        <!--  
        <fieldset class="ui-grid-b">
