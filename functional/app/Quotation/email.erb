              <%#= renderCheckBox(reportSection, nil, 'Selected', @emailRequest) %>
              <%#= renderLabel(reportSection,'&nbsp;', nil, @emailRequest) %>
              <%#= getLabelValue(reportSection) %>
            </div>
          </fieldset> -->
        <%# end %>

        <fieldset class="ui-grid-c">
          <div class="ui-block-a"></div>
          <div class="ui-block-b">
            <!-- <a href="#" name="print" data-role="button" data-theme="a" onclick="print();">
                <%#= getLabelValue('PRINT')%>
                <script>
                function print() {
                  if( true ){    
                    
                    $.mobile.showPageLoadingMsg();
                    document.emailForm.action="printIllustration";
                    document.emailForm.submit();                    
                    $("a[name='email']").attr('onclick', 'return false;');
                    $("a[name='print']").attr('onclick', 'return false;');
                  }        
                }
                </script>
            </a> -->
          </div>
          <div class="ui-block-c">            
            <a href="#" name="email" data-role="button" data-theme="a" onclick="sendemail();">
                <%= getLabelValue('EMAIL')%>
                <script>
                function sendemail() {
                  if( checkForm() && checkNetwork()){    
                    
                    $.mobile.showPageLoadingMsg();
                    document.emailForm.submit();                    
                    $("a[name='email']").attr('onclick', 'return false;');
                    $("a[name='print']").attr('onclick', 'return false;');
                  }        
                }
                </script>
            </a>

          </div>
          <div class="ui-block-d"></div>          
        </fieldset>
      </form>
      </div>
  </div>
  <script>
  
  function checkNetwork(){
    returnValue = false;        
    $.ajax({
            url: "/app/Quotation/checkNetwork",
            success: function(data) {
              data = data.replace("<div>","");
              data = data.replace("</div>","");
              try{
                if (data == "NETWORK")
                {
                  returnValue = true;
                }
                else
                {
                  returnValue = false;
                }
              }catch(e){alert(e);}
            },
            async: false                    
         });          
    
    if(!returnValue){
      showDialog("", "<%= getLabelValue('CHECKNETWORK')%>", 'error', 0, 'email');
    }
    
    return returnValue;
  }
  
  function checkForm(){
    var returnValue = true;
    
    toField = $("input[name='EmailRequest[toEmail]']").val();
    
    shortChecked = $("input[name='EmailRequest[shortIllustration]']").is(':checked');
    
    longChecked = $("input[name='EmailRequest[longIllustration]']").is(':checked');
    //completeChecked = $("input[name='EmailRequest[COMPLETEILLUSTRATION]']").is(':checked');
    //alert(completeChecked);
    
    errors = "";
    
    if (toField == "")
    {
      errors += "<%= getLabelValue('TOEMAILMANDATORY')%>\n";
      returnValue = false;
    }
    
    // if (!shortChecked && !longChecked && !completeChecked)
    // {
    //   errors += "<%= getLabelValue('ILLUSTRATIONREPORTMANDATORY')%>\n";
    //   returnValue = false;
    // }
    
    if(!returnValue){      
      showDialog("", errors, 'error', 0, 'email');
    }
    return returnValue
  }
  
  $('input[name="<%=getObjectMapping(@emailRequest)%>[toEmail]"]').change( function(){
    
    if(!testEmail(this.value))
    {
      $(this).val('');
    }
    
  });

  $('input[name="<%=getObjectMapping(@emailRequest)%>[ccEmail]"]').change( function(){
    
    if(!testEmail(this.value))
    {
      $(this).val('');
    }
    
  });

  function testEmail(value)
  {
    emails = value.replace(" ","").replace(",",";");
    emailList = emails.split(";"); 
    returnValue = true;
    for(i=0; i < emailList.length; i++)
    {    
      if (emailList[i] != "")
      {
        emailPattern=new RegExp("[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}");
        returnValue = emailPattern.test(emailList[i]);
        if(!returnValue)
        { 
          break;        
        }
      }
    }
      
    return returnValue;
  }

  </script>
</div>
