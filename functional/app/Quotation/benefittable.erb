<!-- benefit table -->  
  
<div data-role="page" id="benefittable">

  <div data-role="header" data-position="inline">
      <h1><%= getLabelValue('BENEFITSTABLE')   %></h1>
      <a href="<%= url_for :action => :illustration, :id=>@quotation.object%>" class="ui-btn-left" data-direction="reverse">
         <%= getLabelValue('BACK')   %>
      </a>
  </div>
   
  <div data-role="content">    
      <%case @illustrationFormat
         when "UNITLINKEDSMARTLINK"
      %>
      <%= renderLegend('fundInformation','FUNDINFORMATION') %>
      <div data-role="table" class="illustrationdisplay" name="fundInformation">
        <table class="illustrationtable" width="100%">
          <tr class="illustrationtableheader">
            <td colspan="2">
              <%= getLabelValue('POLICYYEAR')%>
            </td>
            <td colspan="4">
              <%= getLabelValue('FUNDCHOSEN')%>
            </td>
            <td colspan="2">
              <%= getLabelValue('WEIGHTEDEXPECTEDRETURN')%>
            </td>
            <td rowspan="2">
              <%= getLabelValue('WEIGHTEDMANAGEMENTCHARGE')%>
            </td>
          </tr>
          <tr class="illustrationtableheader"
            <td><%= getLabelValue('FROM')%></td>
            <%
              fundsArray = @outputHash["funds"]
              fundsHash = fundsArray[0]["funds"]
            %>
            <td><%= getLabelValue('TO')%></td>
            <%
            fundsHash.each do |fundcd, fundDetails|
            %>
              <td><%=fundcd%></td>
            <%
            end  
            %>
            <td><%= getLabelValue('LOW')%></td>
            <td><%= getLabelValue('HIGH')%></td>
          </tr>
          <% fundsArray.each do |fundArray| %>
          <tr class="illustrationtablerow">
            <td><%=fundArray["policyYearFrom"]%></td>
            <td><%=fundArray["policyYearTo"]%></td>
            <%fundsHash = fundArray["funds"]
              fundsHash.each do |fundCd, fundDetails|
            %>
            <td><%= fundDetails["allocation"]%>%</td>
            <%end %>
            <td><%=(fundArray["weightedExpectedReturnLow"].to_f * 100).round(2)%>%</td>
            <td><%=(fundArray["weightedExpectedReturnHigh"].to_f * 100).round(2)%>%</td>
            <td><%=(fundArray["weightedManagementCharges"].to_f * 100).round(2)%>%</td>
          <%end%>
          </tr>
        </table>
      </div>
      
      <%= renderLegend('lowReturns','LOWRETURNS') %>
      <div data-role="table" class="illustrationdisplay" name="lowReturns">
        <table class="illustrationtable" width="100%">
          <tr class="illustrationtableheader">
            <td rowspan=2><%= getLabelValue('POLICYYEAR') %></td>
            <td rowspan=2><%= getLabelValue('BASICSA') %></td>
            <td rowspan=2><%= getLabelValue('PP') %></td>
            <td rowspan=2><%= getLabelValue('UNALLOCATEDPREMIUM') %></td>
            <td rowspan=2><%= getLabelValue('ALLOCATEDPREMIUM') %></td>
            <td rowspan=2><%= getLabelValue('INSURANCECHARGES') %></td>
            <td rowspan=2><%= getLabelValue('OTHERCHARGES') %></td>
            <td colspan=3><%= getLabelValue('PROJECTEDRETURNS') %></td>
            <td rowspan=2><%= getLabelValue('DDC') %></td>
            <td rowspan=2><%= getLabelValue('INSUREDAGE') %></td>
          </tr>
          <tr class="illustrationtableheader">
            <td><%= getLabelValue('FMC') %></td>
            <td><%= getLabelValue('CV') %></td>
            <td><%= getLabelValue('DEATHBENEFIT') %></td>
          </tr>
          <% benefitTable = @outputHash["benefittable"]%>
          <% benefitTable.each do |benefitRow|%>
            <%next unless benefitRow%>
            <tr class="illustrationtablerow">
              <td class="tablenum"> <%= renderNumber("%.0f" % benefitRow["policyYear"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["basicSA"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["premiumLow"]) %> </td>
              <td class="tablenum"> <%= renderNumber((benefitRow["premiumLow"] + benefitRow["topup"]) - (benefitRow["allocationPremiumLow"] + benefitRow["topupAllocation"])) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["allocationPremiumLow"] + benefitRow["topupAllocation"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["totalCOILow"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["otherChargesLow"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["fundMgmtChargeLow"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["eoyFundLow"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["deathBenefitLow"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["directDistributionCost"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["attainedAge"]) %> </td>
            </tr>
          <% end %>  
        </table>
      </div>
      
      <%= renderLegend('highReturns','HIGHRETURNS') %>
      <div data-role="table" class="illustrationdisplay" name="highReturns">
        <table class="illustrationtable" width="100%">
          <tr class="illustrationtableheader">
            <td rowspan=2><%= getLabelValue('POLICYYEAR') %></td>
            <td rowspan=2><%= getLabelValue('BASICSA') %></td>
            <td rowspan=2><%= getLabelValue('PP') %></td>
