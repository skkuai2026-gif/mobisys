            <td rowspan=2><%= getLabelValue('OTHERCHARGES') %></td>
            <td colspan=3><%= getLabelValue('PROJECTEDRETURNS') %></td>
            <td rowspan=2><%= getLabelValue('DDC') %></td>
            <td rowspan=2><%= getLabelValue('INSUREDAGE') %></td>
          </tr>
          <tr class="illustrationtableheader">
            <td><%= getLabelValue('FMC') %></td>
            <td><%= getLabelValue('CV') %></td>
            <td><%= getLabelValue('DEATHBENEFIT') %></td>
          </tr>
          <% benefitTable = @outputHash["benefittable"]%>
