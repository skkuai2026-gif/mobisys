              <td class="tablenum"> <%= renderNumber(benefitRow["totalCOIHigh"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["otherChargesHigh"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["fundMgmtChargeHigh"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["eoyFundHigh"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["deathBenefitHigh"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["directDistributionCost"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["attainedAge"]) %> </td>
            </tr>
          <% end %>  
        </table>
      </div>
