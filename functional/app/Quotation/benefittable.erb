  <script>
    $('img[name*="collapse"]').click( function(){
      divName = this.name.replace("collapse_","");
      val = $('input[name="state_'+divName+'"]').val();
      // # replace image
      if(val == "+")
      {
        $('input[name="state_'+divName+'"]').val('-');
        $('img[name="collapse_'+divName+'"]').attr("src","/public/images/SalesIllustration/less.jpg");
        $('div[name="'+divName+'"]').show();          
      }
      else // # val == "-"
      {
        $('input[name="state_'+divName+'"]').val('+');
        $('img[name="collapse_'+divName+'"]').attr("src","/public/images/SalesIllustration/more.jpg");
        $('div[name="'+divName+'"]').hide();
      }
          
          
    });
    
      function acceptIllustration(){
        $.ajax({
                  url: "/app/Quotation/acceptIllustration",
                  data: {},
                  success: function(data) {
                  },
                  async: true                    
               });          
   
      }

      function accepted(uri){
        $.ajax({
                  url: "/app/Quotation/accepted",
                  data: {'uri':uri, 'quotation': '<%=@quotation.object%>'},
                  success: function(data) {
                  },
                  async: true                    
               });          
       
      }

      $(document).focus(function() {
        setTimeout("onFocus()", 100);
      });
      
      function onFocus(){
          drawGraph(1);
      }

      function drawGraph(illustrationRate)
      {
        var bar5;
        var line;

        $('div[name="graph"]').html("<canvas id='cvs' name='cvs' width='"+ $(document).width() * 0.9 +"px' height='300px'>[No canvas support]</canvas>");
        $('div[name="graph"]').trigger('create');
        
        if (illustrationRate == 1)
        {
          bar5 = new RGraph.Bar('cvs', <%= @values %>);
        }
        else if (illustrationRate == 7)
        {
          bar5 = new RGraph.Bar('cvs', <%= @valuesL %>);
        }
        else if (illustrationRate == 8)
        {
          bar5 = new RGraph.Bar('cvs', <%= @valuesM %>);
        }
        else if (illustrationRate == 9)
        {
          bar5 = new RGraph.Bar('cvs', <%= @valuesH %>);
        }
        
        bar5.Set('colors', ['#cccccc']);
           
        bar5.Set('labels', <%= @labels %>);
        bar5.Set('chart.numyticks', 20);
        bar5.Set('chart.ylabels.count', 10);
        bar5.Set('strokestyle', 'transparent');
        bar5.Set('chart.gutter.left', 90);
        bar5.Set('chart.gutter.bottom', 35);
        bar5.Set('chart.title.yaxis', 'Amount');
        bar5.Set('chart.title.yaxis.pos', 0.2);
        bar5.Set('chart.title.xaxis', 'Policy Year');
        bar5.Set('chart.title', 'Sales Illustration');
        bar5.Set('ymax', <%= @ymax %>);
        bar5.Set('chart.key', [<%= @chartKey %>]);
        bar5.Set('chart.colors', [<%= @chartColours %>]);
        //bar5.Set('chart.key.position','gutter');
        bar5.Set('chart.key.halign','left');
                        
        <% if @lineValues != nil && @lineValues != "''" %>
        line = new RGraph.Line('cvs', <%= @lineValues %> );
        line.Set('colors', ['#FF0000','#00FF00','#0000FF']);
        line.Set('linewidth', 2)
        line.Set('chart.numyticks', 20);
        line.Set('chart.ylabels.count', 10);
        line.Set('chart.gutter.left', 90);
        line.Set('chart.gutter.bottom', 35);
        line.Set('ymax', <%= @ymax %>);
          
        combo = new RGraph.CombinedChart(bar5, line);

        combo.Draw(); 
        <% else %>
          bar5.Draw();
        <% end %>
        
      }
  </script>
</div>
