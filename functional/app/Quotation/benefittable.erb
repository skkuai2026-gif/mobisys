            <tr class="illustrationtablerow">
              <td class="tablenum"> <%= renderNumber("%.0f" % benefitRow["policyYear"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["basicSA"]) %> </td>
              <td class="tablenum"> <%= renderNumber(benefitRow["premiumHigh"]) %> </td>
              <td class="tablenum"> <%= renderNumber((benefitRow["premiumHigh"] + benefitRow["topup"]) - (benefitRow["allocationPremiumHigh"] + benefitRow["topupAllocation"])) %> </td>
