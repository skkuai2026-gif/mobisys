                    <div class="half">
                        <%= renderLabel('veryHighReturnRate','veryHighReturnRate', nil , @baseProduct) %>
                        <%= renderAmountField('veryHighReturnRate', @baseProduct.veryHighReturnRate, nil, @baseProduct, "maxlength='20'")%>
                    </div>
                </div>
            <% end %>
        <% end %>

        <% if @facetData[:renderIncomeBaseSolver] == true %>
            <div class="ui-grid-d">
