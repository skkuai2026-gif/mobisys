                            <%= renderAmountField('veryLowReturnRate', @baseProduct.veryLowReturnRate, nil, @baseProduct, "maxlength='20'")%>
                        </div>
                    <% end %>
                </div>
            <% end %>

            <% if @facetData[:renderVeryHighReturnRate] %>
