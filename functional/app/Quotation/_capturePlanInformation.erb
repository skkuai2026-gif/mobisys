        <div data-role="dualfieldcontain">
            <% if @facetData[:renderProductfamilycd] %>
                <div class ="half">
                    <%= renderLabel('productFamilyCd', 'productFamilyCd', nil, @baseProduct) %> 
                    <%= getLookup('DYNAMICLOOKUP', 'productFamilyCd', @baseProduct.productFamilyCd, @baseProduct, @productFamilyArray) %>
                </div>
            <% else %>
                <%= renderHiddenField('productFamilyCd',@baseProduct.productFamilyCd,'productFamilyCd', @baseProduct) %>
            <% end %>

            <% if @facetData[:renderProductid] %>
                <div class ="half">
