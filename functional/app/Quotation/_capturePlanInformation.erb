                        <div class="half">
                            <%= renderLabel('highReturnRate','highReturnRate', nil , @baseProduct) %>
                            <%= renderAmountField('highReturnRate', @baseProduct.highReturnRate, nil, @baseProduct, "maxlength='20'")%>
                        </div>
                    <% end %>
                    <% if @facetData[:renderVeryLowReturnRate] %>
