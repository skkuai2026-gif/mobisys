        <a data-role="button" id="inline" href="#data" style="width: 30%; height: 32px; float: right; margin: 0% 4% 1% 1%;"><%= getLabelValue('SELECT/CHANGEPRODUCT')  %></a>
    </div>
<%end%>
<div class="illustrationdisplay" name = "basePlan" >
