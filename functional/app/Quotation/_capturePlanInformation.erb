<%= renderHiddenField('productSeq',@baseProduct.productSeq, 'productSeq', @baseProduct)%>
<%= renderHiddenField('productVersion',@baseProduct.productVersion, 'productVersion', @baseProduct)%>
<%= renderHiddenField('partyRoleCd',@baseProduct.partyRoleCd,'partyRoleCd', @baseProduct) %>
