<!-- Start of illustration page -->
<div data-role="page" id="illustration">

  <div data-role="header" data-position="inline">
    <a href="<%= url_for :controller => :Menu, :action => :salesIllustration%>" class="ui-btn-left" data-direction="reverse">
       <%= getLabelValue('BACK')   %>
    </a>
    <h1>Proposal <%= getLabelValue('ILLUSTRATION')%></h1>

  </div>
  
  <div data-role="content">

    <% if @sections.include? "SUMMARY" or @sections.include? "COMPLETEILLUSTRATION"%>
    
    <% if @baseQuotationProduct.productId == "SL"%>
    <img src = "/public/collateral/SL_IMG.PNG" width="100%">
    <% end %>
    <div data-role="table" class="illustrationdisplay" >

          
      <div style="display:block;">
      
        <table class="illustrationtable" width = "100%" align="center">
          <tr class="illustrationtablerow">
            <td class="tableheader" width="20%"> <%= getLabelValue("NAMESURNAME") %> </td>
            <td class="tabletext" width="40%"> <%= @quotation.firstname %> </td>
            <td rowspan="5" width=40% align=center> <div name="barcodeTarget"> </div> </td> 
          </tr>
          <tr class="illustrationtablerow">
            <td class="tableheader"> <%= getLabelValue("AGE") %> </td>
            <td class="tabletext"> <%= @quotation.age %> </td>
          </tr>
          <tr class="illustrationtablerow">
            <td class="tableheader"> <%= getLabelValue("PAYMENTMODE") %> </td>
            <td class="tabletext"> <%= getLabelValue(@baseQuotationProduct.paymentFrequencyCd) %> </td>
          </tr>
          <tr class="illustrationtablerow">
            <td class="tableheader"> <%= getLabelValue("GENDER") %> </td>
            <td class="tabletext"> <%= getLabelValue(@quotation.genderCd) %> </td>
          </tr>
          <tr class="illustrationtablerow">
            <td class="tableheader"> <%= getLabelValue("SMOKER") %> </td>
            <td class="tabletext"> <%= getLabelValue(@quotation.smoker) %> </td>
          </tr>

        </table>
        <br/>
        <script>
          var settings = {
            output:'css',
            bgColor: '#ffffff',
            color: '#000000',
            barWidth: '2px',
            barHeight: '100px',
            moduleSize: '5',
            addQuietZone: 'yes'
          };
          $('div[name="barcodeTarget"]').html("").show().barcode("<%= @quotation.quotationRefNum %>", "datamatrix", settings);
        </script>
        
        <% totalBasePremium = 0
           premiumBlocks = 0
           if @baseQuotationProduct != nil && @baseQuotationProduct.productId != nil && @baseQuotationProduct.productId != "" 
             premiumBlocks = premiumBlocks + 1 
             %>
            <!-- base plan table -->  
            <table class="illustrationtable" width = "100%" align="center">
                <tr class="illustrationtableheader" >
                  <td width="55%"> <%= getLabelValue('PLAN') %> </td>
                  <td width="15%"> <%= getLabelValue('SUMASSURED') %> </td>
                  <td width="15%"> <%= getLabelValue('PREMIUMPERTIME') %> <br> <%= getLabelValue(@baseQuotationProduct.paymentFrequencyCd) %></td>
                  <td width="15%"> <%= getLabelValue('TAXELIGIBLE') %> </td>
                </tr>
      
                <!-- for each base product -->          
                <% 
                  
                  @quotation.QuotationProductList.each do |quotationProduct|
                    currentProduct = @productHash[quotationProduct.productId] 
                    if currentProduct != nil and quotationProduct.productTypeCd == "PLAN"
                      totalBasePremium += quotationProduct.modalPremium.to_f
                    %>
                      <tr class="illustrationtablerow">
                          <td class="tabletext">
                            <a href="<%= url_for :action => :benefits, :id=>@quotation.object, :query=>{:product => quotationProduct.productId} %>">
                              <div style="height:100%;width:100%">
                                <%= quotationProduct.planCode %> - <%= getLabelValue(quotationProduct.planCode+"LONG") %>
                              </div>
                            </a>
                          </td>
                          <td class="tablenum"> 
                            <% if quotationProduct.baseSumAssured == nil || quotationProduct.baseSumAssured.to_i == 0 %>
                              <%= quotationProduct.productPlanOptionCd %>
                            <% else %>
                              <%= renderNumber(quotationProduct.baseSumAssured) %>
                            <% end %>
                          </td>
                          <td class="tablenum"> <%= renderNumber(quotationProduct.modalPremium) %> </td>
                          <td align="center">
                            <% if @taxExemptionHT[quotationProduct.productId] != nil && @taxExemptionHT[quotationProduct.productId] == 1 %>
                              <img src="/public/images/red-tick-th.png" style="height:14px;">
                            <% end %>
                          </td>
                      </tr>
                    <%
                    end 
                  end 
                %>
                
                <tr class="illustrationtablerow">
                    <td colspan=2 class="tablenum"> <span> <%= getLabelValue('TOTALPREMIUM') %> (<%=premiumBlocks%>) </span> </td>
                    <td class="tablenum"> <%= renderNumber(totalBasePremium.to_i) %></td>
                </tr>
            </table>
            <!-- end base plan table -->        
            <br>
          <% end %>

        <% 
          totalRiderPremium = 0
          riders = MobiSys::QuotationBO.getRiders(@quotation)
          showRiders = false
          riders.each do |rider|
            showRiders = true if rider.selected == "on"
          end
          
          if showRiders
            premiumBlocks = premiumBlocks + 1
        %>
        
        <!-- rider table -->
        <table class="illustrationtable" width = "100%" align="center">
          <tr class="illustrationtableheader" >
            <td width="55%"> <%= getLabelValue('RIDER')   %> </td>
            <td width="15%"> <%= getLabelValue('SUMASSURED')   %> </td>
            <td width="15%"> <%= getLabelValue('PREMIUMPERTIME') %> <br> <%= getLabelValue(@baseQuotationProduct.paymentFrequencyCd) %> </td>
            <td width="15%"> <%= getLabelValue('TAXELIGIBLE')   %> </td>
          </tr>
  
          <!-- for each rider -->          
          <% 
            @products.each do |currentProduct|
              quotationProduct = MobiSys::QuotationBO.getQuotationProductByProductId(@quotation, currentProduct.productId)            
               
              if  currentProduct != nil && quotationProduct != nil && 
                  quotationProduct.productTypeCd == "RIDER" && quotationProduct.selected == "on"
                   
                totalRiderPremium += quotationProduct.modalPremium.to_f
              %>
                <tr class="illustrationtablerow">
                    <td class="tabletext">
                      <a href="<%= url_for :action => :benefits, :id=>@quotation.object, :query=>{:product => quotationProduct.productId} %>">
                        <div style="height:100%;width:100%">
                          <%= quotationProduct.planCode %> - <%= getLabelValue(quotationProduct.planCode+"LONG") %>
                        </div>
                      </a>
                    </td>
                    <td class="tablenum">
                      <% if quotationProduct.baseSumAssured == nil || quotationProduct.baseSumAssured.to_i == 0 %>
                        <%= getLabelValue(quotationProduct.productPlanOptionCd) %>
                      <% else %>
                        <% if quotationProduct.productId != "PB" %>
                          <%= renderNumber(quotationProduct.baseSumAssured) %>
                        <% else %>
                          <%= renderNumber(@baseQuotationProduct.baseSumAssured) %>
                        <% end %>
                      <% end %>
                    </td>
                    <td class="tablenum">
                      <% 
                        if quotationProduct.modalPremium.to_i != 0
                        %>
                          <%= renderNumber(quotationProduct.modalPremium) %>
                        <%
                        else
                          %>
                          <%= getLabelValue('FREE') %>
                          <%
                        end
                      %>                        
                    </td>
                    <td align="center">
                      <% if @taxExemptionHT[@baseQuotationProduct.productId] != nil && @taxExemptionHT[@baseQuotationProduct.productId] == 1 &&
                            quotationProduct.productId == "TR" && quotationProduct.productTerm != nil && quotationProduct.productTerm.to_i >= 10 %>
                        <img src="/public/images/red-tick-th.png" style="height:14px;">
                      <% end %>
                    </td>
                </tr>
              <%
              end 
            end 
          %>
           
          <tr class="illustrationtablerow">
            <td colspan=2 class="tablenum"> <span> <%= getLabelValue('TOTALPREMIUM') %> (<%=premiumBlocks%>) </span> </td>
            <td class="tablenum"> <%= renderNumber(totalRiderPremium.to_i) %> </td>
          </tr>
        </table>
        <!-- end rider table -->
         
        <br>
        
        <%
          end
        %> 
        
        <% if @partialProducts.length > 0 %>
        
        
        <!-- partial product table -->
        <table class="illustrationtable" width = "100%" align="center">
          <tr class="illustrationtableheader" >
            <td width="55%"> <%= getLabelValue('PARTIALPRODUCTS')   %> </td>
            <td width="15%"> <%= getLabelValue('SUMASSURED')   %> </td>
            <td width="15%"> <%= getLabelValue('PREMIUMPERTIME') %> <br> <%= getLabelValue(@baseQuotationProduct.paymentFrequencyCd) %> </td>
            <td width="7%"> <%= getLabelValue('COVERAGETERM')   %> </td>
            <td width="8%"> <%= getLabelValue('PPTERM')   %> </td>
          </tr>
        
        
          <tr class="illustrationtablerow">
              <td class="tabletext">
                <%= @baseQuotationProduct.planCode %> - <%= getLabelValue(@baseQuotationProduct.planCode+"LONG") %>
              </td>
              <td class="tablenum">
                <%= renderNumber(@baseQuotationProduct.baseSumAssured) %>
              </td>
              <td class="tablenum">
                <%= @baseQuotationProduct.modalPremium.to_f.round(2).to_s %>
              </td>
              <td class="tablenum">
                <%= @baseQuotationProduct.productTerm %>
              </td>
              <td class="tablenum">
                <%= @baseQuotationProduct.premiumPayingTerm %>
              </td>
          </tr>
          
          <% 
            quotationProduct = MobiSys::QuotationBO.getQuotationProductByProductId(@quotation, '10ECV')
          %>
            
          <tr class="illustrationtablerow">
              <td class="tabletext">
                - Regular premium (Year 1 - 6)
              </td>
              <td class="tablenum">
                <%= renderNumber(@baseQuotationProduct.baseSumAssured) %>
              </td>
              <td class="tablenum">
                <%= @baseQuotationProduct.modalPremium.to_f.round(2).to_s %>
              </td>
              <td class="tablenum">
                <%= quotationProduct.productTerm %>
              </td>
              <td class="tablenum">
                <%= quotationProduct.premiumPayingTerm %>
              </td>
          </tr>
        
          <% 
            wlProduct = MobiSys::QuotationBO.getQuotationProductByProductId(@quotation, '2WL99')
            ulProduct = MobiSys::QuotationBO.getQuotationProductByProductId(@quotation, 'UL99')
          %>
            
          <tr class="illustrationtablerow">
              <td class="tabletext">
                - Regular premium (Year 7+)
              </td>
              <td class="tablenum">
                <%= renderNumber(wlProduct.baseSumAssured) %>
              </td>
              <td class="tablenum">
                <%= (wlProduct.modalPremium.to_f + ulProduct.modalPremium.to_f).round(2).to_s %>
              </td>
              <td class="tablenum">
                <%= @baseQuotationProduct.productTerm %>
              </td>
              <td class="tablenum">
                <%= @baseQuotationProduct.premiumPayingTerm %>
              </td>
          </tr>
           
        </table>
        <!-- end partial product table -->
        <br>
        
        <div name="premiumgraph" > 
          
        </div>
        
        <br>
        <% end %>

        
        <% totalPAPremium = 0
           if @paProduct != nil && @paProduct.productId != nil && @paProduct.productId != "" 
             premiumBlocks = premiumBlocks + 1
             %>
          <!-- PA table -->
          <table class="illustrationtable" width = "100%" align="center">
              <tr class="illustrationtableheader" >
                <td width="55%"> <%= getLabelValue('PAPLAN')   %> </td>
                <td width="15%"> <%= getLabelValue('SUMASSURED')   %> </td>
                <td width="15%"> <%= getLabelValue('PREMIUM')   %> </td>
                <td width="15%"> <%= getLabelValue('TAXELIGIBLE')   %> </td>
              </tr>
          
              <!-- for each PA product -->          
              <% 
                
                @quotation.QuotationProductList.each do |quotationProduct|
                  currentProduct = @productHash[quotationProduct.productId] 
                  if currentProduct != nil and quotationProduct.productTypeCd == "PA"
                    totalPAPremium += quotationProduct.baseAnnualPremium.to_f
                  %>
                    <tr class="illustrationtablerow">
                        <td class="tabletext">
                          <a href="<%= url_for :action => :benefits, :id=>@quotation.object, :query=>{:product => quotationProduct.productId} %>">
                            <div style="height:100%;width:100%">
                              <%= getLabelValue(quotationProduct.planCode+"LONG") %>
                            </div>
                          </a>
                        </td>
                        <td class="tablenum"> 
                          <% if quotationProduct.baseSumAssured == nil || quotationProduct.baseSumAssured.to_i == 0 %>
                            <%= getLabelValue(quotationProduct.planCode) %>
                          <% else %>
                            <%= renderNumber(quotationProduct.baseSumAssured) %>
                          <% end %>
                        </td>
                        <td class="tablenum"> <%= renderNumber(quotationProduct.baseAnnualPremium) %> </td>
                        <td align="center">
                           <% if @taxExemptionHT[quotationProduct.productId] != nil && @taxExemptionHT[quotationProduct.productId] == 1 %>
                             <img src="/public/images/red-tick-th.png" style="height:14px;">
                           <% end %>
                        </td>
                    </tr>
                  <%
                  end 
                end 
              %>
              
              <tr class="illustrationtablerow">
                  <td colspan=2 class="tablenum"> <span> <%= getLabelValue('TOTALPREMIUM') %> (<%=premiumBlocks%>) </span> </td>
                  <td class="tablenum"> <%= renderNumber(totalPAPremium.to_i) %></td>
              </tr>
          </table>
          <!-- end PA table -->
          <br>  
        <% end %>
        
        
        <% if premiumBlocks != 1 %> 
          <!-- total premium -->
            <table class="illustrationtable" width = "100%" align="center">
                <tr class="illustrationtablerow">
                    <td colspan=2 class="tablenum" width="70%"> <span> <%= getLabelValue('TOTALPREMIUM')   %>
                    <%
                      for i in 1..premiumBlocks
                        if i == 1
                          %>
                            (<%=i%>)
                          <%
                        else
                          %>
                            + (<%=i%>)
                          <%
                        end
                      end
                    %>
                    </span> </td>
                    <td class="tablenum" width="15%"> <%= renderNumber((totalBasePremium + totalRiderPremium + totalPAPremium).to_i) %> </td>
                  <td width="15%"></td>
              </tr>
            </table>
          <!-- end total premium -->
        <br>
        <% end %>
        
        <% if @funds != nil && @funds.size > 0 %>
          <!-- funds -->
            <table class="illustrationtable" width = "100%" align="center">
              <tr class="illustrationtableheader" >
                <td width="70%"> <%= getLabelValue('FUNDS')   %> </td>
                <td width="15%"> <%= getLabelValue('ALLOCATION')   %> </td>
                <td width="15%"> <%= getLabelValue('TOPUP')   %> </td>
                
              </tr>
              <% 
              totalAllocation = 0
              @funds.each do |fund| 
                totalAllocation = totalAllocation + fund.allocationPerc.to_i   
                %>
                <tr class="illustrationtablerow">
                  <td class="tabletext"> <%= fund.fundCd %> - <%= getLabelValue(fund.fundCd) %> </td>
                  <td class="tablenum"> <%= fund.allocationPerc %>% </td>
                  <td class="tablenum"> &nbsp; </td>
                </tr>
              <% end %>
              
              <tr class="illustrationtablerow">
                <td class="tabletext"> <b>Total</b> </td>
                <td class="tablenum"> <b><%= totalAllocation %>%</b> </td>
                <td class="tablenum"> &nbsp; </td>
              </tr>
            
            </table>
          <!-- end funds -->
          <br>

        <% end %>
        
        <% if @topups != nil && @topups.size > 0 %>
          <!-- topups -->
            <table class="illustrationtable" width = "100%" align="center">
              <tr class="illustrationtableheader" >
                <td width="70%"> <%= getLabelValue('TOPUPYEAR')   %> </td>
                <td width="30%"> <%= getLabelValue('TOPUPAMOUNT')   %> </td>                
                
              </tr>
              <% 
              @topups.each do |topup| 
                %>
                <tr class="illustrationtablerow">
                  <td class="tabletext"> <%= getLabelValue('YEAR') %> <%= topup.year %> </td>
                  <td class="tablenum"> <%= renderNumber(topup.topupAmt) %> </td>
                </tr>
              <% end %>
            
            </table>
          <!-- end topups -->
          <br>
        
        <% end %>

      </div>
    </div> <!-- data-role = "table" -->

    <% end %>

    <% if @sections.include? "BASEBENEFITS" or @sections.include? "COMPLETEILLUSTRATION"%>
    <!-- benefit pages for each base product -->          
    <% 
      @quotation.QuotationProductList.each do |quotationProduct|
        currentProduct = @productHash[quotationProduct.productId] 
        if currentProduct != nil && quotationProduct.productTypeCd == "PLAN" && currentProduct.productId == @productId
        %>
          <div data-role="page" id="basebenefit_<%=quotationProduct.productId%>">
          
            <div data-role="header" data-position="inline">
              <h1><%= getLabelValue('BASEBENEFITS') %> - <%= getLabelValue(quotationProduct.planCode+"LONG") %> </h1>
            </div>
            
            <div data-role="content">
              <div data-role="table" class="illustrationdisplay">
                <% if @illustrationCollateral != nil %>
                <div style="width: 100%; height:310px">
                    <div class="illustrationimage">
                      
                        <img src="<%=@illustrationCollateral.fileName%>" height=300px width=100%>
                      
                    </div>
                    <div class="illustrationimage">
                      <%
                        if @stylesList != nil
                          @stylesList.each_with_index do |style, index| %>
                            <DIV class="illustrationimagetext" STYLE="<%=style%>">
                                <%= @valuesList[index] %>
                            </DIV>
                          <%  
                          end
                        end
                      %>
                    </div>
                </div>
                <% end %>
    
          <!-- Survival benefit table -->
          <% 
            if @productBenefitsHash[currentProduct.productId+"SURVIVAL"] != nil
              %>
                <table class="illustrationtable" width="100%">
                  <tr class="illustrationtableheader" >
                    <td class="tabletext" colspan=2>
                      <%= getLabelValue('SURVIVALBENEFIT')   %>
                    </td>  
                  </tr>
                  <%
                  survivalBenefits = @productBenefitsHash[currentProduct.productId+"SURVIVAL"]
                  
                  survivalBenefits.each do |benefit|              
                    %>
                        <tr class="illustrationtablerow">
                          <td class="tabletext" width="70%">  <%= getLabelValue(benefit.benefitLabelCd)   %> </td>
                          <td class="tablenum" width="30%">
                            <% if benefit.basisCd == "RATESA" %>
                              <%= renderNumberFloor(benefit.benefitAmount.to_f * quotationProduct.baseSumAssured.to_f / 100.0)%> <%= getLabelValue('BAHT')%>
                            <% elsif benefit.basisCd == "RATESA_THREE" %>
                              <%= renderNumberFloor((benefit.benefitAmount.to_f * quotationProduct.baseSumAssured.to_f / 100.0).floor() * 3.0)%> <%= getLabelValue('BAHT')%>
                            <% elsif benefit.basisCd == "RATESA_TERM" %>
                              <%= renderNumberFloor( (benefit.benefitAmount.to_f * quotationProduct.baseSumAssured.to_f / 100.0).floor() * quotationProduct.productTerm.to_f)%> <%= getLabelValue('BAHT')%>
                            <% elsif benefit.basisCd == "RATEPREMIUM" %>
                              <%= renderNumber(benefit.benefitAmount.to_f * quotationProduct.modalPremium.to_f / 100.0)%> <%= getLabelValue('BAHT')%>
                            <% elsif benefit.basisCd == "RATEANNUALPREMIUM" %>
                              <%= renderNumber(benefit.benefitAmount.to_f * quotationProduct.baseAnnualPremium.to_f / 100.0)%> <%= getLabelValue('BAHT')%>
                            <% elsif benefit.basisCd == "RATESA_VESTING" %>
                              <%= renderNumberFloor( (quotationProduct.productTerm.to_f - quotationProduct.premiumPayingTerm.to_f) * (benefit.benefitAmount.to_f * quotationProduct.baseSumAssured.to_f / 100.0).floor() )%> <%= getLabelValue('BAHT')%>
                            <% elsif benefit.basisCd == "RATESAPARTIALEN" %>
                              <%= renderNumberFloor(benefit.benefitAmount.to_f * MobiSys::QuotationBO.getQuotationProductByProductId(@quotation, '10ECV').baseSumAssured.to_f / 100.0)%> <%= getLabelValue('BAHT')%>
                            <% elsif benefit.basisCd == "FLAT" %>
                              <%= renderNumber(benefit.benefitAmount.to_f)%> <%= getLabelValue('BAHT')%>
                            <% elsif benefit.basisCd == "FLATVALUE" %>
                              <%= benefit.benefitAmount.to_f%>
                            <% elsif benefit.basisCd == "FLATYEAR" %>
                              <%= renderNumber(benefit.benefitAmount.to_f)%> <%= getLabelValue('YEAR')%>
                            <% elsif benefit.basisCd == "MESSAGE_EXISTS" %>
                              ( <%= getLabelValue('IFANY')%> )
                            <% elsif benefit.basisCd == "MESSAGE_FREE" %>
                              ( <%= getLabelValue('FREE')%> )
                            <% elsif benefit.basisCd == "MESSAGE" %>
                              &nbsp;
                            <% elsif benefit.basisCd.include? "RATEAP" 
                                split = benefit.basisCd.split(";")
                                
                                if split.size == 2
                                  
                                  policyYears = split[1].split(",")
                                  rates = benefit.benefitAmount.to_f
                                  benefitValue = 0
                                   
                                  accumulatedPremiumValues = Array.new                              
                                  accumulatedPremium = 0
                                  accumulatedPremiumValues.push(accumulatedPremium)
                                  
                                  
                                  (1..quotationProduct.productTerm.to_i).each do |policyYear|
                                    premiumReceived = 0
                                    if policyYear <= quotationProduct.premiumPayingTerm.to_i
                                      case quotationProduct.paymentFrequencyCd
                                      when "YEARLY"
                                        premiumReceived = quotationProduct.modalPremium.to_f
                                      when "HALFYEARLY"
                                        premiumReceived = quotationProduct.modalPremium.to_f * 2
                                      when "QUARTERLY"
                                        premiumReceived = quotationProduct.modalPremium.to_f * 4
                                      when "MONTHLY"
                                        premiumReceived = quotationProduct.modalPremium.to_f * 12
                                      end
                                    end
                                    accumulatedPremium += premiumReceived.to_f
                                    
                                    accumulatedPremiumValues.push(0+accumulatedPremium) 
                                  end
                                  
                                  policyYears.each_with_index do |year, index|
                                    begin
                                      benefitValue += (accumulatedPremiumValues[year.to_i].to_f * rates.to_f / 100.0).floor()
                                    rescue StandardError => se    
                                      benefitValue += 0
                                    end
                                  end
                                  
                                  %>                            
                                <%= renderNumberFloor(benefitValue.to_f)%> <%= getLabelValue('BAHT')%>    
                                  <%
                                end
                              %>                            
                            <% end %>
                          </td>
                        </tr>
                    <% 
                  end
                  %>
                </table>
                <!-- End Survival benefit table -->
                <br>
              <%
            end 
          %>          
    
          <!-- Death benefit table -->
          <% 
            if @productBenefitsHash[currentProduct.productId+"DEATH"] != nil
              %>
                <table class="illustrationtable" width="100%">
                  <tr class="illustrationtableheader" >
                    <td class="tabletext" colspan=2>
                      <%= getLabelValue('DEATHBENEFIT')   %>
                    </td>  
                  </tr>
              <%
              deathBenefits = @productBenefitsHash[currentProduct.productId+"DEATH"]
              
              deathBenefits.each do |benefit|              
                %>
                    <tr class="illustrationtablerow">
                      <td class="tabletext" width="70%">  <%= getLabelValue(benefit.benefitLabelCd)   %> </td>
                      <td class="tablenum" width="30%">   
                        <% if benefit.basisCd == "RATESA" %>
                          <%= renderNumberFloor(benefit.benefitAmount.to_f * quotationProduct.baseSumAssured.to_f / 100.0)%> <%= getLabelValue('BAHT')%>
                        <% elsif benefit.basisCd == "RATESA_TERM" %>
                          <%= renderNumberFloor( (benefit.benefitAmount.to_f * quotationProduct.baseSumAssured.to_f / 100.0).floor() * quotationProduct.productTerm.to_f)%> <%= getLabelValue('BAHT')%>
                        <% elsif benefit.basisCd == "RATESA_THREE" %>
                          <%= renderNumberFloor((benefit.benefitAmount.to_f * quotationProduct.baseSumAssured.to_f / 100.0).floor() * 3.0)%> <%= getLabelValue('BAHT')%>
                        <% elsif benefit.basisCd == "RATEPREMIUM" %>
                          <%= renderNumber(benefit.benefitAmount.to_f * quotationProduct.modalPremium.to_f / 100.0)%> <%= getLabelValue('BAHT')%>
                        <% elsif benefit.basisCd == "RATEANNUALPREMIUM" %>
                          <%= renderNumber(benefit.benefitAmount.to_f * quotationProduct.baseAnnualPremium.to_f / 100.0)%> <%= getLabelValue('BAHT')%>
                        <% elsif benefit.basisCd == "RATESA_VESTING" %>
