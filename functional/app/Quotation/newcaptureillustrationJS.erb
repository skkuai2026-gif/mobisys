    function showMonthsDays(){
        $('#months').show();
        $('#days').show();
    }
       
    function hideMonthsDays(){
        $('#months').hide();
        $('#days').hide();
    }


    function getAge(birthDt, fieldId1, fieldId2, fieldId3) {
        age = 0;
        $.ajax({
            url: "/app/Quotation/getAge",
            data: $('#quotationForm').serialize(),
            async:   false,
            headers: {
                'Transition-Enabled': false
            },
            success: function(data) {
                var ageData = $.parseJSON(data);
                ageParts = ageData.split("|");
                $('input[name="'+ fieldId1 +'"]').val(ageParts[0]);
                age = ageParts[0];
                try {
                    $('input[name="'+ fieldId2 +'"]').val(ageParts[1]);
                    $('input[name="'+ fieldId3 +'"]').val(ageParts[2]);
                } catch(e){}
            }
        });
        return age;
    }
       
    function getDOB(age, fieldId){
        $.ajax({
            url: "/app/Quotation/getBirthDt",
            data: $('#quotationForm').serialize() + '&age='+age,
            headers: {
                'Transition-Enabled': false
            },
            success: function(data) {
                $('input[name="'+ fieldId +'"]').val(data);
            }
        });
    }

    function calculateSA(fieldName){
        annualPremium = $("input[name='"+fieldName+"']").val();
        productTypeCdName = fieldName.replace("baseAnnualPremium","productTypeCd");
        productTypeCd = $("input[name='"+productTypeCdName+"']").val();

        if( productTypeCd == "RIDER") {
            productIdName = fieldName.replace("baseAnnualPremium","productId");
            productId = $("input[name='"+productIdName+"']").val();
        }
        else {
            productId = "";
        }
         
        planOptionCdName = fieldName.replace("baseAnnualPremium","productPlanOptionCd");
        planOptionCd = $("select[name='"+planOptionCdName+"']").val();
         
        planCodeName = fieldName.replace("baseAnnualPremium","planCode");
        planCode = $("select[name='"+planCodeName+"']").val();

        modalPremiumName = fieldName.replace("baseAnnualPremium","modalPremium");        
        sumAssured = fetchSumAssured(productId, annualPremium, planOptionCd, planCode, productTypeCd, modalPremiumName);

        updateModalPremiums();

        sumAssuredName = fieldName.replace("baseAnnualPremium","baseSumAssured");
        $("input[name='"+sumAssuredName+"']").val(sumAssured);

        if(productTypeCd == "PLAN") {
            modalId = "PLAN";
        }
        else if ( productTypeCd == "PA" ) {
            modalId = "PA";
        }
        else {
            modalId = productId;        
        }

        if( productTypeCd == "PLAN") {
            updateWOPSA(annualPremium);
        }
    }
      
    function calculatePremium(fieldName){
        sumAssured = $("input[name='"+fieldName+"']").val();
        productTypeCdName = fieldName.replace("baseSumAssured","productTypeCd");
        productTypeCd = $("input[name='"+productTypeCdName+"']").val();
         
        basePlanCode = "";
        planType = "";
        if( productTypeCd == "RIDER") {        
            productIdName = fieldName.replace("baseSumAssured","productId");
            productId = $("input[name='"+productIdName+"']").val();

            if(productId=="PB" || productId=="PBC") {
                // basePlanCode = $("select[name='<%=getObjectMapping(@baseProduct)%>[planCode]']").val();
            }
            // round up PBC sumassured to next 1000
            if (productId=="PBC") {          
                sumAssured = Math.ceil(sumAssured / 1000) * 1000;
                $("input[name='"+fieldName+"']").val(sumAssured);                      
            }
            if (productId=="RPTDB") {
                sumAssured = $("input[name='<%=getObjectMapping(@baseProduct)%>[baseAnnualPremium]']").val();
            }
        }
        else {
            planTypeName = fieldName.replace("baseSumAssured","productFamilyCd");
            planType = $("select[name='"+planTypeName+"']").val();
            productId = "";          
        }

        planOptionCdName = fieldName.replace("baseSumAssured","productPlanOptionCd");
        planOptionCd = $("select[name='"+planOptionCdName+"']").val();

        planCodeName = fieldName.replace("baseSumAssured","planCode");
        planCode = $("select[name='"+planCodeName+"']").val();

        if (planCode === undefined || planCode == "") {
            planCode = $("input[name='"+planCodeName+"']").val();
        }

        termName = fieldName.replace("baseSumAssured","productTerm");
        term = $("select[name='"+termName+"']").val();

        premiumPayingTermName = fieldName.replace("baseSumAssured","premiumPayingTerm");
        premiumPayingTerm = $("select[name='"+premiumPayingTermName+"']").val();

        if (productId=="RPTDB") {
            term = $("select[name='<%=getObjectMapping(@baseProduct)%>[premiumPayingTerm]']").val();
            premiumPayingTerm = $("select[name='<%=getObjectMapping(@baseProduct)%>[premiumPayingTerm]']").val();
        }

        currencyCdName = fieldName.replace("baseSumAssured","currencyCd");
        currencyCd = $("select[name='" + currencyCdName+"']").val();

        modalPremiumName = fieldName.replace("baseSumAssured","modalPremium");
        premium = fetchPremium(productId, sumAssured, planOptionCd, planCode, productTypeCd, basePlanCode, modalPremiumName, planType, term, premiumPayingTerm, currencyCd);

        updateModalPremiums();

        if(productTypeCd == "PA") {
            premium = Math.round(premium);
        }

        premiumName = fieldName.replace("baseSumAssured","baseAnnualPremium");
        $("input[name='"+premiumName+"']").val(premium);

        if(productTypeCd == "PLAN") {
            modalId = "PLAN";
        }
        else if ( productTypeCd == "PA" ) {
            modalId = "PA";
        }
        else {
            modalId = productId;        
        }

        if( productTypeCd == "PLAN") {        
            updateWOPSA(premium);
        }

        if( productTypeCd == "RIDER" && (productId == "AI" || productId == "ADD")) {
            sumAssured = fetchDependantSAPR(productId, 5000000);
            riderSelectedObject = $('fieldset[name="rider_RCC'+productId+'"] > div > div > input[name*="selected"]');
            riderObject = $('fieldset[name="rider_RCC'+productId+'"] > div > input[name*="baseSumAssured"]');
            if ( riderSelectedObject.is(':checked')) {          
               riderObject.val(sumAssured);
                riderObject.blur();
            }
        }
           
    }
       
    function fetchPremium(productId, sumAssured, planOptionCd, planCode, productTypeCd, basePlanCode, modalPremiumName, planType, term, premiumPayingTerm, currencyCd) {
        if (productId == "PB" || productId == "PBC") {        
            age = $('input[name="<%=getObjectMapping(@quotation)%>[proposerAge]"]').val();
            genderCd = $('input[name="<%=getObjectMapping(@quotation)%>[proposerGenderCd]"]').filter(':checked').val();
            occupationClass = $('select[name="<%=getObjectMapping(@quotation)%>[occupationCd]"]').val();          
        }
        else {
            age = $('input[name="<%=getObjectMapping(@quotation)%>[age]"]').val();
            genderCd = $('input[name="<%=getObjectMapping(@quotation)%>[genderCd]"]').filter(':checked').val();
            occupationClass = $('select[name="<%=getObjectMapping(@quotation)%>[occupationCd]"]').val();
            smoker = $('input[name="<%=getObjectMapping(@quotation)%>[smoker]"]').filter(':checked').val();
       
            if (age <= 15 && (productId == "ADD" || productTypeCd == "PA")) {        
            occupationClass = JUVENILEOCCUPATIONCLASSFORPA;
            }          
        }  
             
        premium = 0;        
        if ( age != "" && genderCd != "" && genderCd!==undefined && occupationClass != "" && sumAssured != "" && (productId != "" || planCode != "") && (planCode !== undefined || planOptionCd !== undefined) && smoker != "") {
            ajaxURL = "/app/Quotation/getPremium";
            premiumGuarantee = 0;
            premiumSplit = 0;
            if (planType == "HYBRID") {
                ajaxURL = "/app/Quotation/getHybridPremium";
                premiumGuarantee = $('input[name="<%=getObjectMapping(@baseProduct)%>[premiumGuarantees]"]').val();
                premiumSplit = $('input[name*="[premiumSplit]"]').val();
            }
         
            $.ajax({
                url: ajaxURL,
                data: {
                    'age': age, 
                    'genderCd': genderCd, 
                    'occupationClass': occupationClass, 
                    'productId': productId, 
                    'sumAssured': sumAssured, 
                    'planOptionCd':planOptionCd, 
                    'planCode': planCode, 
                    'basePlanCode': basePlanCode, 
                    'premiumGuarantee':premiumGuarantee, 
                    'premiumSplit':premiumSplit, 
                    'term':term, 
                    'premiumPayingTerm':premiumPayingTerm, 
                    'smoker':smoker, 
                    'currenyCd':currencyCd
                },
                headers: {
                    'Transition-Enabled': false
                },
                success: function(data) {
                    var premiumSAData= $.parseJSON(data);
                    modalPremiums = premiumSAData+"|"+modalPremiumName;
                    try {
                        premium = modalPremiums.split("|")[0];
                    } 
                    catch (e){ alert("premium error"); premium = 0; }                          
                     
                    try {
                       if (productTypeCd == "PLAN") {
                         modalPremiumsList["PLAN"] = modalPremiums;
                       }
                       else if (productTypeCd == "PA") {
                         modalPremiumsList["PA"] = modalPremiums;
                       }
                       else {
                            if(productId=="") {
                                modalPremiumsList[planCode] = modalPremiums;
                            }
                            else {
                                modalPremiumsList[productId] = modalPremiums;
                            }
                        }
                    }
                    catch(e){alert(e);}
                },
                async:   false
            });

        }
        return premium;
    }
       
    function fetchSumAssured(productId, annualPremium, planOptionCd, planCode, productTypeCd, modalPremiumName){
        age = $('input[name="<%=getObjectMapping(@quotation)%>[age]"]').val();
        genderCd = $('input[name="<%=getObjectMapping(@quotation)%>[genderCd]"]').filter(':checked').val();
        occupationClass = $('select[name="<%=getObjectMapping(@quotation)%>[occupationCd]"]').val();
        smoker = $('input[name="<%=getObjectMapping(@quotation)%>[smoker]"]').filter(':checked').val();
        sumAssured = 0;        
        if ( age != "" && genderCd != "" && genderCd!==undefined && occupationClass != "" && annualPremium != "" && (productId != "" || planCode != "") && smoker != "") {
            $.ajax({
                url: "/app/Quotation/getSumAssured",
                data: {
                    'age': age, 
                    'genderCd': genderCd, 
                    'occupationClass': occupationClass, 
                    'productId': productId, 
                    'annualPremium': annualPremium, 
                    'planOptionCd':planOptionCd, 
                    'planCode': planCode, 
                    'smoker':smoker
                },
                headers: {
                    'Transition-Enabled': false
                },
                success: function(data) {
                    var premiumSAData= $.parseJSON(data);
                    modalPremiums = premiumSAData+"|"+modalPremiumName;
                     
                    try {
                        sumAssured = modalPremiums.split("|")[0];
                    }
                    catch (e){ alert("premium error"); sumAssured = 0; }
                       
                    try {
                        if (productTypeCd == "PLAN") {
                            modalPremiumsList["PLAN"] = modalPremiums;
                        }
                        else if (productTypeCd == "PA") {
                            modalPremiumsList["PA"] = modalPremiums;
                        }
                        else {
                            if(productId=="") {
                                modalPremiumsList[planCode] = modalPremiums;
                            }
                            else {
                                modalPremiumsList[productId] = modalPremiums;
                            }
                        }
                    }catch(e){alert(e);}
                },
                async:   false
            });
        }
        return sumAssured;
    }

