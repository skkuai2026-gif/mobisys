    $(document).ready(function(){
        <% if @errors.to_s != "" %>
            var data = '<%= @errors %>';
            getErrors(data);
        <% end %>


        $('.scrollTopButton').click(function() {
            $("html, body").animate({ scrollTop: 0 }, "slow");
        });

        $('.expandButton').hide();

        $('.collapseButton').click(function() {
            $(this).parents(".legend").siblings(".panelContent").hide();
            $(this).hide();
            $(this).siblings('.expandButton').show();
        });

        $('.expandButton').click(function() {
            $(this).parents(".legend").siblings(".panelContent").show();
            $(this).hide();
            $(this).siblings('.collapseButton').show();
        });

        /* Using custom settings */
        $("a#premiumId").fancybox({
            href: '#premium',
            height: '70%',
            width: '90%'
        });

        $("a[name='viewIllustration']").click( function() {
            <% if @quotation.signature == nil || @quotation.signature == "" %>
                document.quotationForm.action="viewIllustration";
                submitForm();
            <% else %>
                viewIllustrationClick();
            <% end %>
        });

        <% if @msg != nil && @msg != ""
            if @msg == "SUCCESS" %>
                showDialog("", "<%= getLabelValue(@msg)%>", 'success', 0, 'capture');
            <% else %>
                showDialog("", "<%= getLabelValue(@msg)%>", 'error', 0, 'capture');
            <% end %>
        <% end %> 

        $(".adjustWidth").children().each(function(index,value){ $(value).css('width',(100/$(".adjustWidth").last().children().size()).toString()+"%") });

        $('select[name*="[partyRoleCd]"]').each(function(){
            if (this.value != "SUPPLEMENTARY")
             name = this.name
             insuredPartyRef = name.replace("partyRoleCd","insuredPartyRefGuid");
             $('select[name="'+insuredPartyRef+'"]').val('Select Life').change();
             $('select[name="'+insuredPartyRef+'"]').selectmenu('disable');
        });

        setReadOnly($("input[name='<%=getObjectMapping(@quotation)%>[quotationRefNum]']"), true);

        $("span[name='quotationDt']").attr('disabled','disabled');

        updatePremiums();
        renderLegends();
         
        <% if @msg == "ERROR" %>
