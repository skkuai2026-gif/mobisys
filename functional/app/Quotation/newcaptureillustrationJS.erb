    function checkRecordExists(){
        returnValue = true;        
        salesIllustrationCd = $("input[name='<%=getObjectMapping(@quotation)%>[quotationRefNum]']").val();
        guid = $("input[name='<%=getObjectMapping(@quotation)%>[guid]']").val();
        if ( salesIllustrationCd != "") {
               
            $.ajax({
                url: "/app/Quotation/checkQuotationRefNum",
                data: {'quotationRefNum': salesIllustrationCd, 'guid': guid},
                headers: {
                    'Transition-Enabled': false
                },
                success: function(data) {
                    var result=$.parseJSON(data);
                    try {
                        if (result == "ALLOWSAVE") {
                            returnValue = true;
                        }
                        else {
                            returnValue = false;
                        }
                    }catch(e){alert(e);}
                },
                async: false                    
            });          
        }
         
        if(!returnValue){
            showDialog("", "<%= getLabelValue('OVERWRITE')%>", 'error', 0, 'capture');          
            returnValue = false;
        }
         
        return returnValue;
    }

    function renderLegends(){
        $('input[name*="state_"]').each(function(i){
            if ( $(this).val() == "+") {
                divName = this.name.replace("state_","");
                $('div[name="'+divName+'"]').hide();
            }
        });
    }
      
    
    function updateFundModels()
    {
        currencyCd = $("select[name='<%= getObjectMapping(@baseProduct)%>[currencyCd]']").val();
        productSeq = $("select[name='<%= getObjectMapping(@baseProduct)%>[productSeq]']").val(); 
        $.ajax({
            url: "/app/Quotation/filterPortfolioModel",
            data: {'currencyCd': currencyCd, 'productSeq': productSeq},
            headers: {
                'Transition-Enabled': false
            },
            success: function(data) {
                $("select[name='<%= getObjectMapping(@baseProduct)%>[portfolioModelCd]']").html(data);
                $("select[name='<%= getObjectMapping(@baseProduct)%>[portfolioModelCd]']").change();
            }
        });
    }

    $.fn.fieldexists = function() {
        if(typeof this[0] != 'undefined') {
            return true; 
        } else {
            return false;
        }
    }

    $.fn.selectit = function(option) {
        $("select[name='"+this.attr('name')+"'] option:eq("+option+")")[0].selected = true;
        this.selectmenu().selectmenu("refresh",true);
    }

