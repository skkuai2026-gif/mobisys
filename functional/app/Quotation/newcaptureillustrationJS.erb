    function updateModalPremium(mode, field, id){
        modalPremiums = modalPremiumsList[id];
        if(modalPremiums !== undefined && modalPremiums != "") { 
            modalPremiumsSplit = modalPremiums.split("|");
            modalPremium = 0;

            if(mode == "YEARLY"){
                modalPremium = modalPremiumsSplit[1];
            } 
            else if(mode == "HALFYEARLY") {
                modalPremium = modalPremiumsSplit[2];
            }
            else if(mode == "QUARTERLY") {
                modalPremium = modalPremiumsSplit[3];
            }
            else if(mode == "MONTHLY") {
                modalPremium = modalPremiumsSplit[4];
            }
           
            try {
                $("input[name='"+field+"']").val(modalPremium);
            }catch(e){alert("error while updating premium:"+e);}
        }
    }

    function updatePremiums() {
        $('input[name*="[baseAnnualPremium]"]').each( function(){
            premium = this.value;
            if(premium != "") {
                productIdName = this.name.replace("baseAnnualPremium","productId");
                productId = $("input[name='"+productIdName+"']").val();
                if(productId === undefined) {
                    productId = $("select[name='"+productIdName+"']").val();
                }
                productTypeCdName = this.name.replace("baseAnnualPremium","productTypeCd");
                productTypeCd = $("input[name='"+productTypeCdName+"']").val();

                modalPremiumName = this.name.replace("baseAnnualPremium","modalPremium");
                fetchModalPremiums(productId, productTypeCd, premium, modalPremiumName);
            }
        });
        updateModalPremiums();
    }
       
    function fetchModalPremiums(productId, productTypeCd, annualPremium, modalPremiumName){
        if ( annualPremium != "" && productId != "") {
            $.ajax({
                url: "/app/Quotation/getModalRates",
                data: {'productId': productId, 'annualPremium': annualPremium},
                headers: {
                    'Transition-Enabled': false
                },
                success: function(data) {
                    var premiumSAData= $.parseJSON(data);
                    modalPremiums = premiumSAData+"|"+modalPremiumName;
                    try {
                        if (productTypeCd == "PLAN") {
                            modalPremiumsList["PLAN"] = modalPremiums;
                        }
                        else if (productTypeCd == "PA") {
                            modalPremiumsList["PA"] = modalPremiums;
                        }
                        else {
                            modalPremiumsList[productId] = modalPremiums;
                        }
                    }catch(e){alert(e);}
                },
                async: false
            });
        }
    }
       
    function enableDependantRider(rider) {
         
    }
       
    function disableDependantRider(rider) {
        clickRiderObject = $('fieldset[name="rider_'+rider+'"] > div > div > input[name*="selected"]');
        if(clickRiderObject.is(':checked')){
            clickRiderObject.click();
            riderObject = $('fieldset[name="rider_'+rider+'"] > div > div > input[name*="selected"]');
            labelName = riderObject.attr("name");
            if ($("label[for='"+labelName+"']").hasClass("ui-checkbox-on")) {
                $("label[for='"+labelName+"']").removeClass("ui-checkbox-on");
                $("label[for='"+labelName+"']").addClass("ui-checkbox-off");
            }
           
            $("label[for='"+labelName+"']").children("span").children("span").each(function(i) {
                if($(this).hasClass("ui-icon-checkbox-on")) {
                    $(this).removeClass("ui-icon-checkbox-on");
                    $(this).addClass("ui-icon-checkbox-off");
                }                            
            });
        }
         
        $('fieldset[name="rider_'+rider+'"]').hide();
         
    }

    function fetchDependantSAPR(rider, maxSA) {
        riderObject = $('fieldset[name="rider_'+rider+'"] > div > div > input[name*="selected"]');
        sumAssured = 0;
        if (riderObject.is(':checked')) {
            labelName = riderObject.attr("name");
            sumAssuredName = labelName.replace("selected","baseSumAssured");
            sumAssured = $("input[name='"+sumAssuredName+"']").val();
        }
       
        if (sumAssured > maxSA) {
            sumAssured = maxSA
        }
        return sumAssured;
    }

    function updateWOPSA(annualPremium) {        
        riderObject = $('fieldset[name="rider_PB"] > div > input[name*="baseSumAssured"]');
        riderObject.val(annualPremium);
        riderObject.each( function(i) {
            calculatePremium(this.name);  
        });      
    }

    function updatePBCPremium(){
        riderObject = $('fieldset[name="rider_PBC"] > div > input[name*="baseSumAssured"]');
        if(riderObject.val() != "") {
            riderObject.blur();
        }
    }
       
    function submitForm(){
        $("a[name='save']").focus();
        if(checkBasicDetails() && checkRecordExists()) {
            showLoadingMessage();
           // # enable the disabled field so that value gets submitted. Field is disabled for juvenile cases
            $('select[name="<%=getObjectMapping(@baseProduct)%>[productFamilyCd]"]').selectmenu('enable');
            $('select[name="<%=getObjectMapping(@baseProduct)%>[productPlanOptionCd]"]').selectmenu('enable');
            $('select[name="<%=getObjectMapping(@baseProduct)%>[productId]"]').selectmenu('enable');
            $('select[name="<%=getObjectMapping(@baseProduct)%>[paymentFrequencyCd]"]').selectmenu('enable');
            $('select[name="<%=getObjectMapping(@baseProduct)%>[premiumPayingTerm]"]').selectmenu('enable');

            $('select[name="<%=getObjectMapping(@policyHolder)%>[partyTypeCd]"]').selectmenu('enable');
            $('select[name="<%=getObjectMapping(@insured)%>[title]"]').selectmenu('enable');
            $('select[name="<%= getObjectMapping(@insured)%>[relationCd]"]').selectmenu('enable');
            $("select[name='<%= getObjectMapping(@insured)%>[industryCd]']").selectmenu('enable');
            $("select[name='<%= getObjectMapping(@insured)%>[natureOfDuty]']").selectmenu('enable');
            $('select[name="<%= getObjectMapping(@insured)%>[occupationCd]"]').selectmenu('enable');
            $('input[name="<%= getObjectMapping(@insured)%>[genderCd]"]').checkboxradio('enable');
            $('input[name="<%= getObjectMapping(@insured)%>[smoker]"]').checkboxradio('enable');

            $('select[name="<%= getObjectMapping(@baseProduct)%>[targetPeriodRefCd]"]').selectmenu('enable');
            $('select[name="<%= getObjectMapping(@quotation)%>[solverTypeCd]"]').selectmenu('enable');
            $('select[name="<%= getObjectMapping(@quotation)%>[withdrawalRateTypeCd]"]').selectmenu('enable');
            $('select[name="<%= getObjectMapping(@baseProduct)%>[premiumOffsetOptionCd]"]').selectmenu('enable');
            $('select[name="<%= getObjectMapping(@baseProduct)%>[premiumOffsetValues]"]').selectmenu('enable');

            //set removed flag YES for all withdrawls if withdrawls set to NO
            withdrawalFl = $('input[name="<%= getObjectMapping(@quotation) %>[withdrawalFl]"]');
            if (withdrawalFl.fieldexists()){
                if (withdrawalFl.filter(':checked').val() == "NO"){
                    $('#withdrawalsList input[name*="[removed]"]').val('YES');
                }
            }
            // # submit form
            document.quotationForm.submit();          
        }  
    }

