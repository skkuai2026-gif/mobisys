            $('span[id="errordiv"]').hide();
        <% end %>

        <% 
        if @mandatoryFields
            if @mandatoryFields[@quotation]
                @mandatoryFields[@quotation].each do |field| 
            
        %>
                $("label[for='<%=getObjectMapping(@quotation)%>[<%= field %>]']").append('<label for=" *" class="mandatory1">&nbsp;*</label>');
        <% 
                end
            end

            if @mandatoryFields[@baseProduct]
                @mandatoryFields[@baseProduct].each do |field| 
        %>
                $("label[for='<%=getObjectMapping(@baseProduct)%>[<%= field %>]']").append('<label for=" *" class="mandatory1">&nbsp;*</label>');
        <% 
                end
            end
          
        end
        %>

    });

//==========document ready ends==============
