<script type="text/javascript">
var oldAgeValue = "";
    function scrollToTop() {
        verticalOffset = typeof(verticalOffset) != 'undefined' ? verticalOffset : 0;
        element = $('body');
        offset = element.offset();
        offsetTop = offset.top;
        $('html, body').animate({scrollTop: offsetTop}, 500, 'linear');
    }

    $(function(){
        $(document).scroll(function(){
            if ($(window).scrollTop() > 100) {
                $('.scroll-top-wrapper').addClass('show');
            } else {
                $('.scroll-top-wrapper').removeClass('show');
            }
        });

        $('.scroll-top-wrapper').click(function(){
            scrollToTop();
        });
    });

    $(document).focus(function() {
        setTimeout("onFocus()", 100);
    });
       
    function attachInputMasks() {         
        $("input[name='<%=getObjectMapping(@baseProduct)%>[baseSumAssured]']").maskMoney();
    }

    function getErrors(data){
        if (data!="null") {
            var parsedJSON = JSON.parse(data);
            var objectName = "";
            var field = null;
            var label = null;
            var errorsExist = false;
            
            /*Refresh Contents of the error dialog start*/
            var errorData = "<ul>";
            $.each(parsedJSON, function(objectClass, errorObject) {
                objectClass = objectClass.replace("DO", "");
                $.each(errorObject, function(guid, fieldObject) {
                    if (!jQuery.isEmptyObject(fieldObject)) {
                        errorsExist = true;
                        $.each(fieldObject, function(fieldName, errorMessage) {
                            $.each(errorMessage, function(errIndex, message) {
                                errorData += "<li>" + message + "</li>";
                            });
                        });

                        /*Map labels of error fields to the error dialog start*/
                        //Get object id based on guid and classname
                        objectName = $("input[value='"+guid+"'][name*='[guid]'][name*='"+objectClass+"']").attr('name');
                        if (objectName != undefined) {
                            $.each(fieldObject, function(fieldName, errorMessage) {
                                //Get field based on object id and fieldname
                                field = $("[name='"+objectName.replace("guid", fieldName)+"']");
                                if (field.length != 0) {
                                    //Add info icon and click event listeners to label
                                    label = $("label[for='"+objectName.replace("guid", fieldName)+"']");
                                    if(label.length==0) {
                                        label = $("div[name='"+objectName.replace("guid", fieldName)+"']");
                                        label.append("<a href='#' class='ui-btn error_icon ui-btn-icon-notext ui-corner-all ui-btn-inline ui-alt-icon error' style='border-style:none;'></a>");
                                        label = label.find("a");

                                    }
                                    else {
                                        label.addClass("ui-alt-icon");
                                        label.addClass("error_icon");
                                        label.addClass("ui-btn-icon-notext");
                                        label.addClass("error-field");
                                    }
                                    
                                    //Make a list of errors on field
                                    var fieldErrors = "";
                                    $.each(errorMessage, function(errIndex, message) {
                                        fieldErrors += "<li>" + message + "</li>";
                                    });
   
                                    label.click(function(){
                                        $("#singleErrorDiv").html("<ul>" + fieldErrors + "</ul>");
                                        if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                                            $("<div>").simpledialog2({
                                                mode : 'blank',
                                                blankContent : $("#singleErrorDiv").html() + "<a rel='close' data-role='button' href='#'>Close</a>"
                                            });
                                        }
                                    });
                                }
                            });
                        }
                    }
                });
            });
            errorData += "</ul>";
            $("#totalErrorDiv").html(errorData);
            if (errorsExist) {
                $('span[id="errordiv"]').show();
            }
        }
    }

    var deviceHeight =  $( window ).height() - 100;
    $(document).delegate('#error_dialog', 'click', function() {
        $("div[data-role='page']").css('overflow', 'hidden');
        window.scrollTo(0, 0);
        $(this).simpledialog2({
            mode : 'blank',
            style: "width: 629px",
            blankContent : $("#totalErrorDiv").html() + "<a rel='close' id ='error_close' data-role='button' href='#'>Close</a>"
        });

        $('.ui-simpledialog-container').css('max-height','450px');
        h = parseInt($('.ui-simpledialog-container').css('height').replace('px',''));
        if(h > deviceHeight || h == 450){        
            $('.ui-simpledialog-container').css('overflow-y','auto');
        }
    });
        
    $(document).delegate('#error_close', 'click', function() {
        $("div[data-role='page']").css('overflow', 'auto');          
    });
       
    function updateAllProducts(reset) {         
        if(reset) {
            $('input[name*="[baseSumAssured]"]').val("");
            $('input[name*="[baseAnnualPremium]"]').val("");
            $('input[name*="[modalPremium]"]').val("");
        }
        else {
            setReadOnly($("input[name='Quotation[QuotationProduct][0][baseSumAssured]']"), false);
        }
        modalPremiumsList = new Array();
        updateProducts(reset);        
        updateModalPremiums();
    }
       
    function renderHybridDetails(planCode, age, genderCd, occupationClass) {
        quotationProductObjectName = '<%= getObjectMapping(@baseProduct) %>';
        $.ajax({
            url: "/app/Quotation/addHybridDetails",
            data: {
                'age': age, 
                'genderCd': genderCd, 
                'occupationClass': occupationClass, 
                'planType': 'HYBRID',
                'planCode': planCode, 
                'quotationProductObject': '<%= @baseProduct.object.to_s %>', 
                'quotationProductObjects': objectCount, 
                'quotationProductObjectName':quotationProductObjectName, 
                'quotationObject': '<%= getObjectMapping(@quotation)%>'
            },
            success: function(data) {
                $('div[name="hybridInformation"]').html("");
