				$(this).val('');
				$(this).focus();
			} 
		});

		// For sign to save in Json format
		// $('.sigPad').signaturePad({drawOnly:true});
		var output = $('.sigPad input').val().replace(/'/g,'"');
        // console.log(output);
        input = $('.sigPad').signaturePad({drawOnly:true,output:".output_old",
            onDrawEnd:function(){
                var string = input.getSignatureString().replace(/\"/g,"'");
                // console.log(string)
                $('.sigPad input').val(string);
            }});
        if(output!="")
        input.regenerate(output);
        $('.sigPad a[href="#clear"]').click(function(){
            $('.sigPad input').val("");
        });
	});
	
	
