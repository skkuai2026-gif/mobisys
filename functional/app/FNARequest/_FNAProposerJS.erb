	function submitForm(){
		//Used to trim all the input fields before save
		$(':input').each(function(){
				$(this).val($.trim($(this).val()))
		});

		if ($('input[id= "<%=getObjectMapping(@fnaRequest)%>[nonDisclosureofAssets]"]').val() != ""){
			// console.log("Sign is present")
			var sigImg = $('canvas[id= "<%=getObjectMapping(@fnaRequest)%>[nonDisclosureofAssets]_canvas"]').get(0).toDataURL();
			// console.log("sigImg " + sigImg );
			$("input[id='<%=getObjectMapping(@fnaRequest)%>[witnessSignature]']").val(sigImg);
		}
		else{
			// console.log("Sign is absent")
			$("input[id='<%=getObjectMapping(@fnaRequest)%>[witnessSignature]']").val("");
		}

	
		// if(initialFnaInputForm != $('#fnaInputForm').serialize()) {
		// Ashwini:24-07-2017: Submit Basic details every time to trigger the validations
		<% if @fnaRequest.statusCd == "FNAPENDING" %>
			$.ajax({                                    
					url: "/app/FNARequest/submitBasicDetails",
					method: 'POST',
					async: false,
					data: $('#fnaInputForm').serialize(),
					headers: {
							'Transition-Enabled': false
					},
					success: function(data) {
					   var taberrors = data;
                       errorsData = taberrors.split("|");
                       errorsExist = errorsData[0];
                       warningsExist = errorsData[1];
                       warnings = errorsData[2]; 
                       $("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField3Str]']").val(errorsExist); 
                       $("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField4Str]']").val(warningsExist); 
                        var errorData = "";
                        $.each($.parseJSON(warnings), function(fieldName, errorMessage) {
                            $.each(errorMessage, function(errIndex, message) {
                                $.each(message, function(Index, msg) {
                                    errorData += "<div><br>" + msg + "</div>";
                             });
                         });
                      });
                        $("div[id= 'error-container']").html(errorData);
                        $("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField5Str]']").val(errorData);;
                        // console.log("errorData" +errorData);
                        if (warningsExist == "true") {
	                        $("<div>").simpledialog2({
	                          	mode: 'blank',
	                          	blankContent: $("#error-container").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_OK") %>' + "</a>"
	                      	});
	                    }
	                        
                    $("a#submit").hide();
					}
			});
	  	// }
	  	<% end %>
	}

