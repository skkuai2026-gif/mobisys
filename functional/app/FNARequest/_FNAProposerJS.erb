	function numbersonly(evt){
		var charCode = (evt.which) ? evt.which : event.keyCode
		if (charCode > 31 && (charCode < 48 || charCode > 57))
			return false;
		return true;
	}

	function getAgeMethod(object){
		
		var birthDt = object.value;

		$.ajax({                                    
			url: "/app/FNARequest/getAge",
			method: 'POST',
			async: false,
			data: {'birthDt': birthDt},
			headers: {
					'Transition-Enabled': false
			},
			success: function(data) {
				console.log("data: " + data);
	            ageParts = data.split("|");
	            var age = ageParts[0].replace(/"/g,"");

				if (age<0){
		          	var dialogContent = '<span>'+"<%= getLabelValue('ERR_DOB') %>"+'</span>';
		            $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
		            if (typeof $.mobile.sdCurrentDialog === 'undefined') {
		            $("<div>").simpledialog2({
		                mode : 'blank',
		                blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
		                });
		            }
					// showDialog("", "<%#= getLabelValue('ERR_DOB') %>", 'warning', 0, 'capture');
					$("input[id='<%= getObjectMapping(@fnaProposer) %>[age]']").val(null);
					$("input[id='<%= getObjectMapping(@fnaProposer) %>[birthDt]']").val(null);
				} else if(age<18){
		          	var dialogContent = '<span>'+"<%= getLabelValue('ERR_AGE_MORETHAN_18') %>"+'</span>';
		            $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
		            if (typeof $.mobile.sdCurrentDialog === 'undefined') {
		            $("<div>").simpledialog2({
		                mode : 'blank',
		                blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
		                });
		            }
					// showDialog("", "<%#= getLabelValue('ERR_AGE_MORETHAN_18') %>", 'warning', 0, 'capture');
					$("input[id='<%= getObjectMapping(@fnaProposer) %>[age]']").val(null);
					$("input[id='<%= getObjectMapping(@fnaProposer) %>[birthDt]']").val(null);

				} else{
					$("input[id='<%= getObjectMapping(@fnaProposer) %>[age]']").val(age);
					$('label[for="<%=getObjectMapping(@fnaProposer)%>[age]"]').css("top", "-10px");
					$('label[for="<%=getObjectMapping(@fnaProposer)%>[age]"]').css("font-size", "14px");
					$('label[for="<%=getObjectMapping(@fnaProposer)%>[birthDt]"]').css("top", "-10px");
					$('label[for="<%=getObjectMapping(@fnaProposer)%>[birthDt]"]').css("font-size", "14px");
				}
			}
	});

	}
