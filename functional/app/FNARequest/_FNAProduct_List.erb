<link rel="stylesheet" href="/public/css/FNA/shame.css">
<form method="POST" action="<%= url_for :action => :submitProductListDetails %>" name="productListForm" id="productListForm">
    <%= renderObject(@fnaRequest) %>
    <style>
      .checkbox { position: relative; }
      .button_UI {
        background-color:#efbc33!important;
        border-radius: 7px;
        border-style: none;
        color: #003946 !important;
        display: inline-block;
        font-size: 14px !important;
        max-width: 200px;
        margin: 0;
        text-shadow: none !important;
        font-weight: 700;
        text-align: center;
        line-height: 1.3;
        width: 100px;
      }
      .set-border{
          border-left: 1px solid black;
          padding: 15px;
        }
      .align-product{
        vertical-align: top;
        padding-top: 35px;
      }
    .alternate-products-hide-on-load{
    display:none;
    }
    </style>

    <input type="hidden"  id ="changeProductFrom" name="changeProductFrom" value=""/>
    <input type="hidden"  id ="statuscode" name="statuscode" value="<%= @fnaRequest.addtnField1Str %>"/>
    <div class="illustrationdisplay">
      <div class="tabs-content">
        <div class="card" style="margin-top:15px;"> 
          <div name ="FnaProductSelectionProduct" id ="FnaProductSelectionProduct">
            <%= render(:partial => 'FNAProduct_List_Product_selected')%>
          </div><br/><br/>
        </div>
      </div>
    </div>

<!-- Ashwini:01-09-2017: Added Alternate Tab HIDE/SHOW for ILAS products -->
    <div class="tabs">
        <div style="width: 45%;">
        <a href="#" id="products-recommended"><p class="active"><%= getLabelValue('RECO_PROD_OPT') %></p></a>
      </div>
      <%if $contains_ILAS_Product_q1 && $contains_ILAS_Product_q2%>
        <div style="width: 45%;">
          <a href="#" id="alternate-products"><p><%= getLabelValue('ONLY_ALT_PROD_OPT') %></p></a>
        </div>
        <%end%>
    </div>

    <div id="recommended-products-hide" >           
    <div class="illustrationdisplay">
          <div class="tabs-content">
            <div class="card" style="margin-top:50px;border-top:5px solid #eaab00;"> 
                <div id="fna-recommended-products"> <%= render(:partial => 'FNAProducts_Recommended')%></div>
            </div></div>
          </div>
    </div>
    <%if $contains_ILAS_Product_q1 && $contains_ILAS_Product_q2%>
    <div id="alternate-products-hide">
    <div class="illustrationdisplay alternate-products-hide-on-load">
          <div class="tabs-content">
            <div class="card" style="margin-top:50px;border-top:5px solid #eaab00;"> 
                <div id="fna-alternate-products" > <%= render(:partial => 'FNAAlternate_Products')%></div>
            </div></div>
          </div>
    </div>
    <%end%>
    <%= render :partial => "FNAProduct_ListJS" %>
</form>


<div class="" data-role="dualfieldcontain" align="">
  <div class="">
    <div class="group" style="font-size:14px;">
        <%= getLabelValue('INSTRUCTION_TEXT_PRODUCT_INTRODUCTION') %>
    </div>
  </div>     
</div>
