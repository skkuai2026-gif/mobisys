  $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[retirementAge]"]').blur(function(){
    var retirementAge = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[retirementAge]"]').val().replace(/,/g , "");
    var ageExpectancy = $('select[name="<%=getObjectMapping(@fnaRetirementNeed)%>[ageExpectancy]"]').val();
    if (retirementAge ==  "" || retirementAge == null){
      $('input[name ="RET_AGE"]').val('0');
      $('input[name ="EXPECTED_RET_PERIOD"]').val(format("#,##0.##",ageExpectancy));
      $('input[name="YRS_TO_RETIREMENT"]').val('0');
    } 
    else{
      var ageExpectancy = $('select[name="<%=getObjectMapping(@fnaRetirementNeed)%>[ageExpectancy]"]').val();
    var expectedretperiod= parseInt(ageExpectancy) - parseInt(retirementAge) ;
     if (expectedretperiod < 0){
       var expectedretperiod = 0;
     }
     $('input[name ="RET_AGE"]').val(format("#,##0.##",retirementAge));
     $('input[name ="EXPECTED_RET_PERIOD"]').val(format("#,##0.##",expectedretperiod));
     $('input[name="YRS_TO_RETIREMENT"]').val(format("#,##0.##",retirementAge));
     }
    var currentAge = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[currentAge]"]').val().replace(/,/g , "");
     if (!currentAge){
     var currentAge = 0;
     }
     var yearstoretire = parseInt(retirementAge) - parseInt(currentAge) ;
     if (yearstoretire < 0){
      var yearstoretire = 0;
     }
     if (retirementAge ==  "" || retirementAge == null){
      $('input[name="YRS_TO_RETIREMENT"]').val('0');
     }else{
     $('input[name="YRS_TO_RETIREMENT"]').val(format("#,##0.##",yearstoretire));
   }
   });


