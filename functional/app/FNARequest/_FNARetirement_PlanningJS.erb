function calculateretirementplanningneeds(){
    var inflationRate = $('input[name="<%=getObjectMapping(@fnaRequest)%>[inflationRate]"]').val().replace(/,/g , "");
    var returnRate = $('input[name="<%=getObjectMapping(@fnaRequest)%>[returnRate]"]').val().replace(/,/g , "");
    var monthlyExpensesPVAmt = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[monthlyExpensesPVAmt]"]').val().replace(/,/g , "");
    var currentAge = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[currentAge]"]').val().replace(/,/g , "");
    var yearstoretire =  $('input[name="YRS_TO_RETIREMENT"]').val().replace(/,/g , "");
    var expectedretperiod =  $('input[name ="EXPECTED_RET_PERIOD"]').val().replace(/,/g , "");
    var futureContributionAmt = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[futureContributionAmt]"]').val().replace(/,/g , "");
    var futureContributionRate = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[futureContributionRate]"]').val().replace(/,/g , "");
    var accumulatedAmt = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[accumulatedAmt]"]').val().replace(/,/g , "");
    var accumulatedRate = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[accumulatedRate]"]').val().replace(/,/g , "");
    var otherMontlySavingsAmt = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[otherMontlySavingsAmt]"]').val().replace(/,/g , "");
    var otherMontlySavingsRate = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[otherMontlySavingsRate]"]').val().replace(/,/g , "");
    var otherLumpsumAmt = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[otherLumpsumAmt]"]').val().replace(/,/g , "");
    var otherLumpsumRate = $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[otherLumpsumRate]"]').val().replace(/,/g , "");

    calculateFnaRetirementPlanningNeeds(inflationRate, returnRate, monthlyExpensesPVAmt, currentAge, yearstoretire, expectedretperiod, futureContributionAmt, futureContributionRate, accumulatedAmt, accumulatedRate, otherMontlySavingsAmt, otherMontlySavingsRate, otherLumpsumAmt, otherLumpsumRate)   
    }


  function calculateFnaRetirementPlanningNeeds(inflationRate, returnRate, monthlyExpensesPVAmt, currentAge, yearstoretire, expectedretperiod, futureContributionAmt, futureContributionRate, accumulatedAmt, accumulatedRate, otherMontlySavingsAmt, otherMontlySavingsRate, otherLumpsumAmt, otherLumpsumRate){
    $(':input').each(function(){
            $(this).val($.trim($(this).val()))
        });

        
            $.ajax({                                    
                url: "/app/FNARequest/calculateFnaRetirementPlanningNeeds",
                method: 'POST',
                async: false,
                data: {'inflationRate': inflationRate , 'returnRate': returnRate , 'monthlyExpensesPVAmt' :monthlyExpensesPVAmt , 'currentAge': currentAge, 'yearstoretire': yearstoretire, 'expectedretperiod': expectedretperiod, 'futureContributionAmt': futureContributionAmt, 'futureContributionRate': futureContributionRate, 'accumulatedAmt':accumulatedAmt, 'accumulatedRate': accumulatedRate, 'otherMontlySavingsAmt': otherMontlySavingsAmt, 'otherMontlySavingsRate': otherMontlySavingsRate, 'otherLumpsumAmt': otherLumpsumAmt, 'otherLumpsumRate': otherLumpsumRate , 'object': '<%= @fnaRequest.object %>' },
                    headers: {
                        'Transition-Enabled': false
                    },
                    success: function(data) {
                       var calData = $.parseJSON(data);                
                       abc = calData.split("|");
                       mothlyretirementexpenses = abc[0];
                       totalretirementneeds = abc[1];
                       totalmonthlyMRFfuturecontribution = abc[2];
                       totalmonthlyMRFaccumulatedvalue = abc[3];
                       projectedMRFfundatretire = abc[4];
                       totOtherSavingsAmt = abc[5];
                       totOtherLumpSumAmt = abc[6];
                       projectedLumpSumAmt = abc[7];
                       shortfall = abc[8];
                       monthlysavingsrequired = abc[9];
                       lumpsuminvestmentrequired = abc[10];
                        
                      $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[monthlyExpensesFVAmt]"]').val(format("#,##0.##",mothlyretirementexpenses));
                      $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[totRetirementNeedAmt]"]').val(format("#,##0.##",totalretirementneeds));
                      $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[totFutureContributionAmt]"]').val(format("#,##0.##",totalmonthlyMRFfuturecontribution));
                      $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[totAccumulatedAmt]"]').val(format("#,##0.##",totalmonthlyMRFaccumulatedvalue));
                      $('input[name="PROJECTED_MPF"]').val(format("#,##0.##",projectedMRFfundatretire));
                      $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[totOtherSavingsAmt]"]').val(format("#,##0.##",totOtherSavingsAmt));
                      $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[totOtherLumpSumAmt]"]').val(format("#,##0.##",totOtherLumpSumAmt));
                      $('input[name="TOTAL_RET_FUND_RES"]').val(format("#,##0.##",projectedLumpSumAmt));
                      $('input[name="SHORTFALL_RISK_PROT_NEEDS"]').val(format("#,##0.##",shortfall));
                      $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[monthlySavingsReqdAmt]"]').val(format("#,##0.##",monthlysavingsrequired)); 
                       $('input[name="<%=getObjectMapping(@fnaRetirementNeed)%>[lumsumReqdAmt]"]').val(format("#,##0.##",lumpsuminvestmentrequired));
                       
                    }
            });
      }
  



