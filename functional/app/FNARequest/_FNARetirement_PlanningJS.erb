 function numbersonly(evt){
    var charCode = (evt.which) ? evt.which : event.keyCode
    if (charCode > 31 && (charCode < 48 || charCode > 57))
        return false;
    return true;
  }



  
  function isNumberKey(evt)
       {
          var charCode = (evt.which) ? evt.which : evt.keyCode;
          if (charCode != 46 && charCode > 31 
            && (charCode < 48 || charCode > 57))
             return false;

          return true;
       }

  function checkifNum(val,id){
   if (isNaN(val) || val < 0 ) {
          $("input[id='" + id + "']").val("");
          var dialogContent = '<span>'+"<%= getLabelValue('ERR_CONTACT') %>"+'</span>';
                $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
                if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                $("<div>").simpledialog2({
                    mode : 'blank',
                    blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
                    });
                }
          // showDialog("", "<#%= getLabelValue('ERR_CONTACT') %>", 'warning', 0, 'capture');
          $("input[id='" + id + "']").focus();
      }
      else{
            if (val != "") {
              var returnValue = val.indexOf(".");
              if (returnValue != -1){
              $("input[id='" + id + "']").val("");
              var dialogContent = '<span>'+"<%= getLabelValue('ERR_CONTACT') %>"+'</span>';
              $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
              if (typeof $.mobile.sdCurrentDialog === 'undefined') {
              $("<div>").simpledialog2({
                mode : 'blank',
                blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
              });
          }
              // showDialog("", "<%#= getLabelValue('ERR_CONTACT') %>", 'warning', 0, 'capture');
              $("input[id='" + id + "']").focus();
              }

            }        
        }
}


