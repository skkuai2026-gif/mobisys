function large_version(){
    var montlyExpenseAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[montlyExpenseAmt]"]').val().replace(/,/g , "");
    var shortfallAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[shortfallAmt]"]').val().replace(/,/g , "");
