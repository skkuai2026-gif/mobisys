      $.ajax({                                    
      url: "/app/FNARequest/getNeedsclear",
      data: {'id':'<%= @fnaRequest.object.to_s %>'},
      async: false,
      headers: {
            'Transition-Enabled': false
      },
      success: function(data)
      {
        $("#tabDetailsContainer").html(data);
        $("#tabDetailsContainer").trigger('create');
        tabSetup();
      }
    });
    }
  else{
             var dialogContent = '<span>'+"<%= getLabelValue('CLEAR_CALCTYPE_VALUES') %>"+'</span>';
              $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
              if (typeof $.mobile.sdCurrentDialog === 'undefined') {
