    $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingAssetAmt]"]').blur(function(){
        var assets = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingAssetAmt]"]').val().replace(/,/g , "");
        $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(assets);
        var coverageAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingCoverageAmt]"]').val().replace(/,/g , "");
        if (!coverageAmt){
            var coverageAmt = 0;
        }
        var totalCurrentCapital = parseInt(assets) + parseInt(coverageAmt) ;
        $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(totalCurrentCapital);
    });

    $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingCoverageAmt]"]').blur(function(){
        var assets = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingAssetAmt]"]').val().replace(/,/g , "");
        var coverageAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingCoverageAmt]"]').val().replace(/,/g , "");
        if (!coverageAmt){
            var coverageAmt = 0;
        }
        var totalCurrentCapital = parseInt(assets) + parseInt(coverageAmt) ;
        $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(totalCurrentCapital);
    });
  

   

    function calculatelifeprotectionneeds(){
        var inflationRate = $('input[name="<%=getObjectMapping(@fnaRequest)%>[inflationRate]"]').val().replace(/,/g , "");
        var returnRate = $('input[name="<%=getObjectMapping(@fnaRequest)%>[returnRate]"]').val().replace(/,/g , "");
        var montlyExpenseAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[montlyExpenseAmt]"]').val().replace(/,/g , "");
        var expenseYears = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[expenseYears]"]').val().replace(/,/g , "");
        var otherLiabilitiesAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[otherLiabilitiesAmt]"]').val().replace(/,/g , "");
        var totalCurrentCapital = $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val().replace(/,/g , ""); 
        calculateFnaLifeProtectionNeed(inflationRate, returnRate, montlyExpenseAmt, expenseYears, otherLiabilitiesAmt, totalCurrentCapital)   
    }

    function calculateFnaLifeProtectionNeed(inflationRate, returnRate, montlyExpenseAmt, expenseYears, otherLiabilitiesAmt, totalCurrentCapital){
        $(':input').each(function(){
            $(this).val($.trim($(this).val()))
        });

        
        $.ajax({                                    
            url: "/app/FNARequest/calculateFnaLifeProtectionNeed",
            method: 'POST',
            async: false,
            data: {'inflationRate': inflationRate , 'returnRate': returnRate , 'montlyExpenseAmt' :montlyExpenseAmt , 'expenseYears': expenseYears ,'otherLiabilitiesAmt': otherLiabilitiesAmt, 'totalCurrentCapital': totalCurrentCapital, 'object': '<%= @fnaRequest.object %>' },
            headers: {
                'Transition-Enabled': false
            },
            success: function(data) {
                console.log(data);
                var calData = $.parseJSON(data);                
                abc = calData.split("|");
                protectionNeedPVAmt = abc[0];
                familyCommitment  = abc[1];
                shortFallLifeProtection = abc[2];
                console.log(protectionNeedPVAmt);
                console.log(familyCommitment);
                $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[protectionNeedPVAmt]"]').val(protectionNeedPVAmt);
                $('input[name="TOTALCAPITALNEED"]').val(familyCommitment); 
                $('input[name="SHORTFALL_CURR_LIFEPROTECTION"]').val(shortFallLifeProtection);  
            }
        });
    }
 
