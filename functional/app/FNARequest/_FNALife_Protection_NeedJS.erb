    function submitForm(){
        //Used to trim all the input fields before save
        <% if @fnaRequest.statusCd.to_s == "FNASIGNED" || @fnaRequest.statusCd.to_s == "FNASUBMIT" || @fnaRequest.statusCd.to_s == "SYNCDONE"  %>
      <% else %>
        var initialFnaLifeProtectionNeedForm = "";
        $(':input').each(function(){
            $(this).val($.trim($(this).val()))
        });
          if($('#FnaLifeProtectionNeedForm').serialize() != (MyPageData.getData)) {
            $.ajax({                                    
                url: "/app/FNARequest/submitFnaLifeProtectionNeed",
                method: 'POST',
                async: false,
                data: $('#FnaLifeProtectionNeedForm').serialize(),
                headers: {
                    'Transition-Enabled': false
                },
                success: function(data) {
                    $("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField3Str]']").val(data);
                    $("a#submit").hide(); 
                }
            });
        }
        <% end %>
    }

