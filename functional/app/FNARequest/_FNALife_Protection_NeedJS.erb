                mode : 'blank',
                blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;' onclick='redirecttogetneedsclear()'>" + '<%= getLabelValue("DELETE_YES") %>' + "</a>" +"<a rel='close' data-role='button' href='#' onclick='donotredirect()' style=''>" + '<%= getLabelValue("DELETE_NO") %>' + "</a>"
              });
          }
    }
    $('#CALCTYPECOMPLEX').trigger('focus');
    $('.ui-simpledialog-container').trigger('click');
    $('body').trigger('click')
    $('#card').trigger('click');

}

