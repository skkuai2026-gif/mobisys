<script type="text/javascript">
    //Array to store common request data to be sent on tab load
  var requestData = {
    'fnaRequestObj': '<%= @fnaRequest.object.to_s %>'
  };

  //Array object consisting of additional tab specific request data to be sent on tab load
  var additionalData = {};

  //Array to store tab order
  var eappTabOrder = [];


  //Function to load list of all errors for the selected tab as well as for all tabs
  function getTabErrors() {
    $(".errortab").each(function(){
      $(this).removeClass("errortab");
    });
  
    $.ajax({                                    
      url: "/app/FNARequest/getTabErrors",
      async: false,
          headers: {
            'Transition-Enabled': false
          },
      success: function(data) {
        if (data!="null") {
          var parsedJSON = JSON.parse(data);
          var objectName = "";
          var field = null;
          var label = null;
          var tabObject = null;
          var errorsExist = false;
            /*Refresh Contents of the error dialog start*/
          var errorData = "<ul>";
          $.each(eappTabOrder, function(index, tabID) {
          if (parsedJSON[tabID] != null && parsedJSON[tabID] != undefined){
            var tabObject = parsedJSON[tabID];
            if (!$.isEmptyObject(tabObject)) {
                              
              $("#"+tabID).parents('li').addClass("errortab");
              // errorData += "<li>" + $("#"+tabID).siblings("span").html().replace(/&nbsp;/g, '') + ":<ul>";
              // #tabID removed by Tejashree for removing labels 07-09-2017
              errorData += "<li>" + "<ul>";
              $.each(tabObject, function(objectClass, errorObject) {
                objectClass = objectClass.replace("DO", "");
                $.each(errorObject, function(guid, fieldObject) {
                    if (!jQuery.isEmptyObject(fieldObject)) {
                      errorsExist = true;
                      $.each(fieldObject, function(fieldName, errorMessage) {
                        $.each(errorMessage, function(errIndex, message) {
                          errorData += "<li>" + message + "</li>";
                        });
                      });
                        /*Map labels of error fields to the error dialog start*/
                        //Get object id based on guid and classname
                        objectName = $("input[value='"+guid+"'][name*='[guid]'][name*='"+objectClass+"']").attr('name');
                        if (objectName != undefined) {
                          $.each(fieldObject, function(fieldName, errorMessage) {
                            //Get field based on object id and fieldname
                            field = $("[name='"+objectName.replace("guid", fieldName)+"']");
                            if (field.length != 0) {
                              //Add info icon and click event listeners to label
                              if (objectClass == "ServiceQuestionResponse") {
                                label = $("div[for='"+objectName.replace("guid", fieldName)+"'] div.ui-grid-a");
                                if (label.length != 0) {
                                  label.append("<a href='#' class='ui-btn error_icon ui-btn-icon-notext ui-corner-all ui-btn-inline ui-alt-icon' style='border-style:none;'></a>");
                                }
                                else {
                                  label = $("div[for='"+objectName.replace("guid", fieldName)+"']");
                                  label.append("<a href='#' class='ui-btn error_icon ui-btn-icon-notext ui-corner-all ui-btn-inline ui-alt-icon' style='border-style:none;'></a>");
                                }
                                label = label.find("a");
                              }
                              else {
                                label = $("label[for='"+objectName.replace("guid", fieldName)+"']");
                              }

                              //Make a list of field errors
                                              var fieldErrors = "";
                                              $.each(errorMessage, function(errIndex, message) {
                                                  fieldErrors += "<li>" + message + "</li>";
                                              });

                              label.click(function(){
                                $("#singleErrorDiv").html("<ul>" + fieldErrors + "</ul>");
                                if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                                  $("<div>").simpledialog2({
                                    mode : 'blank',
                                    blankContent : $("#singleErrorDiv").html() + "<a rel='close' data-role='button' href='#'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
                                  });
                                }
                              });
                            }
                          });
                      }
                      /*Map labels of error fields to the error dialog end*/
                      }
                  });
                });
                errorData += "</ul></li>";
              }
              delete parsedJSON[tabID];
            }
          });
          
          $.each(parsedJSON, function(tabID, tabObject) {
            if (!$.isEmptyObject(tabObject)) {
                            
              // #tabID removed by Tejashree for removing labels 07-09-2017              
            errorData += "<li>" + "<ul>";
              $.each(tabObject, function(objectClass, errorObject) {
                $("a[data-url='"+tabID+"']").addClass("errortab");            
                objectClass = objectClass.replace("DO", "");
                $.each(errorObject, function(guid, fieldObject) {
                    if (!jQuery.isEmptyObject(fieldObject)) {
                      errorsExist = true;
                      $.each(fieldObject, function(fieldName, errorMessage) {
                        $.each(errorMessage, function(errIndex, message) {
                          errorData += "<li>" + message + "</li>";
                        });
                      });
                    }
                });
              });
              errorData += "</ul></li>";
            }
          });


          
          errorData += "</ul>";
          $("#totalErrorDiv").html(errorData);
          if (errorsExist) {
            $('span[id="errordiv"]').show();
          }
          else{
             $('span[id="errordiv"]').hide();
          }

            /*Refresh Contents of the error dialog end*/
        }
      }
    });
  }

    // Over-written raise alert method of product to show dialog instead of alert
    function raiseAlert(exceptionCd,placeHolderArr,locale){
        var result = getLabel(exceptionCd,locale);
        if (placeHolderArr!=null){
            for (var i = 0; i < placeHolderArr.length; i++) {
                result = result.replace("{"+(i+1)+"}",placeHolderArr[i]);
            }
        }

        var dialogContent = '<span>'+result+'</span>';
        $("#field-validation-div").html("").html(dialogContent).trigger('create');
        if (typeof $.mobile.sdCurrentDialog === 'undefined') {
            $("<div>").simpledialog2({
                mode : 'blank',
                blankContent : $("#field-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
            });
        }        
    }

 // Tejashree:08-Aug-2017 for alert on back button
  function hyperlink_alert(){
     $.ajax({
        url: "/app/Menu/hyperlinktofna",
        async: false,
        headers: {
            'Transition-Enabled': false
        },
        success: function(data) {
           
               
        }
    });
  }

  function changeTab(clickObject) {

    var dataURL = clickObject.attr("data-url");

    tabExchange(dataURL);

    var id = ""

    if (clickObject.attr("id") == "previousTab" || clickObject.attr("id") == "nextTab"){
        id = $('a[data-url = "' + dataURL + '" ]').prop("id");
    }else{
        id = clickObject.attr("id");
    }

    if (clickObject.data("addl-params-key")) {
        requestData = $.extend(requestData, additionalData[clickObject.data("addl-params-key")]);
    }
    /*Load tab content start*/
    $.ajax({ 
        url: "/app/FNARequest/"+dataURL,
        data: {'id':'<%= @fnaRequest.object.to_s %>'},
        async: false,
        headers: {
            'Transition-Enabled': false
        },
        success: function(data) {
    
            $.mobile.loading('hide');
            $('#'+id).addClass("active-btn");
            $("#tabDetailsContainer").html(data);
            $("#tabDetailsContainer").trigger('create');
                      // hideLoadingMessage();
            tabSetup();
            $(document).ready(function(){
             
                $('.scrollTopButton').click(function() {
                    $("html, body").animate({ scrollTop: 0 }, "slow");
                });

                $('.expandButton').hide();

                $('.collapseButton').click(function() {
                    $(this).parents(".legend").siblings(".panelContent").hide();
                    $(this).hide();
                    $(this).siblings('.expandButton').show();
                });

                $('.expandButton').click(function() {
                    $(this).parents(".legend").siblings(".panelContent").show();
                    $(this).hide();
                    $(this).siblings('.collapseButton').show();
                });

                <% if @fnaRequest.policyNum.to_s != "" || @fnaRequest.statusCd.to_s == "FNASUBMIT" %>
                setReadOnly($('input[type="text"]'), true);
                setReadOnly($('input[type="tel"]'), true);
                setReadOnly($('input[type="num"]'), true);
                setReadOnly($('input[type="email"]'), true);
                $('select').selectmenu('disable').trigger("refresh");
                $('input[type="radio"]').checkboxradio('disable').trigger("refresh");
                $('input[type="checkbox"]').checkboxradio('disable').trigger("refresh");
                $('input[type="button"]').off('click');
                $('input[type="button"]').button('disable').trigger("refresh");
                $('a[href="#clear"]').hide();
                <% end %>

                if (dataURL == "getPolicyNo"){
                $('.icon').show();
                $('.checkv1').show();
                $('.submit_button_for_submission').show();
            }
               
            });
            getTabErrors();
        }
    });
    /*Load tab content end*/
  }

