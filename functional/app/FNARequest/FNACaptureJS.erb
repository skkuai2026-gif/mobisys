  function tabExchange(currentURL){

    if (currentURL == 'getBasicDetails' ){
      $('#previousTab').hide();
      $('#nextTab').show();
      $('#nextTab').attr("data-url","getNeeds");
      $('.active-btn').removeClass("active-btn");
      $('a[data-url="getBasicDetails"]').addClass("active-btn");
      $('#submit_button_for_submission').hide();
    }
    
    if (currentURL == 'getNeeds' ){
      $('#nextTab').show();
      $('#previousTab').show();
      $('#previousTab').attr("data-url","getBasicDetails");
      $('#nextTab').attr("data-url","getProductList").trigger("create");
      $('.active-btn').removeClass("active-btn");
      $('a[data-url="getNeeds"]').addClass("active-btn");
      $('#submit_button_for_submission').hide();
    }
    
    if (currentURL == 'getProductList' ){
      $('#nextTab').show();
      $('#previousTab').show();
      $('#previousTab').attr("data-url","getNeeds");
      $('#nextTab').attr("data-url","getProductSelection");
      $('.active-btn').removeClass("active-btn");
      $('a[data-url="getProductList"]').addClass("active-btn");
      $('#submit_button_for_submission').hide();
    }
    
    if (currentURL == 'getProductSelection' ){
      $('#nextTab').show();
      $('#previousTab').show();
      $('#previousTab').attr("data-url","getProductList");
      $('#nextTab').attr("data-url","getReasonsForRecommendation");
      $('.active-btn').removeClass("active-btn");
      $('a[data-url="getProductSelection"]').addClass("active-btn");  
      $('#submit_button_for_submission').hide();
    }
    
    if (currentURL == 'getReasonsForRecommendation' ){
      $('#nextTab').show();
      $('#previousTab').show();
      $('#previousTab').attr("data-url","getProductSelection");
      <% if @fnaRequest.addtnField1Str.to_s == "FNACOMPLETE" || @fnaRequest.addtnField1Str.to_s == "FNASIGNED" || @fnaRequest.addtnField1Str.to_s == "FNASUBMIT" %>
      {
      $('#nextTab').attr("data-url","getDeclaration");
      $('.active-btn').removeClass("active-btn");
      $('a[data-url="getReasonsForRecommendation"]').addClass("active-btn");
      $('#submit_button_for_submission').hide();
      }
      <% else %>
      {
        $('#nextTab').removeAttr("data-url","getDeclaration");
        $('#nextTab').attr("data-url","previewtab");
        $('#nextTab').attr("name","preview");
        $('.active-btn').removeClass("active-btn");
        $('a[data-url="getReasonsForRecommendation"]').addClass("active-btn");
        $('#submit_button_for_submission').hide();     
      }
      <% end %>
      
    }

    if (currentURL == 'getDeclaration' ){
      $('#nextTab').show();
      $('#previousTab').show();
      $('#previousTab').attr("data-url","getReasonsForRecommendation");
      $('#nextTab').attr("data-url","getPolicyNo");
      $('.active-btn').removeClass("active-btn");
      $('a[data-url="getDeclaration"]').addClass("active-btn");
      $('#submit_button_for_submission').hide();
    }
    
    if (currentURL == 'getPolicyNo' ){
      $('#submit_button_for_submission').show();
      <%if @fnaRequest.addtnField1Str.to_s == "FNASUBMIT" || @fnaRequest.addtnField1Str.to_s == "SYNCDONE"%>
      $('#submit_button_for_submission').hide();
      <%end%>
      $('#previousTab').attr("data-url","getDeclaration");
      $('#previousTab').show();
      $('#nextTab').hide();
      $('#nextTab').attr("data-url","");
      $('.active-btn').removeClass("active-btn");
      $('a[data-url="getPolicyNo"]').addClass("active-btn"); 
    }
    
  }

  $(".scrollup").click(function(){
      $("html, body").animate({ scrollTop: 0 }, 0);
  });

  $(document).ready(function() {

      <%if @fnaRequest.statusCd.to_s != "FNAPENDING"%>
      $('.icon').show();
      $('.checkv1').show();
    <%end%>

    <%if@fnaRequest.statusCd.to_s == "FNASIGNED" %>
      $('#submit_button_for_submission').show();
    <%else%>
      $('#submit_button_for_submission').hide();
    <%end%>
    

      $("a[name='submit']").click(function(){
      $('input[type="radio"]').removeAttr("disabled");
      $('input[type="checkbox"]').removeAttr("disabled");
      submitForm();
      if ($("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField3Str]']").val() == "false" || 
          $("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField3Str]']").val() == ""){
              document.fnaForm.action = "executeSubmit";
              document.fnaForm.submit();
        }
      else {
              getTabErrors();
            }

    });

      $("a[name='save']").click(function() {
      $('input[type="radio"]').removeAttr("disabled");
      $('input[type="checkbox"]').removeAttr("disabled");
      $("#basicTabOnSave").val("true");
      submitForm();
      if ($("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField3Str]']").val() == "false" || 
          $("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField3Str]']").val() == ""){
            document.fnaForm.action = "executeSave";
            document.fnaForm.submit();
        }
      else {
              getTabErrors();
            }
    });

      $("a[name='preview']").click(function() {
       $('input[type="radio"]').removeAttr("disabled");
      $('input[type="checkbox"]').removeAttr("disabled");
      submitForm();
      setTimeout(SubmitPreview, 1800);
    });

      function SubmitPreview()
      {
        document.fnaForm.action = "executePreview";
        document.fnaForm.submit();
      }

      $(".eapp-navbar ul li a").each(function(){
          eappTabOrder.push($(this).attr("id"));
      });

       <% if @set_req_tab %>
      changeTab($("a[data-url='getDeclaration']"));
     <% else %>  
      changeTab($("a[data-url='getBasicDetails']"));
     <% end %> 

      $(".tabLinks").click(function(){
        showLoadingMessage();
          <% if @fnaRequest.statusCd.to_s != "FNASIGNED" %>
              $('input[type="radio"]').removeAttr("disabled");
              $('input[type="checkbox"]').removeAttr("disabled");
              submitForm();
          <%end%>
              $(".tabLinks").removeClass('active-btn')
              if ($("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField3Str]']").val() == "false" ||
                  $("input[name='<%= getObjectMapping(@fnaRequest) %>[addtnField3Str]']").val() == "") {
                    changeTab_New($(this))
              }
              else {
                     getTabErrors();
                  }
      });
  });

