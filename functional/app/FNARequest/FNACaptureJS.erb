    $('#error_dialog').click(function(){
    if (typeof $.mobile.sdCurrentDialog === 'undefined') {
      $("<div>").simpledialog2({
        mode : 'blank',
        blankContent : $("#totalErrorDiv").html() +"<a rel='close' data-role='button' href='#'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
