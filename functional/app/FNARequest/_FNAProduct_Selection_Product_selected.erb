   <div class="legend">
        <label class="strongLabel">
            <%= getLabelValue('UI_SUMMARY_OF_CLIENT') %>
            <a href="#" class="expandButton ui-icon-plus ui-btn-icon-notext ui-alt-icon ui-btn-inline ui-link" style="display: none;"></a>
            <a href="#" class="collapseButton ui-icon-minus ui-btn-icon-notext ui-alt-icon ui-btn-inline ui-link"></a>
        </label>
    </div>  
        
     <div class="panelContent">
            <div class="half" style="width:45%;">
                <h3 style="font-size:14px !important;"><%=getLabelValue('UI_Q1_IO')%></h3>
                <div class="group">
                    <table class="ui-responsive table-stroke" style="border: 0px solid black;border-collapse:collapse;width:100%;">
                        <thead style="font-size:16px;color:#003946;border-bottom:2px solid black;border-top:2px solid black;">
                            <tr style="background-color:#E6ECED;line-height:24px;">
                            <th style="text-align:left;"><%=getLabelValue('UI_CRITERIA')%></th>
                            <th style="text-align:center;"><%=getLabelValue('UI_CLIENT')%></th>
                            <th style="text-align:center;"><%=getLabelValue('ProductIntroduced')%></th>
                            </tr>
                        </thead>
                        <tbody style="font-size:16px;">
                            <% count=0 %>
                            <% @questionSeq.each do |que1| %>
                                <% if count%2==0 %> 
                                    <tr style="background-color:#FAFAFA;height:50px;color:#003946;">
                                <% else %>
                                    <tr style="background-color:#E6ECED;height:50px;color:#003946;">
                                <% end %>
                                        <td style="width: 60%;"><%= getlabelValueExtra(que1.cd)%></td>
                                        <% if @resp1 != "" %>
                                        <%                                    
                                        respFl = false
                                        @resp1.each do |res1|
                                        if res1 == que1.cd 
                                        respFl = true
                                        %>
                                        <td style="text-align:center;width: 10%;"><img src="/public/images/FNA/Client requested32.png"  style="height:30px;width:30px;"></td>
                                        <%
                                        end
                                        end
                                        unless respFl
                                        %>   
                                        <td style="text-align:center;width: 10%;"></td>
                                        <% end %>
                                        <% end %>
                                        <% if @resp1 != "" %>
                                        <% if @productmax1 != nil %>
                                        <% respFl = false 
                                        @productmax1.each do |pro1|
                                        if pro1 == que1.cd 
                                        respFl = true
                                        %>
                                       <td style="text-align:center;width: 30%;"><img src="/public/images/FNA/Tick.png"  style="height:30px;width:30px;"></td>
                                       <%
                                         end
                                         end
                                         unless respFl
                                         %>
                                        <% if @mismatch1 != nil %>
                                        <% respFl = false 
                                        if @mismatch1.include?(que1.cd)
                                        respFl = true %> 
                                        <td style="text-align:center;width: 30%;"><img src="/public/images/FNA/mismatch 32.png"  style="height:30px;width:30px;"></td>
                                        <% end 
                                        unless respFl
                                        %>
                                        <td style="text-align:center;width: 30%;"></td>
                                        <% end %>
                                        <% end %>
                                        <% end %>
                                        <% end %> 
                                        <% end %>
                                    </tr>        
                                <% count= count + 1 %>
                            <% end %>  
                        </tbody>
                    </table>
                </div>
            </div>  
            <div class="half" style="width:45%;">
                <h3 style="font-size:14px !important;"><%=getLabelValue('UI_Q2_IO')%></h3>
                <div class="group">
                    <table class="ui-responsive table-stroke" style="border: 0px solid black;border-collapse:collapse;width:100%;">
                        <thead style="font-size:16px;color:#003946;border-bottom:2px solid black;border-top:2px solid black;">
                            <tr style="background-color:#E6ECED;line-height:24px;">
                            <th style="text-align:left;"><%=getLabelValue('UI_CRITERIA')%></th>
                            <th style="text-align:center;"><%=getLabelValue('UI_CLIENT')%></th>
                            <th style="text-align:center;"><%=getLabelValue('ProductIntroduced')%></th>
                            </tr>
                        </thead>
                        <tbody style="font-size:16px;">
                            <% count=0 %>
                            <% @questionSeq1.each do |que2| %>
                                <% if count%2==0 %> 
                                    <tr style="background-color:#FAFAFA;height:50px;color:#003946;">
                                <% else %>
                                    <tr style="background-color:#E6ECED;height:50px;color:#003946;">
                                <% end %>
                                        <td style="width: 60%;"><%= getlabelValueExtra(que2.cd) %></td>
                                        <% if @resp2 != "" %>
                                        <%                                    
                                        respFl = false
                                        @resp2.each do |res2|
                                        if res2 == que2.cd
                                        respFl = true
                                        %>
                                        <td style="text-align:center;width: 10%;"><img src="/public/images/FNA/Client requested32.png"  style="height:30px;width:30px;"></td>
                                        <%
                                        end
                                        end
                                        unless respFl
                                        %>
                                        <td style="text-align:center;width: 10%;"></td>
                                        <% end %>
                                        <% end %>
                                        <% if @resp1 != "" %>
                                        <% if @productmax2 != nil %>
                                        <% respFl = false 
                                        @productmax2.each do |pro2|
                                        if pro2 == que2.cd 
                                        respFl = true
                                        %>
                                        <td style="text-align:center;width: 30%;"><img src="/public/images/FNA/Tick.png"  style="height:30px;width:30px;"></td>
                                        <%
                                        end
                                        end
                                        unless respFl
                                        %>
                                        <% if @mismatch2 != nil %>
                                        <% respFl = false 
                                        if @mismatch2.include?(que2.cd)
                                        respFl = true %>  
                                        <td style="text-align:center;width: 30%;"><img src="/public/images/FNA/mismatch 32.png"  style="height:30px;width:30px;"></td>
                                        <% end 
                                        unless respFl
                                        %>
                                        <td style="text-align:center;width: 30%;"></td>
                                        <% end %>
                                        <% end %>
                                        <% end %>
                                        <% end %>
                                        <% end %>  
                                    </tr>
                                <% count= count + 1 %>
                            <% end %>                            
                        </tbody>
                    </table>
                </div>
            </div>
            <br/>
              <table width="100%" style="padding-left:15px;">
                <tr>
                    <td align="left" width="2%">
                       <img src="/public/images/FNA/Client requested32.png"  style="height:30px;width:30px;"> 
                    </td>
                    <td width="13%">
                        =<%= getLabelValue('CLIENTREQUESTED') %>
                    </td>
                    <td width="2%">
                        <img src="/public/images/FNA/Tick.png"  style="height:30px;width:30px;">
                    </td>
                     <td width="13%">
                       =<%= getLabelValue('CRITERIAMET') %>
                    </td>
                    <td width="2%">
                        <img src="/public/images/FNA/mismatch 32.png"  style="height:30px;width:30px;"> 
                    </td>
                     <td width="68%">
                        =<%= getLabelValue('CRITERIAMISMATCH') %>
                    </td>
                </tr>
           </table>
        </div>  
        
    

     <style >
        .button_UI {
            background-color:#efbc33!important;
            border-radius: 7px;
            border-style: none;
            color: #003946 !important;
            display: inline-block;
            font-size: 14px !important;
            max-width: 200px;
            margin: 0;
            text-shadow: none !important;
            font-weight: 700;
            text-align: center;
            line-height: 1.3;
            /*padding: .8em 1.5em !important;*/
            width: 100px;
        }
    </style>

    