<script type="text/javascript">		
	$(document).ready(function(){		
	    $('input').keypress(function (e) {		
	        if (e.which == 13) {		
	            $('#fnaSearchForm').submit();		
	            return false;		
	        }		
	    });	

	    $('input').change(function(){		
	        $('#fnaSearchForm').submit();		
	    });

		$('.searchicon').click(function (){
			$('#fnaSearchForm').submit();
		})			
	});	


	// Tejashree:11-09-2017: Withdrawn Product Validation
  function validatewithdrawnproduct(value){
  	 $.ajax({                                    
      url: "/app/FNARequest/withdrawnProductValidation",
      data: {'id':value},
      async: false,
      headers: {
            'Transition-Enabled': false
      },
      success: function(data)
      {    
      	    var calData = $.parseJSON(data);                
            abc = calData.split("|");
            var dialogContent = '<span>'+"<%= getLabelValue('SIGN_DATE_NOT_AFTER_WITHDRAWN_DATE') %>"+'</span>';
            $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
            if (typeof $.mobile.sdCurrentDialog === 'undefined') {
            $("<div>").simpledialog2({
                mode : 'blank',
                blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='"+abc[0]+"' rel='external' onclick='location.href=\""+abc[0]+"\"' style='margin-top: 2%;'>" + '<%= getLabelValue("OK") %>' + "</a>" +"<a rel='close' data-role='button' style=''>" + '<%= getLabelValue("CANCEL") %>' + "</a>"

            });
          }
      }
    });
  }	
</script>
