function additionalgoalTabs() {
  
  
        $(':input').each(function(){
            $(this).val($.trim($(this).val()))
        });

        
        $.ajax({                                    
            url: "/app/FNARequest/additionalgoalTabs",
            method: 'POST',
            async: false,
            data: {'object': '<%= @fnaRequest.object %>' },
                headers: {
                    'Transition-Enabled': false
                },
                success: function(data) {
                   
                    create = data;
                     
                    $("#FNAadditionalgoalTabs").append(create);
                    $("#FNAadditionalgoalTabs").trigger('create');
                    $('input.ansvalue').each(function(i, j){
                        $(j).siblings('label').css("top", "-10px");
                        });
                }
        });
        
}

