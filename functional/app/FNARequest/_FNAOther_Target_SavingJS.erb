      '<%= getLabelValue('DELETE_YES') %>': {
        click: function (){
          $('div[id="'+fnaOtherTargetNeedObject+'"]').parents("div.fna-target-need-parent").remove();
          $('input[id="'+fnaOtherTargetNeedObject+'[removed]"]').val('YES');
