        click: function () {
        },
        icon: "delete",
        theme: "c"
      }
    }
  });
}

   function numbersonly(evt){
    var charCode = (evt.which) ? evt.which : event.keyCode
    if (charCode > 31 && (charCode < 48 || charCode > 57))
        return false;
    return true;
    
  } 


  function isNumberKey(evt){
        var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)){
                return false;
            }
        return true;
  }

  // var save = false

    function calculateothertargetsavingneeds(){
        var fieldName;
        var fieldName
        var selectedtargetSavingAmt = [];
        var selectedsavingsPeriod = [];
        var selectedGoal = [];
        var inflationRate = $('input[name="<%=getObjectMapping(@fnaRequest)%>[inflationRate]"]').val().replace(/,/g , "");

        var returnRate = $('input[name="<%=getObjectMapping(@fnaRequest)%>[returnRate]"]').val().replace(/,/g , "");
        var bool1 = true
        var bool2 = true
        var bool3 = true
        var bool4ForPeriodValue = true

        $('input.targetvalue').each(function(i, j){
            fieldName = $(j).attr("name");
            
            if(fieldName.indexOf("targetSavingAmt") != -1){
                selectedtargetSavingAmt.push($(j).val().replace(/,/g , ""));
            }
            
            if(fieldName.indexOf("savingsPeriod") != -1){
                selectedsavingsPeriod.push($(j).val().replace(/,/g , ""));
            }
        });

        $('input.goalValue').each(function(i, j){
            nameValue =  $(j).attr("name");
            if(nameValue.indexOf("objective") != -1){
                selectedGoal.push($(j).val().replace(/,/g , ""));
            }
            // console.log(nameValue);
            // console.log(selectedGoal);
        });

        for(i = 0; i < selectedtargetSavingAmt.length; i++) {
            if (selectedtargetSavingAmt[i] == null || selectedtargetSavingAmt[i] == 0.0 || selectedtargetSavingAmt[i] == 0 || selectedtargetSavingAmt[i] == "" ){
                bool1 = false ;
            }
            
            if (selectedsavingsPeriod[i] == null || selectedsavingsPeriod[i] == 0.0 || selectedsavingsPeriod[i] == 0 || selectedsavingsPeriod[i] == "" ){
                bool2 = false ;
                if (selectedsavingsPeriod[i] == null || selectedsavingsPeriod[i] == "" ){
                  bool4ForPeriodValue = true;
                }else{
                  bool4ForPeriodValue = false;
                }
            }

            if (selectedGoal[i] == "" || selectedGoal[i] == null){
                bool3 = false ;
            }
        }

      if (selectedtargetSavingAmt.length > 0 && selectedsavingsPeriod.length > 0 && selectedGoal.length > 0){
        <% if @fnaRequest.statusCd.to_s == "FNAPENDING" %>
          if (bool1 && bool2 && bool3){
              $.ajax({                                    
                  url: "/app/FNARequest/calculateotherTargetSaving",
                  method: 'POST',
                  async: false,
                  data: {'selectedtargetSavingAmt': selectedtargetSavingAmt, 'returnRate': returnRate, 'selectedsavingsPeriod': selectedsavingsPeriod, 'inflationRate': inflationRate, 'object': '<%= @fnaRequest.object %>' },
                  headers: {
                      'Transition-Enabled': false
                  },
                  success: function(data) {
                       
                      var calData = $.parseJSON(data); 
                      abc = calData.split("|");
                      calData = abc[0];
                      current_shortfall = abc[1];
                      mothly_saving_shortfall = abc[2];
                      lumpsum_investment_shortfall = abc[3];
                      calData = calData.replace("[" , "").replace("]", "");
                      var calDataArr = calData.split(",");
                      $('input.ansvalue').each(function(i, j){                           
                          $(j).val(format("#,##0.##",calDataArr[i]));
                          $(j).siblings('label').css("top", "-10px");
                      });
                      $('input[name="TOTAL_CURRENT_SHORTFALL"]').val(format("#,##0.##",current_shortfall)); 
                      $('input[name="TOTAL_MONTHLY_SAVINGS_SHORTFALL"]').val(format("#,##0.##",mothly_saving_shortfall)); 
                      $('input[name="TOTAL_LUMP_SUM_INV_SHORTFALL"]').val(format("#,##0.##",lumpsum_investment_shortfall)); 
                  }
              });
            // save = true;
          }else{
            // fill amount = false    period = true     objective = true 
              if (bool1 == false && bool2 == true && bool3 == true){
                  var dialogContent = '<span>'+"<%= getLabelValue('ERR_TARGET_SAVINGS_MANDATORY') %>"+'</span>';
                  $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
                  if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                  $("<div>").simpledialog2({
                      mode : 'blank',
                      blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
                      });
                  }
                  // showDialog("", "<%#= getLabelValue('ERR_TARGET_SAVINGS_MANDATORY') %>", 'error', 0, 'capture');
              }
            // fill amount = true    period = false     objective = true               
              else if(bool1 == true && bool2 == false && bool3 == true){
                  if (bool4ForPeriodValue == true ){
                    var dialogContent = '<span>'+"<%= getLabelValue('TARGET_SAVING_PERIOD_MANDATORY') %>"+'</span>';
                      $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
                      if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                        $("<div>").simpledialog2({
                            mode : 'blank',
                            blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
                            });
                      }
                    }
                  if (bool4ForPeriodValue == false ){
                    var dialogContent = '<span>'+"<%= getLabelValue('ERR_INTEGER') %>"+'</span>';
                      $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
                      if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                        $("<div>").simpledialog2({
                            mode : 'blank',
                            blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
                            });
                      }
                    }
                  // showDialog("", "<%#= getLabelValue('ERR_INTEGER') %>", 'error', 0, 'capture');
              }
            // fill amount = false    period = false     objective = true               
              else if(bool1 == false && bool2 == false && bool3 == true){
                  var dialogContent = '<span>'+"<%= getLabelValue('ERR_TARGET_SAVINGS_MANDATORY') %>"+'<br>'+"<%= getLabelValue('TARGET_SAVING_PERIOD_MANDATORY') %>"+'</span>' ;
                  $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
                  if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                  $("<div>").simpledialog2({
                      mode : 'blank',
                      blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
                      });
                  }
                  // showDialog("", "<%#= getLabelValue('ERR_INTEGER') %>", 'error', 0, 'capture');
              }
            // fill amount = true    period = false     objective = false               
              else if(bool1 == true && bool2 == false && bool3 == false){
                  var dialogContent = '<span>'+"<%= getLabelValue('ERR_FILL_ALL_VALUE') %>"+'<br>'+"<%= getLabelValue('TARGET_SAVING_PERIOD_MANDATORY') %>"+'</span>' ;
                  $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
                  if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                  $("<div>").simpledialog2({
                      mode : 'blank',
                      blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
                      });
                  }
                  // showDialog("", "<%#= getLabelValue('ERR_INTEGER') %>", 'error', 0, 'capture');
              }
            // fill amount = false    period = true     objective = false               
              else if(bool1 == false && bool2 == true && bool3 == false){
                  var dialogContent = '<span>'+"<%= getLabelValue('ERR_FILL_ALL_VALUE') %>"+'<br>'+"<%= getLabelValue('ERR_TARGET_SAVINGS_MANDATORY') %>"+'</span>' ;
                  $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
                  if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                  $("<div>").simpledialog2({
                      mode : 'blank',
                      blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
                      });
                  }
                  // showDialog("", "<%#= getLabelValue('ERR_INTEGER') %>", 'error', 0, 'capture');
              }
            // fill amount = false    period = false     objective = false               
              else {
                  var dialogContent = '<span>'+"<%= getLabelValue('ERR_FILL_ALL_VALUE') %>"+'</span>';
                  $("#policyNo-validation-div").html("").html(dialogContent).trigger('create');
                  if (typeof $.mobile.sdCurrentDialog === 'undefined') {
                  $("<div>").simpledialog2({
                      mode : 'blank',
                      blankContent : $("#policyNo-validation-div").html() +"<a rel='close' data-role='button' href='#' style='margin-top: 2%;'>" + '<%= getLabelValue("MESSAGE_CLOSE") %>' + "</a>"
                      });
                  }
                  // showDialog("", "<%#= getLabelValue('ERR_FILL_ALL_VALUE') %>", 'error', 0, 'capture');
              }
          }
        <% end %>
    }  
  }

