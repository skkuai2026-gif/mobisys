                        <%#= getLabelValue('NEXT') %> 
                    </a> 
                <%# end %>
            </div>
        </div>
    </div>  -->   
    <style >
        .button_UI {
            background-color:#efbc33!important;
            border-radius: 7px;
            border-style: none;
            color: #003946 !important;
            display: inline-block;
            font-size: 14px !important;
            max-width: 200px;
            margin: 0;
            text-shadow: none !important;
            font-weight: 700;
            text-align: center;
            line-height: 1.3;
            /*padding: .8em 1.5em !important;*/
            width: 100px;
            height: 20px;
        }
        
        .sigNav a, .sigNav a:link, .sigNav a:visited{
            text-decoration: none;
        }
    </style>
    
<%= render(:partial => 'FNADeclarationJS')%>
</form>

 <div class="" data-role="dualfieldcontain" align="">
        <div class="">
            <div class="group" style="font-size: 14px;">
                <%= getLabelValue('INSTRUCTION_TEXT_ESIGNATURE') %>
            </div>
        </div>     
    </div>




