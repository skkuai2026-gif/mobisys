  $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingAssetAmt]"]').blur(function(){
    var assets = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingAssetAmt]"]').val().replace(/,/g , "");
    if(assets == null || assets == ""){
    $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val('0');
    }else{
    $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(format("#,##0.##",assets));
    }    
    var coverageAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingCoverageAmt]"]').val().replace(/,/g , "");
     if (!coverageAmt){
     var coverageAmt = 0;
   }
    var totalCurrentCapital = parseInt(assets) + parseInt(coverageAmt) ;
    if (totalCurrentCapital < 0){
      var totalCurrentCapital = 0;
    }

    if(assets == null || assets == ""){
    $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(format("#,##0.##",coverageAmt));
    }else{
    $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(format("#,##0.##",totalCurrentCapital));
    }  
  });


 $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingCoverageAmt]"]').blur(function(){
   var assets = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingAssetAmt]"]').val().replace(/,/g , "");
   if(assets == null || assets == ""){
    var assets = 0;
    $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val('0');
    }else{
    $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(format("#,##0.##",assets));
    } 
   var coverageAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingCoverageAmt]"]').val().replace(/,/g , "");
   if (!coverageAmt || coverageAmt == null ){
     var coverageAmt = 0;
   }
   if(coverageAmt == null || coverageAmt == ""){
    $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(format("#,##0.##",assets));
   }else{
   var totalCurrentCapital = parseInt(assets) + parseInt(coverageAmt);
   if(totalCurrentCapital < 0){
    var totalCurrentCapital = 0;
   }
   $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(format("#,##0.##",totalCurrentCapital));
   }
  });
  
 
 

function calculatelifeprotectionneeds(){
  
  var inflationRate = $('input[name="<%=getObjectMapping(@fnaRequest)%>[inflationRate]"]').val().replace(/,/g , "");
  var returnRate = $('input[name="<%=getObjectMapping(@fnaRequest)%>[returnRate]"]').val().replace(/,/g , "");
  var montlyExpenseAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[montlyExpenseAmt]"]').val().replace(/,/g , "");
  var expenseYears = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[expenseYears]"]').val().replace(/,/g , "");
  var otherLiabilitiesAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[otherLiabilitiesAmt]"]').val().replace(/,/g , "");
  var totalCurrentCapital = $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val().replace(/,/g , ""); 
  var educationNeedPVAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[educationNeedPVAmt]"]').val().replace(/,/g , "");
  var existingAssetAmt =  $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingAssetAmt]"]').val().replace(/,/g , "");
  var existingCoverageAmt = $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[existingCoverageAmt]"]').val().replace(/,/g , "");
  
  calculateFnaLifeProtectionNeed(inflationRate, returnRate, montlyExpenseAmt, expenseYears, otherLiabilitiesAmt, totalCurrentCapital,  educationNeedPVAmt, existingAssetAmt, existingCoverageAmt)   
}

function calculateFnaLifeProtectionNeed(inflationRate, returnRate, montlyExpenseAmt, expenseYears, otherLiabilitiesAmt, totalCurrentCapital, educationNeedPVAmt, existingAssetAmt, existingCoverageAmt){

      $(':input').each(function(){
            $(this).val($.trim($(this).val()))
        });

        
            $.ajax({                                    
                url: "/app/FNARequest/calculateFnaLifeProtectionNeed",
                method: 'POST',
                async: false,
                data: {'inflationRate': inflationRate , 'returnRate': returnRate , 'montlyExpenseAmt' :montlyExpenseAmt , 'expenseYears': expenseYears ,'otherLiabilitiesAmt': otherLiabilitiesAmt, 'totalCurrentCapital': totalCurrentCapital, 'educationNeedPVAmt': educationNeedPVAmt, 'existingAssetAmt': existingAssetAmt, 'existingCoverageAmt': existingCoverageAmt, 'object': '<%= @fnaRequest.object %>' },
                    headers: {
                        'Transition-Enabled': false
                    },
                    success: function(data) {
                       console.log(data);
                       var calData = $.parseJSON(data);                
                       abc = calData.split("|");
                       protectionNeedPVAmt = abc[0];
                       totalcapitalneed  = abc[1];
                       totalCurrentCapital = abc[2];
                       shortFallLifeProtection = abc[3];
                       educationNeedFVAmt = abc[4];
                       educationFundFVAmt = abc[5];
                       shortFallChildEducation = abc[6];
                       $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[protectionNeedPVAmt]"]').val(format("#,##0.##",protectionNeedPVAmt));
                       $('input[name="TOTALCAPITALNEED"]').val(format("#,##0.##",totalcapitalneed)); 
                       $('input[name="TOTAL_CURRCAPITAL_RESERVED"]').val(format("#,##0.##",totalCurrentCapital));
                       $('input[name="<%=getObjectMapping(@fnaLifeProtectionNeed)%>[shortfallAmt]"]').val(format("#,##0.##",shortFallLifeProtection));
                       

                    }

            });
          
}

