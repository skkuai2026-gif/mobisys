  function calculatehealthprotectionneeds(){
   
    var hincomeNeededAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[hincomeNeededAmt]"]').val().replace(/,/g , "");
    var hincomeCoveredAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[hincomeCoveredAmt]"]').val().replace(/,/g , "");
    var HIncomeShortFall = $('input[name="HINCOME_SHORTFALL_RISK_PROT_NEEDS"]').val().replace(/,/g , "");

    var hinsuranceNeededAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[hinsuranceNeededAmt]"]').val().replace(/,/g , "");
    var hinsuranceCoveredAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[hinsuranceCoveredAmt]"]').val().replace(/,/g , "");
    var HInsuranceShortFall = $('input[name="HINSURANCE_SHORTFALL_RISK_PROT_NEEDS"]').val().replace(/,/g , "");

    var sfbNeededAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[sfbNeededAmt]"]').val().replace(/,/g , "");
    var sfbCoveredAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[sfbCoveredAmt]"]').val().replace(/,/g , "");
    var SFBShortFall = $('input[name="SFB_SHORTFALL_RISK_PROT_NEEDS"]').val().replace(/,/g , "");

    var ciInsuranceNeededAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[ciInsuranceNeededAmt]"]').val().replace(/,/g , "");
    var ciInsuranceCoveredAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[ciInsuranceCoveredAmt]"]').val().replace(/,/g , "");
    var CIInsuranceShortFall = $('input[name="CIINSURANCE_SHORTFALL_RISK_PROT_NEEDS"]').val().replace(/,/g , "");

    var addInsuranceNeededAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[addInsuranceNeededAmt]"]').val().replace(/,/g , "");
    var addInsuranceCoveredAmt = $('input[name="<%=getObjectMapping(@fnaOtherProtectionNeed)%>[addInsuranceCoveredAmt]"]').val().replace(/,/g , "");
    var ADDInsuranceShortFall = $('input[name="ADDINSURANCE_SHORTFALL_RISK_PROT_NEEDS"]').val().replace(/,/g , "");
    calculateFnaHealthProtectionNeed(hincomeNeededAmt, hincomeCoveredAmt, hincomeCoveredAmt, hinsuranceNeededAmt, hinsuranceCoveredAmt, HInsuranceShortFall, sfbNeededAmt, sfbCoveredAmt, SFBShortFall, ciInsuranceNeededAmt, ciInsuranceCoveredAmt, CIInsuranceShortFall, addInsuranceNeededAmt, addInsuranceCoveredAmt, ADDInsuranceShortFall)   
    }

function calculateFnaHealthProtectionNeed(hincomeNeededAmt, hincomeCoveredAmt, HIncomeShortFall, hinsuranceNeededAmt, hinsuranceCoveredAmt, HInsuranceShortFall, sfbNeededAmt, sfbCoveredAmt, SFBShortFall, ciInsuranceNeededAmt, ciInsuranceCoveredAmt, CIInsuranceShortFall, addInsuranceNeededAmt, addInsuranceCoveredAmt, ADDInsuranceShortFall){

      $(':input').each(function(){
            $(this).val($.trim($(this).val()))
        });

        
            $.ajax({                                    
                url: "/app/FNARequest/calculateFnaHealthProtectionNeed",
                method: 'POST',
                async: false,
                data: {'hincomeNeededAmt': hincomeNeededAmt , 'hincomeCoveredAmt': hincomeCoveredAmt , 'HIncomeShortFall' :HIncomeShortFall , 'hinsuranceNeededAmt': hinsuranceNeededAmt ,'hinsuranceCoveredAmt': hinsuranceCoveredAmt , 'HInsuranceShortFall': HInsuranceShortFall, 'sfbNeededAmt': sfbNeededAmt, 'sfbCoveredAmt': sfbCoveredAmt, 'SFBShortFall': SFBShortFall, 'ciInsuranceNeededAmt': ciInsuranceNeededAmt, 'ciInsuranceCoveredAmt': ciInsuranceCoveredAmt, 'CIInsuranceShortFall': CIInsuranceShortFall, 'addInsuranceNeededAmt': addInsuranceNeededAmt, 'addInsuranceCoveredAmt': addInsuranceCoveredAmt, 'ADDInsuranceShortFall':ADDInsuranceShortFall , 'object': '<%= @fnaRequest.object %>' },
                    headers: {
                        'Transition-Enabled': false
                    },
                    success: function(data) {
                       console.log(data);
                       var calData = $.parseJSON(data);                
