        $(':input').each(function(){
            $(this).val($.trim($(this).val()))
        });

         if($('#FNAShortFallForm').serialize() != (MyPageData.getData)) {
            $.ajax({                                    
                url: "/app/FNARequest/submitFNAShortFallSummary",
                method: 'POST',
                async: false,
