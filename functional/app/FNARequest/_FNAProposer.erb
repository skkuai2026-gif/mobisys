                        <ul id="smartSearchList" data-role= "listview" data-filter= "true" data-filter-reveal= "true" data-input= "#fna-Proposer-occupation" style= "display: block;max-height: 210px;overflow-y: scroll;width: 216%;overflow-x: hidden;margin-top: 5px;margin-right: 5%;">
                            <%# @occupationlist.each do |occupation| %>
                                <li class= "auto-filter-listitem" data-pointer= '<%#= getObjectMapping(@fnaProposer)%>[occupationCd]' data-cd= '<%#=occupation.cd %>' data-desc= '<%#=occupation.desc %>' onclick= "filterList(this);" onmousedown="changeColor(this)" style="margin-left: 0%;font-size:10px;background-color:#f7f7f7;">
                                    <span>
