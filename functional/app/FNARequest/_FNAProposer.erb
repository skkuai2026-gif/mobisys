            <div id="fna_exp_date" style="margin-left:2%;width:98%">
                <br>
                <img  valign="center" src="/public/images/FNA/notes.png">
                <span style="vertical-align:10px;">
                <%= renderLabel('noteDeleteFna','PICSAlert', '', @fnaProposer, 'style="display: inline-block;"') %>
                <%  if OfflineApplication.find(:first, :conditions =>{{:name =>'PROPERTY'} =>'FNACONSENTEXPIRYDAYS'})
                        if OfflineApplication.find(:first, :conditions =>{{:name =>'PROPERTY'} =>'FNACONSENTEXPIRYDAYS'}).value != nil 
                            requiredays = OfflineApplication.find(:first, :conditions =>{{:name =>'PROPERTY'} =>'FNACONSENTEXPIRYDAYS'}).value.to_i
                        else
                            requiredays = 0
                        end
                    else
                        requiredays = 0
                    end
                %>
                <%  if @fnaRequest.requestDt != nil 
                        creation_date = @fnaRequest.requestDt 
                    else
                        creation_date = Date.today
                    end
                    fnaCreatedDate = Date.parse creation_date
                %>
                <% d = (fnaCreatedDate + requiredays) %>
                <% d.strftime ('%d/%m/%Y') %>
                <%= consentExpiryDt = d.strftime ('%d/%m/%Y') %>
                <%= renderHiddenField('consentExpiryDt',consentExpiryDt,'',@fnaRequest) %>
                <%= renderLabel('noteDeleteFna','PICSAlert2', '', @fnaProposer, 'style="display: inline-block;"') %>
                <br>
                <br>
                </span>
            </div>
            
            <br>  
