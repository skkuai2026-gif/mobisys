                <span style="font-size:14px;color:#757575 !important;"><%= getLabelValue('FNA_BASIC_INFO') %></span>
                <br/><br/>
                <% @fnaProposer.questionSeq.each_with_index do | question, i | %>
                    <div class="clear-container" stye="text-color:#424242 !important;">
                        <% fnaQuestionResponse = @fnaProposer.getQuestionResponse(question.questionCd) %>
                        <%# puts "~~~~fnaQuestionResponse: #{fnaQuestionResponse.to_json}" %>
                        <%= renderObject(fnaQuestionResponse,@fnaProposer) %>
                        <%= renderHiddenField('fnaQuestionCd',fnaQuestionResponse.fnaQuestionCd,'fnaQuestionCd',fnaQuestionResponse) %>
                        <%= renderHiddenField('fnaRequestRefGuid',fnaQuestionResponse.fnaRequestRefGuid,'fnaRequestRefGuid',fnaQuestionResponse) %>
                        <%= renderHiddenField('fnaPartyRefGuid',fnaQuestionResponse.fnaPartyRefGuid,'fnaPartyRefGuid',fnaQuestionResponse) %>
                        <div class="add-fna-heading">
                            <%#= MobiSys::CommonUtil.replacePlaceHolders( getLabelValue(question.questionCd), question.getChannelMapping ) %>
                            <%= getLabelValue(question.questionCd) %>
                        </div>

                        <div class="<%= "#{question.questionTypeCd} #{question.questionCd}" %>">
                            <% if question.questionTypeCd=='multiple-select' %>
                                <%= renderHiddenField(question.questionCd.to_s,fnaQuestionResponse.fnaQuestionLookupDataCd.to_s, nil, nil) %>
                                <% resp = fnaQuestionResponse.fnaQuestionLookupDataCd.to_s.split(",") %>
                                <%= getQuestionnaireCheckbox(question.questionCd.to_s, question.questionCd.to_s, resp, fnaQuestionResponse, nil, nil) %>
                            <% elsif question.questionTypeCd=='single-select' %>
                                <% resp = fnaQuestionResponse.fnaQuestionLookupDataCd %>
                                <%= renderHiddenField(question.questionCd.to_s,resp, nil, nil) %>
                                <%= getQuestionRadioButton(question.questionCd.to_s, question.questionCd.to_s,resp, fnaQuestionResponse, nil, nil, true)  %>
                            <% elsif question.questionTypeCd=='sign' %>
                                <%# resp = fnaQuestionResponse.fnaQuestionLookupDataCd %>
                                <%#= renderHiddenField(question.questionCd.to_s,resp, nil, nil) %>
                                <%#= getQuestionRadioButton(question.questionCd.to_s, question.questionCd.to_s,resp, fnaQuestionResponse, nil, nil, true)  %>
                                <%= renderTextInlineFieldForFNA('nonDisclosureofAssets', @fnaRequest, returnAppHeightWeight('screen_width', 0.95), returnAppHeightWeight('screen_height', 0.13) ,'true')%>
                                <%= renderHiddenField('witnessSignature', @fnaRequest.witnessSignature, 'witnessSignature', @fnaRequest) %>
                            <%# else %>
                                <%#= renderAmountField('fnaQuestionLookupDataCd',fnaQuestionResponse.fnaQuestionLookupDataCd,'fnaQuestionLookupDataCd',fnaQuestionResponse,nil)  %>
                            <% end %>
                        </div>
                    </div>
                <% end %>
            </div>
