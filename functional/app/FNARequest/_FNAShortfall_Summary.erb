                       <%= renderLabel('TOTALCAPITALNEED', 'TOTALCAPITALNEED', 'mandatory material-label', nil) %>
                        
                        
                        </div>
                    </div>
                    <div class="operation-label"> - </div>
                    <div class="third with-spacer">
