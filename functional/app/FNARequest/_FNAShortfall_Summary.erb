                         <%= renderLabel('SHORTFALL_CURR_LIFEPROTECTION', 'SHORTFALL_CURR_LIFEPROTECTION', 'mandatory material-label', nil) %>
                          
                        </div>
                    </div>
                </div>
            </div>
        <% end %>
        <% if @fnaLifeProtectionNeed.CalculatorTypeCd.to_s == 'CALCTYPESIMPLE' || @fnaLifeProtectionNeed.CalculatorTypeCd.to_s == "" %>
        <div class="card">
