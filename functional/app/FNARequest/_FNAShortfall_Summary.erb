            <div class="group">
              <%= renderNumericField('TOTAL_CAPITAL_NEED_AFTER_DEATH', thosandSeperator(@montlyExpenseAmt.to_s),'TOTAL_CAPITAL_NEED_AFTER_DEATH', nil, ' maxlength="10" pattern="/([^\s])" onkeypress="return numbersonly(event)" readonly="true" style="background-color: #c8c8c8 !important;margin-top:7px !important;" class="material-input "') %>
              <%= renderLabel('TOTAL_CAPITAL_NEED_AFTER_DEATH', 'TOTAL_CAPITAL_NEED_AFTER_DEATH', 'mandatory material-label', nil) %>
            </div>
          </div>
          <div class="third">
            <div class="group">
              
            </div>
          </div>
          <div class="third">
            <div class="group">
              <%= renderNumericField('SHORTFALL_CURR_LIFEPROTECTION', thosandSeperator(@shortfallAmt.to_s) ,'SHORTFALL_CURR_LIFEPROTECTION', nil, ' maxlength="10" pattern="/([^\s])" readonly="true" style="background-color: #c8c8c8 !important;margin-top:7px !important;" class="material-input " onkeypress="return numbersonly(event)" ') %>
              <%= renderLabel('SHORTFALL_CURR_LIFEPROTECTION', 'SHORTFALL_CURR_LIFEPROTECTION', 'mandatory material-label', nil) %>
            </div>
          </div>
        </div>
     </div>
    <% end %>  
    <% else %>
      <div class="card">
        <div class="note"><%= getLabelValue('ALL_VALUES_IN_HKD') %></div>
