            font-size: 14px !important;
            max-width: 200px;
            margin: 0;
            text-shadow: none !important;
            font-weight: 700;
            text-align: center;
            line-height: 1.3;
            /*padding: .8em 1.5em !important;*/
            width: 150px;
        }
        .button_UI_create{
            background-color:#efbc33!important;
            border-radius: 7px;
            border-style: none;
            color: #003946 !important;
            display: inline-block;
            font-size: 14px !important;
            max-width: 200px;
            margin: 0;
            text-shadow: none !important;
            font-weight: 700;
            text-align: center;
            /*line-height: 1.3;*/
            /*padding: .8em 1.5em !important;*/
            width: 150px;
        }
        .ui-state-disabled {
            border-bottom: none !important;
        }
        .ui-simpledialog-container{
            z-index: 500;
            position: relative !important;
            top: -800px !important;
            left: 137px;
        }


    </style>

<%= render(:partial => 'FNAProduct_SelectionJS')%>
</form>


 <div class="" data-role="dualfieldcontain" align="">
        <div class="">
            <div class="group" style="font-size: 14px;">
                <%= getLabelValue('INSTRUCTION_TEXT_PRODUCT_SELECTION') %>
            </div>
        </div>
    </div>


