            max-width: 200px;
            margin: 0;
            text-shadow: none !important;
            font-weight: 700;
            text-align: center;
            line-height: 1.3;
            /*padding: .8em 1.5em !important;*/
            /*width: 100px;*/
        }
    </style>

<%= render(:partial => 'FNAHealth_Protection_NeedJS')%>
</form>
</div>

