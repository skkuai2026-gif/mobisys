<div data-role="page">

  <div data-role="header" data-position="inline">
    <%= link_to "Back", :action => :show, :id => @level1.object %>
    <h1>Edit <%= @level1.levelCd%></h1>
    <%= link_to "Delete", :action => :delete, :id => @level1.object %>
  </div>

  <div data-role="content">
    <form method="POST" action="<%= url_for :action => :update %>">
      <input type="hidden" name="id" value="<%= @level1.object %>"/>
      <table>
          
          <tr>
              <td class="itemLabel">Levelcd: </td>
              <td class="itemValue"><input type="text" name="level1[levelCd]" value="<%= @level1.levelCd %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Name: </td>
              <td class="itemValue"><input type="text" name="level1[name]" value="<%= @level1.name %>"/></td>
          </tr>
          
          <tr>
              <td class="itemLabel">Icon: </td>
              <td class="itemValue"><input type="text" name="level1[icon]" value="<%= @level1.icon %>"/></td>
          </tr>
          
      </table>
      <input type="submit" value="Update"/>
    </form>
  </div>

</div>
