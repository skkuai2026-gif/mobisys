<div data-role="page" data-add-back-btn="false">

  <div data-role="header" data-position="inline">
    <h1><%= @level1.levelCd %></h1>
    <a href="<%= url_for :action => :index %>" class="ui-btn-left" data-icon="arrow-l" data-direction="reverse">
      Back
    </a>
    <a href="<%= url_for :action => :edit, :id => @level1.object %>" class="ui-btn-right" data-icon="star">
      Edit
    </a>
  </div>

  <div data-role="content">
    <ul data-role="listview">
      
          <li>
            <div class="itemLabel">LevelCd</div>
            <div class="itemValue"><%= @level1.levelCd %></div>
          </li>
      
          <li>
            <div class="itemLabel">Name</div>
            <div class="itemValue"><%= @level1.name %></div>
          </li>
      
          <li>
            <div class="itemLabel">Icon</div>
            <div class="itemValue"><%= @level1.icon %></div>
          </li>
          
          <li>
            <div class="itemLabel">Text</div>
            <div class="itemValue"><%= @level1.text %></div>
          </li>
      
          <li>
            <div class="itemLabel">Layout</div>
            <div class="itemValue"><%= @level1.layout %></div>
          </li>
    
          <li>
            <div class="itemLabel">Sort order</div>
            <div class="itemValue"><%= @level1.sortOrder %></div>
          </li>
      
          <li>
            <div class="itemLabel">Collateral view</div>
            <div class="itemValue"><%= @level1.collateralView %></div>
          </li>

    </ul>
  </div>

</div>
