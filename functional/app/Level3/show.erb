<div data-role="page" data-add-back-btn="false">

  <div data-role="header" data-position="inline">
    <h1><%= @level3.levelCd %></h1>
    <a href="<%= url_for :action => :index %>" class="ui-btn-left" data-icon="arrow-l" data-direction="reverse">
      Back
    </a>
    <a href="<%= url_for :action => :edit, :id => @level3.object %>" class="ui-btn-right" data-icon="star">
      Edit
    </a>
  </div>

  <div data-role="content">
    <ul data-role="listview">
      
          <li>
            <div class="itemLabel">LevelCd</div>
            <div class="itemValue"><%= @level3.levelCd %></div>
          </li>
      
          <li>
            <div class="itemLabel">Name</div>
            <div class="itemValue"><%= @level3.name %></div>
          </li>
      
          <li>
            <div class="itemLabel">Icon</div>
            <div class="itemValue"><%= @level3.icon %></div>
          </li>
      
          <li>
            <div class="itemLabel">TextH</div>
            <div class="itemValue"><%= @level3.text_h %></div>
          </li>
      
          <li>
            <div class="itemLabel">TextF</div>
            <div class="itemValue"><%= @level3.text_f %></div>
          </li>
      
    </ul>
  </div>

</div>
