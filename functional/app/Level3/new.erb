<div data-role="page">

  <div data-role="header" data-position="inline">
    <h1>New <%= @level3.title %></h1>
    <a href="<%= url_for :action => :index %>" class="ui-btn-left" data-icon="back" data-direction="reverse">
      Cancel
    </a>
  </div>

  <div data-role="content">
    <form method="POST" action="<%= url_for :action => :create %>">
      <input type="hidden" name="id" value="<%= @level3.object %>"/>

      
          <div data-role="fieldcontain">
            <label for="level3[levelCd]" class="fieldLabel">Levelcd</label>
            <input type="text" id="level3[levelCd]" name="level3[levelCd]" <%= placeholder("Levelcd") %> />
          </div>
      
          <div data-role="fieldcontain">
            <label for="level3[name]" class="fieldLabel">Name</label>
            <input type="text" id="level3[name]" name="level3[name]" <%= placeholder("Name") %> />
          </div>
      
          <div data-role="fieldcontain">
            <label for="level3[icon]" class="fieldLabel">Icon</label>
            <input type="text" id="level3[icon]" name="level3[icon]" <%= placeholder("Icon") %> />
          </div>
      
          <div data-role="fieldcontain">
            <label for="level3[text_h]" class="fieldLabel">Text h</label>
            <input type="text" id="level3[text_h]" name="level3[text_h]" <%= placeholder("Text h") %> />
          </div>
      
          <div data-role="fieldcontain">
            <label for="level3[text_f]" class="fieldLabel">Text f</label>
            <input type="text" id="level3[text_f]" name="level3[text_f]" <%= placeholder("Text f") %> />
          </div>
          
              <div data-role="fieldcontain">
                  <label for="level3[level2_levelCd]" class="fieldLabel">Level2 Reference</label>
                  <select name="level3[level2_levelCd]">
                  <% 
                    @level2s.each do |level2|
                      %>
                        <option value="<%= level2.levelCd%>"
                          <%= "selected" if level2.levelCd == @level3.level2_levelCd%>
                        >
                            <%=level2.header%>
                        </option>
                      <%
                    end
                  %>
                  </select>
              </div>


      <input type="submit" value="Create"/>
    </form>
  </div>

</div>
